+import type { ExactRef } from "../../kernel/core/index.js";
+import type { SandboxGrants } from "../../host/core/index.js";
+import type { EffectKind, PolicyDecision, PolicySubject } from "./rules.js";
+import type { EffectOrigin, HeldPending } from "./pending-state.js";
+
+/**
+ * 有界 Effect 快照。存储层只认这一份已经校验的形状，不接受任意对象。
+ */
+export type StoredEffectState =
+  | "prepared"
+  | "awaiting-approval"
+  | "authorized"
+  | "dispatching"
+  | "completed"
+  | "denied"
+  | "cancelled"
+  | "failed"
+  | "reconcile-required";
+
+export interface StoredEffectProposal {
+  readonly kind: EffectKind;
+  readonly subject: PolicySubject;
+  readonly origin: EffectOrigin | undefined;
+  readonly escalation: boolean | undefined;
+  readonly grants: SandboxGrants | undefined;
+  readonly summary: string;
+  readonly inputFingerprint: string;
+  readonly reviewRef: ExactRef<"resource"> | undefined;
+  readonly approvalTtlMs: number | undefined;
+}
+
+export interface StoredEffectRecord {
+  readonly id: string;
+  readonly state: StoredEffectState;
+  readonly proposal: StoredEffectProposal;
+  readonly decision: PolicyDecision;
+  readonly pendingId: string | undefined;
+  readonly dispatches: number;
+  readonly preparedAtMs: number;
+}
+
+export interface StoredPendingRecord {
+  readonly id: string;
+  readonly held: HeldPending;
+}
+
+export interface PolicyLoad {
+  readonly effects: readonly StoredEffectRecord[];
+  readonly pendings: readonly StoredPendingRecord[];
+  readonly effectIssue: Error | undefined;
+  readonly pendingIssue: Error | undefined;
+}
+
+export interface StoredPolicy {
+  commit(input: {
+    readonly effects?: readonly StoredEffectRecord[];
+    readonly pendings?: readonly StoredPendingRecord[];
+    /** Original synchronous preparation fence, immediately before dispatching the Host commit. Never persisted. */
+    readonly beforeCommit?: () => void;
+  }): Promise<void>;
+  loadAll(): Promise<PolicyLoad>;
+  /**
+   * 按 id 读一笔 Pending。缺失或墓碑为 undefined。
+   * 损坏报 STORAGE_RECONCILE_REQUIRED，源不可用报 STORAGE_UNAVAILABLE。
+   */
+  readPending(id: string): Promise<HeldPending | undefined>;
+}
