-      return `upload ${action.from.join("/")}`;
-    case "download":
-      return `download to ${action.to.join("/")}`;
-    case "scroll":
-      return `scroll by (${String(action.dx)}, ${String(action.dy)}) points at ${String(action.x)},${String(action.y)}`;
-    case "drag":
