+import type { EffectChain } from "../../effect-policy/core/index.js";
+import { createPrologueError, isPrologueError, type ExactRef } from "../../kernel/core/index.js";
+import type { Observation, UiAction, UiExpectedTarget, UiReviewTarget, UiSurface, UiTarget } from "./surface.js";
+import { assertSurfaceAuthority } from "./surface.js";
+
+export interface Held {
+  readonly ref: ExactRef<"ui-target">;
+  readonly surface: UiSurface;
+  readonly owner: ExactRef<"session"> | undefined;
+  open: boolean;
+  /** Increment before dispatching an app switch, even if its eventual outcome is unknown. */
+  epoch: number;
+  readonly preparing: Set<Promise<unknown>>;
+  readonly effects: Map<string, { readonly ref: ExactRef<"effect">; readonly plan: Planned; cancelling?: Promise<void>; cancelFailure?: { readonly error: unknown } }>;
+  readonly failedPreparations: Map<string, unknown>;
+  closing?: Promise<void>;
+  detaching?: Promise<void>;
+}
+
+export interface Seen {
+  readonly observation: Observation;
+  readonly target: Held;
+  /** Compare exact driver values; redaction would merge different pages. Never publish these strings. */
+  readonly identity: string;
+  readonly scope: string;
+  readonly epoch: number;
+}
+
+export interface Planned {
+  readonly seen: Seen;
+  readonly action: UiAction;
+  /** Approval waiting extends freshness, but never waives identity or scope checks. */
+  waitedMs: number;
+  readonly assertNotCancelled: () => void;
+}
+
+/** A predicate belongs to one call. Invalid/async answers fail closed, and an observed cancellation stays final. */
+export function surfaceCancellation(cancelled: (() => boolean) | undefined): () => void {
+  let stopped = false;
+  return () => {
+    if (!stopped && cancelled !== undefined) {
+      let value: unknown;
+      try { assertSurfaceAuthority(() => { value = cancelled(); return value; }); }
+      catch (error) { stopped = true; throw error; }
+      stopped = value !== false;
+    }
+    if (stopped) throw createPrologueError("EFFECT_NOT_AUTHORIZED", "This interface operation was cancelled.");
+  };
+}
+
+const sameRef = (one: ExactRef<"effect">, two: ExactRef<"effect">): boolean =>
+  one.kind === two.kind && one.id === two.id && one.revision === two.revision;
+
+/** The UI owner's existing indexes and final cleanup; Effect/Pending facts stay in the original chain. */
+export class SurfaceState {
+  readonly targets = new Map<string, Held>();
+  readonly retiring = new Map<string, Held>();
+  readonly observations = new Map<string, Seen>();
+  readonly planned = new Map<string, Planned>();
+  ending = false;
+
+  constructor(private readonly chain: EffectChain) {}
+
+  targetOf = (ref: ExactRef<"ui-target">): Held => {
+    const target = this.targets.get(ref.id);
+    if (target === undefined) throw createPrologueError("UI_TARGET_UNAVAILABLE", "That interface target is not attached.");
+    return target;
+  };
+
+  view = (target: Held): UiTarget => ({ ref: target.ref, kind: target.surface.kind, open: target.open, ...(target.owner === undefined ? {} : { owner: target.owner }) });
+
+  assertCurrent = (target: Held, epoch: number): void => {
+    if (this.ending || !target.open) throw createPrologueError("UI_TARGET_UNAVAILABLE", "That interface target is closed.");
+    if (target.epoch !== epoch) throw createPrologueError("UI_OBSERVATION_STALE", "This surface switched applications; observe again.");
+    assertSurfaceAuthority(() => target.surface.assertCurrent?.());
+  };
+
+  expected = (target: Held, epoch: number, identity: string, scope: string, check: () => void): UiExpectedTarget => Object.freeze({
+    identity, scope,
+    assertCurrent: () => { assertSurfaceAuthority(check); this.assertCurrent(target, epoch); },
+  });
+
+  planOf = (ref: ExactRef<"effect">): Planned | undefined => {
+    const plan = this.planned.get(ref.id), original = plan?.seen.target.effects.get(ref.id);
+    return plan && original && sameRef(ref, original.ref) ? plan : undefined;
+  };
+
+  reviewTarget = (ref: ExactRef<"effect">): UiReviewTarget | undefined => {
+    const fixed = { ...ref }, plan = this.planOf(fixed), original = plan?.seen.target.effects.get(fixed.id);
+    if (!plan || !original) return undefined;
+    const expected = this.expected(plan.seen.target, plan.seen.epoch, plan.seen.identity, plan.seen.scope, () => {
+      plan.assertNotCancelled();
+      if (this.planned.get(fixed.id) !== plan || plan.seen.target.effects.get(fixed.id) !== original) {
+        throw createPrologueError("UI_OBSERVATION_STALE", "The original interface plan is no longer available.");
+      }
+    });
+    try {
+      expected.assertCurrent();
+      const effect = this.chain.get(fixed);
+      if (!effect || !sameRef(effect.ref, fixed) || effect.state !== "awaiting-approval") return undefined;
+      return Object.freeze({ targetRef: Object.freeze({ ...plan.seen.target.ref }), expected });
+    } catch { return undefined; }
+  };
+
+  /** Composition holds this exact target/epoch across its own clock and resource waits. */
+  guard = (ref: ExactRef<"ui-target"> | ExactRef<"observation">): (() => void) => {
+    const seen = ref.kind === "observation" ? this.observations.get(ref.id) : undefined;
+    const target = ref.kind === "ui-target" ? this.targetOf(ref) : seen?.target;
+    if (target === undefined) throw createPrologueError("UI_OBSERVATION_STALE", "There is no such observation.");
+    const epoch = seen?.epoch ?? target.epoch;
+    const check = () => this.assertCurrent(target, epoch);
+    check();
+    return check;
+  };
+
+  closeDriver = (target: Held): Promise<void> => {
+    target.open = false;
+    if (target.closing === undefined) {
+      const closing = Promise.resolve().then(() => target.surface.close());
+      target.closing = closing;
+      void closing.catch(() => { if (!this.ending) delete target.closing; });
+    }
+    return target.closing;
+  };
+
+  cancelOriginal = (target: Held, id: string): Promise<void> => {
+    const entry = target.effects.get(id);
+    if (entry === undefined) return Promise.resolve();
+    if (entry.cancelling !== undefined) return entry.cancelling;
+    delete entry.cancelFailure;
+    const work = this.chain.cancel(entry.ref).then(
+      () => { target.effects.delete(id); },
+      (error: unknown) => {
+        // Already-dispatched results belong to the original chain; cancellation cannot erase them.
+        if (isPrologueError(error) && error.code === "EFFECT_ALREADY_DISPATCHED") target.effects.delete(id);
+        else { entry.cancelFailure = { error }; throw error; }
+      },
+    );
+    entry.cancelling = work;
+    void work.then(() => { delete entry.cancelling; }, () => { delete entry.cancelling; });
+    return work;
+  };
+
+  /** Approval tails are no longer in preparing. Accept cleanup only before sealing, or join its already accepted attempt. */
+  cancelAfterPrepare = (target: Held, id: string): Promise<void> => {
+    const entry = target.effects.get(id);
+    if (!entry || this.ending && entry.cancelling === undefined) return Promise.resolve();
+    return this.cancelOriginal(target, id);
+  };
+
+  detach = (target: Held): Promise<void> => {
+    if (target.detaching !== undefined) return target.detaching;
+    target.open = false;
+    this.targets.delete(target.ref.id);
+    this.retiring.set(target.ref.id, target);
+    for (const [id, seen] of this.observations) if (seen.target === target) this.observations.delete(id);
+    for (const [id, plan] of this.planned) if (plan.seen.target === target) this.planned.delete(id);
+    const started = new Set(target.effects.keys());
+    const cleanup = async (): Promise<void> => {
+      const first = await Promise.allSettled([
+        this.closeDriver(target),
+        ...[...started].map((id) => this.cancelOriginal(target, id)),
+        // The prepare caller receives its refusal. Cleanup reports only its
+        // original unknown commit or a failed cancellation, recorded below.
+        ...[...target.preparing].map((work) => work.catch(() => undefined)),
+      ]);
+      // A prepare already accepted by an async Host settles in its original lane.
+      const late = await Promise.allSettled(
+        [...target.effects.entries()].filter(([id, entry]) => !started.has(id) && entry.cancelFailure === undefined).map(([id]) => this.cancelOriginal(target, id)),
+      );
+      for (const result of [...first, ...late]) if (result.status === "rejected") throw result.reason;
+      for (const entry of target.effects.values()) if (entry.cancelFailure !== undefined) throw entry.cancelFailure.error;
+      // Unknown writes retain their original fingerprint/error until Runtime recovery.
+      // An empty retry never proves that an accepted write did not happen.
+      for (const error of target.failedPreparations.values()) throw error;
+      this.retiring.delete(target.ref.id);
+    };
+    const work = cleanup();
+    target.detaching = work;
+    void work.catch(() => { if (!this.ending) delete target.detaching; });
+    return work;
+  };
+
+  /** Seal before awaiting so no new cleanup can enter after the final storage drain. */
+  settleDetached = async (): Promise<void> => {
+    this.ending = true;
+    // Preserve shutdown's existing tolerance for an unavailable driver. Already
+    // accepted detach failures still reject, because they can involve stored facts.
+    const closes = [...this.targets.values()].map((target) => this.closeDriver(target).catch(() => undefined));
+    const settled = await Promise.allSettled([
+      ...closes,
+      ...[...this.targets.values(), ...this.retiring.values()].flatMap(target => [...target.effects.values()].flatMap(entry => entry.cancelling ? [entry.cancelling] : [])),
+      ...[...this.retiring.values()].map(this.detach),
+      ...[...this.targets.values()].flatMap((target) => [...target.preparing].map((work) => work.catch(() => undefined))),
+    ]);
+    for (const result of settled) if (result.status === "rejected") throw result.reason;
+    for (const target of this.targets.values()) {
+      for (const error of target.failedPreparations.values()) throw error;
+      for (const entry of target.effects.values()) if (entry.cancelFailure !== undefined) throw entry.cancelFailure.error;
+    }
+  };
+}
