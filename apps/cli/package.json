{
  "name": "@molis-ai/molis-work-app-cli",
  "version": "0.0.0",
  "private": true,
  "description": "Thin CLI protocol, argument, and presentation adapter.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@molis-ai/molis-work-contracts": "workspace:*",
    "@molis-ai/molis-work-plugin-goals": "workspace:*"
  },
  "molis-work": {
    "path": "apps/cli",
    "kind": "app",
    "maturity": "partial",
    "contract": "@molis-ai/molis-work-contracts/platform/app-host",
    "migrationGoals": [
      "goal-reorg-f2",
      "goal-reorg-dv1",
      "goal-reorg-gw4",
      "goal-reorg-ex4"
    ],
    "ssot": "docs/SSOT-MATRIX.md",
    "capabilities": [
    ]
  }
}
