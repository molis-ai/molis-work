      "html": "<button class=\"ds-btn-primary\">开始整理</button>",
      "css": ".ds-btn-primary{height:40px;padding:0 16px;display:inline-flex;align-items:center;justify-content:center;gap:8px;border-radius:8px;border:0;cursor:pointer;font-size:14px;font-family:Inter,\"Noto Sans SC\",\"PingFang SC\",sans-serif;transition:background .15s,transform .15s;background:var(--action);color:var(--on-action);}.ds-btn-primary:hover:not(:disabled){filter:brightness(1.15);}.ds-btn-primary:focus-visible{outline:2px solid var(--accent);outline-offset:3px;}.ds-btn-primary:active:not(:disabled){transform:translateY(1px)}.ds-btn-primary:disabled{opacity:.4;cursor:default}@media(max-width:520px){.ds-btn-primary{height:44px;padding:0 13px;font-size:13px}}@media(prefers-reduced-motion:reduce){.ds-btn-primary{transition:none}}"
