{
  "name": "@molis-ai/molis-work-plugin-todo",
  "version": "0.0.0",
  "private": true,
  "description": "First-party Todo: the person's formal list of things to move forward, personal and per project.",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./registration": {
      "types": "./dist/registration.d.ts",
      "import": "./dist/registration.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.browser.json && esbuild src/browser/factory.ts --bundle --format=iife --platform=browser --minify --charset=utf8 '--banner:js=(host) => {' --footer:js=} --outfile=dist/todo-client.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.browser.json"
  },
  "dependencies": {
    "@molis-ai/molis-work-contracts": "workspace:*",
    "@molis-ai/molis-work-design-system": "workspace:*",
    "@molis-ai/molis-work-plugin-sdk": "workspace:*",
    "@molis-ai/molis-work-storage": "workspace:*"
  },
  "molis-work": {
    "path": "plugins/native/todo",
    "kind": "native-plugin",
    "maturity": "partial",
    "contract": "@molis-ai/molis-work-contracts/platform/plugin",
    "summary": "Protected first-party Todo: the person's formal list of things to move forward.",
    "notResponsibleFor": "AI organizing and follow-through, Goal facts, reminder delivery, or material bodies.",
    "legacySources": [],
    "migrationGoals": [
      "goal-reorg-f2"
    ],
    "ssot": "docs/SSOT-MATRIX.md",
    "capabilities": [
      "todo.ui-contribution.v1",
      "todo.http-routes.v1"
    ],
    "extraWorkspaceDependencies": [
      "@molis-ai/molis-work-plugin-sdk",
      "@molis-ai/molis-work-design-system",
      "@molis-ai/molis-work-storage"
    ],
    "extraDependencies": {},
    "registration": "./registration"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
