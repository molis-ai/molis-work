diff --git a/packages/sdk/src/composition/core/surface-tool-resources.ts b/packages/sdk/src/composition/core/surface-tool-resources.ts
new file mode 100644
index 0000000000000000000000000000000000000000..1534e18cac3131cadf697a77bbf78d1b41303ead
--- /dev/null
+++ b/packages/sdk/src/composition/core/surface-tool-resources.ts
@@ -0,0 +1,45 @@
+import { createPrologueError, type ExactRef } from "../../kernel/core/index.js";
+import type { ResourceStore } from "../../resource/core/index.js";
+
+/** Literal tool input and bounded observation text use the existing resource store. */
+export function surfaceToolResources(resources: ResourceStore) {
+  return {
+    /*
+     * 模型递的是字面量（它手上没有资源引用），落成资源是这一层的活。
+     * 这样那一整段不会散在意图、回执和审批摘要里。
+     */
+    stageText: async (body: string) => {
+      const bytes = new TextEncoder().encode(body);
+      const staged = resources.stage({
+        mediaKind: "text",
+        byteLength: bytes.byteLength,
+        label: "text to type",
+      });
+      staged.write(bytes);
+      return staged.publish().ref;
+    },
+    readText: async (ref: ExactRef<"resource">, maxChars: number) => {
+      const handle = resources.inspect(ref);
+      if (handle === undefined) {
+        throw createPrologueError("UI_TARGET_UNAVAILABLE", "That observation's body is no longer readable.");
+      }
+      // Enough bytes for maxChars of UTF-8, never the whole of an oversized body.
+      const want = Math.min(handle.byteLength, maxChars * 4);
+      const parts: Uint8Array[] = [];
+      let offset = 0;
+      while (offset < want) {
+        const chunk = await resources.readChunk(ref, offset, Math.min(64 * 1024, want - offset));
+        if (chunk.bytes.byteLength === 0) break;
+        parts.push(chunk.bytes);
+        offset += chunk.bytes.byteLength;
+        if (chunk.done) break;
+      }
+      const joined = new Uint8Array(offset);
+      let at = 0;
+      for (const part of parts) { joined.set(part, at); at += part.byteLength; }
+      const decoded = new TextDecoder("utf-8", { fatal: false }).decode(joined);
+      const text = decoded.length > maxChars ? decoded.slice(0, maxChars) : decoded;
+      return { text, truncated: decoded.length > maxChars || handle.byteLength > want };
+    },
+  };
+}
