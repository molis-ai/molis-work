-        : `click node ${action.node} (${String(action.clicks)}×${action.button}); the point is read from the tree at injection`;
-    case "key":
-      return `press ${action.keys.join("+")}`;
-    case "text":
-      // **不放正文。** 要打的字在资源里，摘要里只说有这么一份。
-      return "type text from a resource";
-    case "navigate":
-      return `navigate to ${action.url}`;
-    case "wait":
-      return `wait ${String(action.ms)}ms`;
-    case "upload":
-      /*
-       * **路径写全。** 批准这一笔的人要看见送出去的是哪一个文件——
-       * 「上传一个文件」这句话里没有他要判断的那件事。
