new file mode 100644
index 00000000..08fb463c
--- /dev/null
+++ b/crates/prologue-host-tauri/tests/workspace_search.rs
@@ -0,0 +1,28 @@
+//! 搜索路径可以是单个文件；不存在的路径如实报错，不答成「没找到」。
+
+use std::collections::HashMap;
+use std::fs;
+use std::sync::Mutex;
+
+use prologue_host_tauri::testing::{authorize, search};
+
+#[test]
+fn a_file_path_searches_that_file_and_a_missing_path_is_an_error() {
+    let dir = std::env::temp_dir().join(format!("prologue-rs-search-{}", uuid::Uuid::new_v4()));
+    fs::create_dir_all(dir.join("src")).expect("temp dir");
+    fs::write(dir.join("src/streaks.ts"), "export function currentStreak() {\n  return 0;\n}\n").expect("file");
+    fs::write(dir.join("src/other.ts"), "return 0;\n").expect("file");
+    let roots = Mutex::new(HashMap::new());
+    let grant = authorize(dir.to_string_lossy().into_owned(), &roots).expect("authorize");
+
+    let one = search(grant.root_ref.clone(), "return 0".into(), "src/streaks.ts".into(), &roots).expect("search a file");
+    assert_eq!(one.matches.len(), 1);
+    assert_eq!(one.matches[0].path, "src/streaks.ts");
+    assert_eq!(one.matches[0].line, 2);
+
+    let all = search(grant.root_ref.clone(), "return 0".into(), "src".into(), &roots).expect("search a directory");
+    assert_eq!(all.matches.len(), 2);
+
+    assert!(search(grant.root_ref, "return 0".into(), "src/gone.ts".into(), &roots).is_err());
+    fs::remove_dir_all(&dir).ok();
+}
