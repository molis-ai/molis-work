@@ -0,0 +1,169 @@
+import { mkdtempSync, rmSync } from "node:fs";
+import { createServer, type ServerResponse } from "node:http";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { expect, it } from "vitest";
+import { APP_MODE_SYSTEM_TOOLS, createRuntime, type ModelEvent, type Run, type ScenarioPack, type ToolRunner } from "../src/index.js";
+import { createNodeHost } from "../src/node.js";
+
+function watch(run: Run) {
+  const events: ModelEvent[] = [];
+  run.subscribe(event => { events.push(event); });
+  const until = (type: ModelEvent["type"] | "terminal") => new Promise<ModelEvent>((resolve, reject) => {
+    const timer = setInterval(() => {
+      const found = events.find(event => type === "terminal" ? ["completed", "failed", "cancelled"].includes(event.type) : event.type === type);
+      if (found) { clearInterval(timer); clearTimeout(limit); resolve(found); }
+    }, 5);
+    const limit = setTimeout(() => { clearInterval(timer); reject(new Error(`no ${type}: ${events.map(e => e.type + (e.type === "failed" ? JSON.stringify((e as any).error) : e.type === "tool-result" ? JSON.stringify((e as any).text ?? (e as any).error ?? e) : "")).join(",")}`)); }, 4000);
+  });
+  return { events, until };
+}
+function say(response: ServerResponse, text = "done") {
+  response.writeHead(200, { "content-type": "text/event-stream" });
+  response.end(`data: ${JSON.stringify({ model: "m", choices: [{ delta: { content: text } }], usage: { prompt_tokens: 7, completion_tokens: 3 } })}\n\ndata: [DONE]\n\n`);
+}
+function call(response: ServerResponse, name: string, args: object) {
+  response.writeHead(200, { "content-type": "text/event-stream" });
+  response.end(`data: ${JSON.stringify({ usage: { prompt_tokens: 7, completion_tokens: 3 }, choices: [{ delta: { tool_calls: [{ index: 0, id: "c1", type: "function", function: { name, arguments: JSON.stringify(args) } }] } }] })}\n\ndata: [DONE]\n\n`);
+}
+
+/** A pack like an App's business actions: one read and one write, each with its own executor. */
+function businessPack(executors: { lookup: ToolRunner; save: ToolRunner }): { pack: ScenarioPack; executors: Record<string, ToolRunner> } {
+  const tool = (name: string, effectKind: "safe-read" | "mutate-external") => ({ executor: name, registration: { name, version: "1", description: `${name} a business record`,
+    parameters: { type: "object", properties: { id: { type: "string" } }, required: ["id"], additionalProperties: false }, effectKind, gate: "broker" as const, timeoutMs: 5000, idempotency: "none" as const } });
+  return { executors, pack: { id: "business-actions", version: "1.0.0", source: { kind: "app-embedded" }, needs: { hostCapabilities: [], executors: ["lookup", "save"] },
+    permissions: { tools: ["lookup", "save"], network: [], paths: [] }, memory: { scope: "session", write: "deny" },
+    roster: [{ role: "assistant", skills: [], writes: true }], planning: { plannedBy: "assistant", planFirst: false }, config: {},
+    tools: [tool("lookup", "safe-read"), tool("save", "mutate-external")] } };
+}
+
+async function fixture(handler: (body: any, response: ServerResponse, turn: number) => void) {
+  const home = mkdtempSync(join(tmpdir(), "prologue-app-mode-"));
+  const workspaceCalls: string[] = [], requests: any[] = [];
+  let turn = 0;
+  const server = createServer(async (request, response) => {
+    let raw = ""; for await (const chunk of request) raw += chunk;
+    const body = JSON.parse(raw); requests.push(body); handler(body, response, turn++);
+  });
+  await new Promise<void>(resolve => server.listen(0, "127.0.0.1", resolve));
+  const address = server.address(); if (!address || typeof address === "string") throw new Error("missing endpoint");
+  const actual = createNodeHost({ storageRoot: join(home, "store") });
+  const methods = new Set(["authorizeRoot", "listDirectory", "searchFiles", "readFile", "readBinary", "readBytes", "writeFile", "applyPatch", "prepareCommand", "runCommand"]);
+  const host = new Proxy(actual, { get(target, key, receiver) { const value = Reflect.get(target, key, receiver); return typeof value !== "function" ? value : (...args: unknown[]) => { if (methods.has(String(key))) workspaceCalls.push(String(key)); return value.apply(target, args); }; } });
+  const runtime = await createRuntime({ app: { appId: "prologue.app-mode", appVersion: "1.0.0" }, host, preset: "local-agent",
+    network: { model: true, loopback: true }, posture: { sandbox: "workspace-write", approval: "untrusted" }, permissionMode: { mode: "ask-always" } });
+  const credentialRef = (await runtime.credentials.write({ label: "test", secret: { plaintext: new TextEncoder().encode("synthetic") } })).ref;
+  const start = (text = "task") => ({ protocol: "openai-compatible", endpoint: `http://127.0.0.1:${address.port}/chat`, credentialRef, model: "m", messages: [{ role: "user" as const, text }] });
+  return { runtime, workspaceCalls, requests, start, async close() { await runtime.shutdown(); server.closeAllConnections(); await new Promise<void>(resolve => server.close(() => resolve())); rmSync(home, { recursive: true, force: true }); } };
+}
+
+it("workspace:app runs the Session pack's own tools and asks the person, with zero workspace calls", async () => {
+  const looked: unknown[] = [];
+  const f = await fixture((_body, response, turn) => turn === 0 ? call(response, "lookup", { id: "plan-7" }) : turn === 1 ? call(response, "ask-user", { why: "Which week?" }) : say(response, "added"));
+  try {
+    const { pack, executors } = businessPack({ lookup: async input => { looked.push(input.args); return "plan-7: three items"; }, save: async () => "saved" });
+    const session = await f.runtime.sessions.create({ pack, executors });
+    const started = await f.runtime.startAgentRun({ session, workspace: "app", start: f.start(), agent: { idempotencyKey: "a1", mode: "build", toolNames: ["lookup", "save", "ask-user"] } });
+    const run = watch(started.run);
+    const asked = await run.until("awaiting-input") as Extract<ModelEvent, { type: "awaiting-input" }>;
+    await f.runtime.effects.pendings.answer(asked.pendingRef, { kind: "text", text: "week 42" }, await f.runtime.readClock());
+    expect((await run.until("terminal")).type).toBe("completed");
+    expect(looked).toEqual([{ id: "plan-7" }]);
+    // The model saw exactly the named tools: the pack's and asking, never a file tool.
+    const offered = f.requests[0].tools.map((one: any) => one.function.name).sort();
+    expect(offered).toEqual(["ask-user", "lookup", "save"]);
+    expect(JSON.stringify(f.requests[2])).toContain("week 42");
+    expect(f.workspaceCalls).toEqual([]);
+  } finally { await f.close(); }
+});
+
+it("workspace:app holds a writing pack tool for approval like any other effect", async () => {
+  const saved: unknown[] = [];
+  const f = await fixture((_body, response, turn) => turn === 0 ? call(response, "save", { id: "plan-7" }) : say(response));
+  try {
+    const { pack, executors } = businessPack({ lookup: async () => "", save: async input => { saved.push(input.args); return "saved"; } });
+    const session = await f.runtime.sessions.create({ pack, executors });
+    const started = await f.runtime.startAgentRun({ session, workspace: "app", start: f.start(), agent: { idempotencyKey: "a2", mode: "build", toolNames: ["save"] } });
+    const run = watch(started.run);
+    const asked = await run.until("awaiting-approval") as Extract<ModelEvent, { type: "awaiting-approval" }>;
+    expect(saved).toEqual([]);
+    await f.runtime.effects.pendings.answer(asked.pendingRef, { kind: "effect-approval", answer: "allow" }, await f.runtime.readClock());
+    expect((await run.until("terminal")).type).toBe("completed");
+    expect(saved).toEqual([{ id: "plan-7" }]);
+    expect(f.workspaceCalls).toEqual([]);
+  } finally { await f.close(); }
+});
+
+it("workspace:app refuses file tools, roots, runners, subagents, skills and workspace context before the network", async () => {
+  const f = await fixture((_body, response) => say(response));
+  try {
+    const { pack, executors } = businessPack({ lookup: async () => "", save: async () => "" });
+    const session = await f.runtime.sessions.create({ pack, executors });
+    const base = { session, workspace: "app" as const, start: f.start(), agent: { idempotencyKey: "r", mode: "build" as const, toolNames: ["lookup"] } };
+    for (const change of [
+      { agent: { idempotencyKey: "missing" } },
+      ...["read", "write", "run-command", "list", "dispatch-subagent", "session-send"].map(name => ({ agent: { idempotencyKey: name, toolNames: ["lookup", name] } })),
+      { rootRef: { kind: "authorized-root", id: "fake", revision: 1 } }, { runTool: async () => "forbidden" }, { subagents: {} },
+      { grants: { toolNames: ["lookup"], paths: ["."] } }, { context: { projectTrusted: true } },
+      { agent: { idempotencyKey: "skills", toolNames: ["lookup"], skillNames: ["anything"] } },
+      { agent: { idempotencyKey: "directory", toolNames: ["lookup"], workingDirectory: "." } },
+    ]) {
+      await expect(f.runtime.startAgentRun({ ...base, ...change } as never)).rejects.toMatchObject({ code: "AGENT_START_INVALID" });
+    }
+    // Another Session's pack tools are not this one's.
+    const bare = await f.runtime.sessions.create();
+    await expect(f.runtime.startAgentRun({ ...base, session: bare })).rejects.toMatchObject({ code: "AGENT_START_INVALID" });
+    expect(f.requests).toEqual([]);
+    expect(f.workspaceCalls).toEqual([]);
+    expect(APP_MODE_SYSTEM_TOOLS).toEqual(["ask-user", "update-todo", "find-tools", "context-remaining"]);
+  } finally { await f.close(); }
+});
+
+it("workspace:none keeps refusing every tool, including a pack's", async () => {
+  const f = await fixture((_body, response) => say(response));
+  try {
+    const { pack, executors } = businessPack({ lookup: async () => "", save: async () => "" });
+    const session = await f.runtime.sessions.create({ pack, executors });
+    await expect(f.runtime.startAgentRun({ session, workspace: "none", start: f.start(), agent: { idempotencyKey: "n", toolNames: [] } })).rejects.toMatchObject({ code: "AGENT_START_INVALID" });
+  } finally { await f.close(); }
+});
+
+it("a session-stop hook can hold a run that only announced what it would do; the loop continues with the hook's reason, at most twice", async () => {
+  const f = await fixture((_body, response, turn) => turn === 0 ? say(response, "现在去保存。") : turn === 1 ? call(response, "lookup", { id: "plan-7" }) : say(response, turn === 2 ? "Now saving." : turn === 3 ? "Saving now." : "all done"));
+  try {
+    const { pack, executors } = businessPack({ lookup: async () => "plan-7", save: async () => "saved" });
+    const session = await f.runtime.sessions.create({ pack, executors });
+    const seen: Array<{ text: unknown; run: unknown }> = [];
+    // Holds every stop: the loop's own limit must still end the run.
+    f.runtime.hooks.register({ id: "announce-guard", event: "session-stop", forSession: session.ref.id, handler: async context => {
+      seen.push({ text: (context.input as { text?: unknown }).text, run: context.origin?.run });
+      return { kind: "deny" as const, why: "You only announced the next step; call the tool now or say you are done." };
+    } });
+    const started = await f.runtime.startAgentRun({ session, workspace: "app", start: f.start(), agent: { idempotencyKey: "s1", mode: "build", toolNames: ["lookup", "save"] } });
+    const run = watch(started.run);
+    expect((await run.until("terminal")).type).toBe("completed");
+    const repairs = run.events.filter(event => event.type === "model-response-repair");
+    expect(repairs).toEqual([{ type: "model-response-repair", reason: "stop-held" }, { type: "model-response-repair", reason: "stop-held" }]);
+    expect(seen.map(one => one.text)).toEqual(["现在去保存。", "Now saving."]);
+    expect(seen.every(one => typeof one.run === "string")).toBe(true);
+    // The held answer stays in the model's view, followed by the hook's reason.
+    const second = JSON.stringify(f.requests[1]);
+    expect(second).toContain("现在去保存。");
+    expect(second).toContain("You only announced the next step");
+    // Two holds, then it finishes on the third plain answer without asking again.
+    expect(f.requests).toHaveLength(4);
+  } finally { await f.close(); }
+});
+
+it("without a session-stop hook a plain answer completes the run as before", async () => {
+  const f = await fixture((_body, response) => say(response, "现在去保存。"));
+  try {
+    const { pack, executors } = businessPack({ lookup: async () => "plan-7", save: async () => "saved" });
+    const session = await f.runtime.sessions.create({ pack, executors });
+    const started = await f.runtime.startAgentRun({ session, workspace: "app", start: f.start(), agent: { idempotencyKey: "s2", mode: "build", toolNames: ["lookup"] } });
+    const run = watch(started.run);
+    expect((await run.until("terminal")).type).toBe("completed");
+    expect(run.events.some(event => event.type === "model-response-repair")).toBe(false);
+    expect(f.requests).toHaveLength(1);
+  } finally { await f.close(); }
+});
diff --git a/packages/sdk/test/dispatch-denied.live.test.ts b/packages/sdk/test/dispatch-denied.live.test.ts
new file mode 100644
index 00000000..5d80ae7c
--- /dev/null
+++ b/packages/sdk/test/dispatch-denied.live.test.ts
@@ -0,0 +1,83 @@
+import { mkdtempSync, rmSync } from "node:fs";
+import { createServer, type ServerResponse } from "node:http";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { expect, it } from "vitest";
+import { createRuntime, type ModelEvent, type Run } from "../src/index.js";
+import { createNodeHost } from "../src/node.js";
+
+/**
+ * The App's last check before model bytes leave (`beforeModelDispatch`) said no: a Character was disabled, a grant
+ * withdrawn. That is a denial, not a network failure — nothing was sent, and sending again or to a fallback target
+ * gets the same answer. It used to surface as `MODEL_NETWORK_FAILED`, which sent people off to check their network.
+ */
+function end(run: Run) {
+  return new Promise<ModelEvent[]>((resolve, reject) => {
+    const events: ModelEvent[] = [];
+    const timer = setTimeout(() => reject(new Error(`Run did not finish: ${events.map(e => e.type).join(",")}`)), 8000);
+    run.subscribe(event => { events.push(event); if (["completed", "failed", "cancelled"].includes(event.type)) { clearTimeout(timer); resolve(events); } });
+  });
+}
+function say(response: ServerResponse) {
+  response.writeHead(200, { "content-type": "text/event-stream" });
+  response.end(`data: ${JSON.stringify({ model: "provider-model", choices: [{ delta: { content: "answered" } }], usage: { prompt_tokens: 7, completion_tokens: 3 } })}\n\ndata: [DONE]\n\n`);
+}
+async function fixture(guard: () => Promise<void>) {
+  const home = mkdtempSync(join(tmpdir(), "prologue-dispatch-denied-"));
+  const requests: unknown[] = [];
+  const server = createServer(async (request, response) => { let raw = ""; for await (const chunk of request) raw += chunk; requests.push(JSON.parse(raw)); say(response); });
+  await new Promise<void>(resolve => server.listen(0, "127.0.0.1", resolve));
+  const address = server.address(); if (!address || typeof address === "string") throw new Error("missing endpoint");
+  const host = createNodeHost({ storageRoot: join(home, "store"), beforeModelDispatch: guard });
+  const runtime = await createRuntime({ app: { appId: "prologue.dispatch-denied", appVersion: "1.0.0" }, host, preset: "local-agent",
+    network: { model: true, loopback: true }, posture: { sandbox: "workspace-write" }, permissionMode: { mode: "ask-always" } });
+  const credentialRef = (await runtime.credentials.write({ label: "test", secret: { plaintext: new TextEncoder().encode("synthetic") } })).ref;
+  const target = (model: string) => ({ protocol: "openai-compatible" as const, endpoint: `http://127.0.0.1:${address.port}/chat`, credentialRef, model });
+  return { runtime, requests, target, async close() { await runtime.shutdown(); server.closeAllConnections(); await new Promise<void>(resolve => server.close(() => resolve())); rmSync(home, { recursive: true, force: true }); } };
+}
+
+it("an agent round the App refuses fails as a denial with the App's reason, sends nothing and does not fall back", async () => {
+  const f = await fixture(async () => { throw new Error("Character disabled"); });
+  try {
+    const session = await f.runtime.sessions.create();
+    const { run } = await f.runtime.startAgentRun({ session, workspace: "none", history: "session",
+      start: { ...f.target("primary"), fallback: [f.target("backup")], messages: [{ role: "user", text: "task" }] },
+      agent: { idempotencyKey: "denied", toolNames: [] } });
+    const events = await end(run);
+    const last = events.at(-1);
+    expect(last?.type).toBe("failed");
+    if (last?.type !== "failed") return;
+    expect(last.error.code).toBe("EFFECT_NOT_AUTHORIZED");
+    expect(last.error.safeMessage).toMatch(/Character disabled/);
+    expect(events.some(event => event.type === "fallback")).toBe(false);
+    expect(f.requests).toHaveLength(0);
+  } finally { await f.close(); }
+});
+
+it("a one-shot run the App refuses fails as a denial, not a network failure", async () => {
+  const f = await fixture(async () => { throw new Error("grant withdrawn"); });
+  try {
+    const session = await f.runtime.sessions.create({ ephemeral: true });
+    const run = await session.startRun({ ...f.target("primary"), messages: [{ role: "user", text: "hello" }], timeoutMs: 5000 });
+    const last = (await end(run)).at(-1);
+    expect(last?.type).toBe("failed");
+    if (last?.type !== "failed") return;
+    expect(last.error.code).toBe("EFFECT_NOT_AUTHORIZED");
+    expect(last.error.safeMessage).toMatch(/grant withdrawn/);
+    expect(f.requests).toHaveLength(0);
+  } finally { await f.close(); }
+});
+
+it("cancelling while the App is still deciding stays a cancellation", async () => {
+  const entered = Promise.withResolvers<void>(), release = Promise.withResolvers<void>();
+  const f = await fixture(async () => { entered.resolve(); await release.promise; });
+  try {
+    const session = await f.runtime.sessions.create({ ephemeral: true });
+    const run = await session.startRun({ ...f.target("primary"), messages: [{ role: "user", text: "hello" }], timeoutMs: 5000 });
+    const ended = end(run);
+    await entered.promise;
+    await run.cancel();
+    expect((await ended).at(-1)?.type).toBe("cancelled");
+    expect(f.requests).toHaveLength(0);
+  } finally { release.resolve(); await f.close(); }
+});
diff --git a/packages/sdk/test/network-dispatch-authority.live.test.ts b/packages/sdk/test/network-dispatch-authority.live.test.ts
new file mode 100644
index 00000000..1f06710e
--- /dev/null
+++ b/packages/sdk/test/network-dispatch-authority.live.test.ts
@@ -0,0 +1,70 @@
+import { AsyncLocalStorage } from "node:async_hooks";
+import { mkdtempSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { expect, it } from "vitest";
+import { createNodeHost } from "../src/node.js";
+import { createRuntime, openMcpHttp, type McpHttpPort } from "../src/index.js";
+import { startMcpHttpServer } from "./fixtures/mcp-http-server.mjs";
+
+async function fixture(guard: () => void | Promise<void>, prepare?: () => Promise<void>) {
+  const root = mkdtempSync(join(tmpdir(), "sdk-network-authority-"));
+  let modelChecks = 0;
+  const host = createNodeHost({ storageRoot: root, beforeNetworkDispatch: guard, beforeModelDispatch: () => { modelChecks++; } });
+  const runtime = await createRuntime({ app: { appId: "prologue.network-authority", appVersion: "1.0.0" }, host, network: { mcp: true, loopback: true } });
+  const server = await startMcpHttpServer();
+  let callHandle: Awaited<ReturnType<typeof host.prepareModelNetwork>> | undefined;
+  const port: McpHttpPort = { prepareModelNetwork: async input => {
+    const handle = await host.prepareModelNetwork(input);
+    if (JSON.parse(new TextDecoder().decode(input.body)).method === "tools/call") { callHandle = handle; await prepare?.(); }
+    return handle;
+  }, executeModelNetwork: input => host.executeModelNetwork(input), cancelModelNetwork: handle => host.cancelModelNetwork(handle), inspectModelNetwork: handle => host.inspectModelNetwork(handle) };
+  const session = await openMcpHttp({ port, spec: { endpoint: `http://127.0.0.1:${server.port}/mcp`, requestTimeoutMs: 5000 }, clientName: "authority-test" });
+  const call = (control?: Parameters<typeof session.request>[1]) => session.request(id => ({ jsonrpc: "2.0", id, method: "tools/call", params: { name: "lookup", arguments: { q: "one" } } }), control);
+  return { call, seen: server.seen, inspect: () => host.inspectModelNetwork(callHandle!), modelChecks: () => modelChecks, async close() {
+    await session.close(); await runtime.shutdown(); server.server.closeAllConnections(); await new Promise<void>(resolve => server.server.close(() => resolve())); rmSync(root, { recursive: true, force: true });
+  } };
+}
+
+it("MCP authority revoked after real preparation prevents dispatch and remains a denial; a fresh authorized call works", async () => {
+  let allowed = true, pause = true;
+  const entered = Promise.withResolvers<void>(), release = Promise.withResolvers<void>();
+  const f = await fixture(() => { if (!allowed) throw new Error("MCP grant withdrawn"); }, async () => { if (pause) { entered.resolve(); await release.promise; } });
+  try {
+    const pending = f.call(), rejected = expect(pending).rejects.toMatchObject({ code: "EFFECT_NOT_AUTHORIZED" });
+    await entered.promise; allowed = false; release.resolve(); await rejected;
+    expect(f.seen.methods.filter(method => method === "tools/call")).toHaveLength(0);
+    expect(await f.inspect()).toMatchObject({ dispatched: false, retryable: false, status: "failed" });
+    allowed = true; pause = false;
+    expect(JSON.stringify(await f.call())).toContain("found it");
+    expect(f.seen.methods.filter(method => method === "tools/call")).toHaveLength(1);
+    expect(f.modelChecks()).toBe(0);
+  } finally { allowed = true; release.resolve(); await f.close(); }
+});
+
+it("cancellation while the final MCP guard waits sends no tool bytes and does not hang on the guard", async () => {
+  let hold = false;
+  const entered = Promise.withResolvers<void>(), release = Promise.withResolvers<void>(), abort = new AbortController();
+  const f = await fixture(async () => { if (hold) { entered.resolve(); await release.promise; } });
+  try {
+    hold = true;
+    const pending = f.call({ signal: abort.signal }), rejected = expect(pending).rejects.toMatchObject({ code: "CANCELLED" });
+    await entered.promise; abort.abort(); await rejected;
+    expect(f.seen.methods.filter(method => method === "tools/call")).toHaveLength(0);
+    expect(await f.inspect()).toMatchObject({ dispatched: false, status: "cancelled" });
+  } finally { hold = false; release.resolve(); await f.close(); }
+});
+
+it("concurrent MCP callers keep separate authority and a denied caller does not contaminate a later call", async () => {
+  const guards = new AsyncLocalStorage<() => void | Promise<void>>();
+  const f = await fixture(async () => { await guards.getStore()?.(); });
+  const entered = Promise.withResolvers<void>(), release = Promise.withResolvers<void>();
+  try {
+    const rejected = expect(guards.run(async () => { entered.resolve(); await release.promise; throw new Error("Only this caller is revoked"); }, () => f.call())).rejects.toMatchObject({ code: "EFFECT_NOT_AUTHORIZED" });
+    await entered.promise;
+    expect(JSON.stringify(await guards.run(() => {}, () => f.call()))).toContain("found it");
+    release.resolve(); await rejected;
+    expect(JSON.stringify(await f.call())).toContain("found it");
+    expect(f.seen.methods.filter(method => method === "tools/call")).toHaveLength(2);
+  } finally { release.resolve(); await f.close(); }
+});
