+    const row = held.get(ref.id);
+    if (row === undefined) throw createPrologueError("MEMORY_NOT_ACCEPTED", "That memory candidate does not exist.");
+    if (row.state !== "pending") throw createPrologueError("MEMORY_NOT_ACCEPTED", `That candidate is already ${row.state}.`);
