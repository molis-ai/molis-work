{
  "name": "@molis-ai/molis-work-plugin-files",
  "version": "0.0.0",
  "private": true,
  "description": "First-party Files tree and reader: captures bounded text snapshots and selections.",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./registration": {
      "types": "./dist/registration.d.ts",
      "import": "./dist/registration.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.browser.json && esbuild src/browser/factory.ts --bundle --format=iife --platform=browser --minify --charset=utf8 '--banner:js=(host, icons, browser) => {' '--footer:js=return browser}' --outfile=dist/files-client.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.browser.json"
  },
  "dependencies": {
    "@molis-ai/molis-work-contracts": "workspace:*",
    "@molis-ai/molis-work-design-system": "workspace:*",
    "@molis-ai/molis-work-plugin-sdk": "workspace:*"
  },
  "molis-work": {
    "path": "plugins/native/files",
    "kind": "native-plugin",
    "maturity": "partial",
    "contract": "@molis-ai/molis-work-contracts/platform/plugin",
    "summary": "First-party Files tree and reader: captures bounded text snapshots and selections.",
    "notResponsibleFor": "Directory reads, filesystem grants, or comparison rendering.",
    "legacySources": [],
    "migrationGoals": [
      "goal-reorg-f2",
      "goal-plugin-platform-v2"
    ],
    "ssot": "docs/SSOT-MATRIX.md",
    "capabilities": [
      "files.artifact-types.v1",
      "files.ui-contribution.v1"
    ],
    "extraWorkspaceDependencies": [
      "@molis-ai/molis-work-design-system",
      "@molis-ai/molis-work-plugin-sdk"
    ],
    "extraDependencies": {},
    "registration": "./registration"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
