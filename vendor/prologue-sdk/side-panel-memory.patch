+/*
+ * An App-tools run (no workspace) drives an interface the App attached for its Session: the three surface tools are
+ * allowed only while such an interface is attached, text observations reach the model marked as page content, and
+ * another Session's interface is neither listed nor usable.
+ */
+
+function watch(run: Run) {
+  const events: ModelEvent[] = [];
+  run.subscribe(event => { events.push(event); });
+  const until = (type: ModelEvent["type"] | "terminal") => new Promise<ModelEvent>((resolve, reject) => {
+    const timer = setInterval(() => {
+      const found = events.find(event => type === "terminal" ? ["completed", "failed", "cancelled"].includes(event.type) : event.type === type);
+      if (found) { clearInterval(timer); clearTimeout(limit); resolve(found); }
+    }, 5);
+    const limit = setTimeout(() => { clearInterval(timer); reject(new Error(`no ${type}: ${events.map(e => e.type).join(",")}`)); }, 4000);
+  });
+  return { events, until };
+}
+const sse = (response: ServerResponse, delta: object) => {
+  response.writeHead(200, { "content-type": "text/event-stream" });
+  response.end(`data: ${JSON.stringify({ model: "m", choices: [{ delta }], usage: { prompt_tokens: 7, completion_tokens: 3 } })}\n\ndata: [DONE]\n\n`);
+};
+const say = (response: ServerResponse, text = "done") => sse(response, { content: text });
+const call = (response: ServerResponse, name: string, args: object, id = "c1") =>
+  sse(response, { tool_calls: [{ index: 0, id, type: "function", function: { name, arguments: JSON.stringify(args) } }] });
+
+const pack: ScenarioPack = { id: "business-actions", version: "1.0.0", source: { kind: "app-embedded" }, needs: { hostCapabilities: [], executors: [] },
+  permissions: { tools: [], network: [], paths: [] }, memory: { scope: "session", write: "deny" },
+  roster: [{ role: "assistant", skills: [], writes: true }], planning: { plannedBy: "assistant", planFirst: false }, config: {}, tools: [] };
+
+async function fixture(handler: (body: any, response: ServerResponse, turn: number) => void, observationTtlMs?: number) {
+  const home = mkdtempSync(join(tmpdir(), "prologue-app-surfaces-"));
+  const requests: any[] = [];
+  let turn = 0;
+  const server = createServer(async (request, response) => {
+    let raw = ""; for await (const chunk of request) raw += chunk;
+    const body = JSON.parse(raw); requests.push(body); handler(body, response, turn++);
+  });
+  await new Promise<void>(resolve => server.listen(0, "127.0.0.1", resolve));
+  const address = server.address(); if (!address || typeof address === "string") throw new Error("missing endpoint");
+  const runtime = await createRuntime({ app: { appId: "prologue.app-surfaces", appVersion: "1.0.0" }, host: createNodeHost({ storageRoot: join(home, "store") }),
+    preset: "local-agent", network: { model: true, loopback: true }, posture: { sandbox: "workspace-write", approval: "untrusted" },
+    // What an App like Molis writes: looking is allowed, every action on a page stops for the person.
+    ...(observationTtlMs === undefined ? {} : { surfaces: { limits: { observationTtlMs, maxObservationBytes: 1024 * 1024 } } }),
+    // An "ask" on the whole surface would also cover looking (ask outranks allow), so the actions are named one by one.
+    rules: [{ source: "runtime", effect: "allow", match: { what: "surface", action: "observe" } },
+      ...["pointer", "key", "text", "navigate", "wait", "upload", "download"].map(action => ({ source: "runtime" as const, effect: "ask" as const, match: { what: "surface" as const, action } }))] });
+  const credentialRef = (await runtime.credentials.write({ label: "test", secret: { plaintext: new TextEncoder().encode("synthetic") } })).ref;
+  const start = () => ({ protocol: "openai-compatible", endpoint: `http://127.0.0.1:${address.port}/chat`, credentialRef, model: "m", messages: [{ role: "user" as const, text: "task" }] });
+  return { runtime, requests, start, async close() { await runtime.shutdown(); server.closeAllConnections(); await new Promise<void>(resolve => server.close(() => resolve())); rmSync(home, { recursive: true, force: true }); } };
+}
