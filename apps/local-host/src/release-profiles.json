{
  "application": {
    "identifier": "com.molis.work",
    "productName": "Molis Work",
    "minimumSystemVersion": "13.0"
  },
  "runtime": {
    "nodeVersionFile": ".nvmrc"
  },
  "macOS": {
    "machO": [
      "Contents/MacOS/*",
      "Contents/Resources/resources/molis-work-runtime/runtime/*",
      "Contents/Resources/resources/molis-work-runtime/node_modules/**/*.node",
      "Contents/Resources/resources/molis-work-runtime/node_modules/**/*.dylib",
      "Contents/Resources/resources/molis-work-runtime/node_modules/**/native/*/bin/**/*"
    ],
    "secretRefs": {
      "certificate": "APPLE_CERTIFICATE",
      "certificatePassword": "APPLE_CERTIFICATE_PASSWORD",
      "signingIdentity": "APPLE_SIGNING_IDENTITY",
      "teamId": "APPLE_TEAM_ID",
      "appleId": "APPLE_ID",
      "notaryPassword": "APPLE_PASSWORD"
    }
  },
  "accountEnvironments": {
    "dev": {
      "environmentId": "unified-local",
      "environmentKind": "LOCAL",
      "authOrigin": "http://127.0.0.1:8787",
      "applicationId": "molis-work-unified-local-app",
      "clientId": "molis-work-unified-local",
      "port": 4207,
      "providerMode": "MOCK",
      "deliveryMode": "MOCK"
    },
    "test": {
      "environmentId": "unified-staging",
      "environmentKind": "TEST",
      "authOrigin": "https://auth-staging.molis.ai",
      "applicationId": "molis-work-staging-app",
      "clientId": "molis-work-staging",
      "port": 44207,
      "providerMode": "LIVE",
      "deliveryMode": "MOCK"
    },
    "prod": {
      "environmentId": "auth-production",
      "environmentKind": "PRODUCTION",
      "authOrigin": "https://molis-auth-production.sparkling-silence-0a49.workers.dev",
      "applicationId": "molis-work-production-app",
      "clientId": "molis-work-production",
      "port": 4207,
      "providerMode": "LIVE",
      "deliveryMode": "LIVE"
    }
  },
  "profiles": {
    "dev": {
      "accountEnvironment": "dev",
      "signingIdentity": "-",
      "notarization": "off",
      "entitlements": null,
      "connectors": {
        "brokerOrigin": null,
        "services": [],
        "applicationSecretPrefix": "OAUTH_APP_",
        "applications": "test"
      },
      "publisherKeyRef": "MOLIS_WORK_DEV_PUBLISHER_KEY_FILE",
      "updateChannel": null,
      "symbolUploadTarget": null,
      "crashReporting": false
    },
    "test": {
      "accountEnvironment": "test",
      "signingIdentity": "-",
      "notarization": "off",
      "entitlements": null,
      "connectors": {
        "brokerOrigin": null,
        "services": [],
        "applicationSecretPrefix": "OAUTH_APP_",
        "applications": "test"
      },
      "publisherKeyRef": "MOLIS_WORK_TEST_PUBLISHER_KEY_FILE",
      "updateChannel": null,
      "symbolUploadTarget": null,
      "crashReporting": false
    },
    "release": {
      "accountEnvironment": null,
      "signingIdentity": null,
      "notarization": null,
      "entitlements": null,
      "connectors": {
        "brokerOrigin": null,
        "services": [],
        "applicationSecretPrefix": null,
        "applications": null
      },
      "publisherKeyRef": null,
      "updateChannel": null,
      "symbolUploadTarget": null,
      "crashReporting": false
    }
  }
}
