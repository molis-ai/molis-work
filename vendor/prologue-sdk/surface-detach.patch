-export function redactSurfaceError(raw: unknown): string {
-  const text = typeof raw === "string" ? raw : ((raw as { message?: string })?.message ?? "");
-  return text
-    /*
-     * URL 只留到路径为止。
-     *
-     * 查询串和片段是令牌最常待的地方，而它们对「为什么没点成」这件事
-     * 一点用都没有。
-     */
-    .replace(/(https?:\/\/[^\s?#]*)[?#][^\s]*/gi, "$1[redacted query]")
-    .replace(/(?:\/(?:Users|home|var|tmp|etc|opt|private)\/[^\s"']*|[A-Za-z]:\\[^\s"']*)/g, "[redacted path]")
-    .split("\n")
-    .filter((line) => !/^\s*at\s/.test(line))
-    .join("\n")
-    .slice(0, 300);
-}
