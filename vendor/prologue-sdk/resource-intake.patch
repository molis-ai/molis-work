+import { mkdtempSync, rmSync } from "node:fs";
+import { createServer, type ServerResponse } from "node:http";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { expect, it } from "vitest";
+import { APP_MODE_SYSTEM_TOOLS, createRuntime, type ModelEvent, type Run, type ScenarioPack, type ToolRunner } from "../src/index.js";
+import { createNodeHost } from "../src/node.js";
+
+function watch(run: Run) {
+  const events: ModelEvent[] = [];
+  run.subscribe(event => { events.push(event); });
+  const until = (type: ModelEvent["type"] | "terminal") => new Promise<ModelEvent>((resolve, reject) => {
+    const timer = setInterval(() => {
+      const found = events.find(event => type === "terminal" ? ["completed", "failed", "cancelled"].includes(event.type) : event.type === type);
+      if (found) { clearInterval(timer); clearTimeout(limit); resolve(found); }
+    }, 5);
+    const limit = setTimeout(() => { clearInterval(timer); reject(new Error(`no ${type}: ${events.map(e => e.type + (e.type === "failed" ? JSON.stringify((e as any).error) : e.type === "tool-result" ? JSON.stringify((e as any).text ?? (e as any).error ?? e) : "")).join(",")}`)); }, 4000);
+  });
+  return { events, until };
+}
+function say(response: ServerResponse, text = "done") {
+  response.writeHead(200, { "content-type": "text/event-stream" });
+  response.end(`data: ${JSON.stringify({ model: "m", choices: [{ delta: { content: text } }], usage: { prompt_tokens: 7, completion_tokens: 3 } })}\n\ndata: [DONE]\n\n`);
+}
+function call(response: ServerResponse, name: string, args: object) {
+  response.writeHead(200, { "content-type": "text/event-stream" });
+  response.end(`data: ${JSON.stringify({ usage: { prompt_tokens: 7, completion_tokens: 3 }, choices: [{ delta: { tool_calls: [{ index: 0, id: "c1", type: "function", function: { name, arguments: JSON.stringify(args) } }] } }] })}\n\ndata: [DONE]\n\n`);
+}
+
+/** A pack like an App's business actions: one read and one write, each with its own executor. */
+function businessPack(executors: { lookup: ToolRunner; save: ToolRunner }): { pack: ScenarioPack; executors: Record<string, ToolRunner> } {
+  const tool = (name: string, effectKind: "safe-read" | "mutate-external") => ({ executor: name, registration: { name, version: "1", description: `${name} a business record`,
+    parameters: { type: "object", properties: { id: { type: "string" } }, required: ["id"], additionalProperties: false }, effectKind, gate: "broker" as const, timeoutMs: 5000, idempotency: "none" as const } });
+  return { executors, pack: { id: "business-actions", version: "1.0.0", source: { kind: "app-embedded" }, needs: { hostCapabilities: [], executors: ["lookup", "save"] },
+    permissions: { tools: ["lookup", "save"], network: [], paths: [] }, memory: { scope: "session", write: "deny" },
+    roster: [{ role: "assistant", skills: [], writes: true }], planning: { plannedBy: "assistant", planFirst: false }, config: {},
+    tools: [tool("lookup", "safe-read"), tool("save", "mutate-external")] } };
+}
+
+async function fixture(handler: (body: any, response: ServerResponse, turn: number) => void) {
+  const home = mkdtempSync(join(tmpdir(), "prologue-app-mode-"));
+  const workspaceCalls: string[] = [], requests: any[] = [];
+  let turn = 0;
+  const server = createServer(async (request, response) => {
+    let raw = ""; for await (const chunk of request) raw += chunk;
+    const body = JSON.parse(raw); requests.push(body); handler(body, response, turn++);
+  });
+  await new Promise<void>(resolve => server.listen(0, "127.0.0.1", resolve));
+  const address = server.address(); if (!address || typeof address === "string") throw new Error("missing endpoint");
+  const actual = createNodeHost({ storageRoot: join(home, "store") });
+  const methods = new Set(["authorizeRoot", "listDirectory", "searchFiles", "readFile", "readBinary", "readBytes", "writeFile", "applyPatch", "prepareCommand", "runCommand"]);
+  const host = new Proxy(actual, { get(target, key, receiver) { const value = Reflect.get(target, key, receiver); return typeof value !== "function" ? value : (...args: unknown[]) => { if (methods.has(String(key))) workspaceCalls.push(String(key)); return value.apply(target, args); }; } });
+  const runtime = await createRuntime({ app: { appId: "prologue.app-mode", appVersion: "1.0.0" }, host, preset: "local-agent",
+    network: { model: true, loopback: true }, posture: { sandbox: "workspace-write", approval: "untrusted" }, permissionMode: { mode: "ask-always" } });
+  const credentialRef = (await runtime.credentials.write({ label: "test", secret: { plaintext: new TextEncoder().encode("synthetic") } })).ref;
+  const start = (text = "task") => ({ protocol: "openai-compatible", endpoint: `http://127.0.0.1:${address.port}/chat`, credentialRef, model: "m", messages: [{ role: "user" as const, text }] });
+  return { runtime, workspaceCalls, requests, start, async close() { await runtime.shutdown(); server.closeAllConnections(); await new Promise<void>(resolve => server.close(() => resolve())); rmSync(home, { recursive: true, force: true }); } };
+}
+
+it("workspace:app runs the Session pack's own tools and asks the person, with zero workspace calls", async () => {
+  const looked: unknown[] = [];
+  const f = await fixture((_body, response, turn) => turn === 0 ? call(response, "lookup", { id: "plan-7" }) : turn === 1 ? call(response, "ask-user", { why: "Which week?" }) : say(response, "added"));
+  try {
+    const { pack, executors } = businessPack({ lookup: async input => { looked.push(input.args); return "plan-7: three items"; }, save: async () => "saved" });
+    const session = await f.runtime.sessions.create({ pack, executors });
+    const started = await f.runtime.startAgentRun({ session, workspace: "app", start: f.start(), agent: { idempotencyKey: "a1", mode: "build", toolNames: ["lookup", "save", "ask-user"] } });
+    const run = watch(started.run);
+    const asked = await run.until("awaiting-input") as Extract<ModelEvent, { type: "awaiting-input" }>;
+    await f.runtime.effects.pendings.answer(asked.pendingRef, { kind: "text", text: "week 42" }, await f.runtime.readClock());
+    expect((await run.until("terminal")).type).toBe("completed");
+    expect(looked).toEqual([{ id: "plan-7" }]);
+    // The model saw exactly the named tools: the pack's and asking, never a file tool.
+    const offered = f.requests[0].tools.map((one: any) => one.function.name).sort();
+    expect(offered).toEqual(["ask-user", "lookup", "save"]);
+    expect(JSON.stringify(f.requests[2])).toContain("week 42");
+    expect(f.workspaceCalls).toEqual([]);
+  } finally { await f.close(); }
+});
+
+it("workspace:app holds a writing pack tool for approval like any other effect", async () => {
+  const saved: unknown[] = [];
+  const f = await fixture((_body, response, turn) => turn === 0 ? call(response, "save", { id: "plan-7" }) : say(response));
+  try {
+    const { pack, executors } = businessPack({ lookup: async () => "", save: async input => { saved.push(input.args); return "saved"; } });
+    const session = await f.runtime.sessions.create({ pack, executors });
+    const started = await f.runtime.startAgentRun({ session, workspace: "app", start: f.start(), agent: { idempotencyKey: "a2", mode: "build", toolNames: ["save"] } });
+    const run = watch(started.run);
+    const asked = await run.until("awaiting-approval") as Extract<ModelEvent, { type: "awaiting-approval" }>;
+    expect(saved).toEqual([]);
+    await f.runtime.effects.pendings.answer(asked.pendingRef, { kind: "effect-approval", answer: "allow" }, await f.runtime.readClock());
+    expect((await run.until("terminal")).type).toBe("completed");
+    expect(saved).toEqual([{ id: "plan-7" }]);
+    expect(f.workspaceCalls).toEqual([]);
+  } finally { await f.close(); }
+});
+
+it("workspace:app refuses file tools, roots, runners, subagents, skills and workspace context before the network", async () => {
+  const f = await fixture((_body, response) => say(response));
+  try {
+    const { pack, executors } = businessPack({ lookup: async () => "", save: async () => "" });
+    const session = await f.runtime.sessions.create({ pack, executors });
+    const base = { session, workspace: "app" as const, start: f.start(), agent: { idempotencyKey: "r", mode: "build" as const, toolNames: ["lookup"] } };
+    for (const change of [
+      { agent: { idempotencyKey: "missing" } },
+      ...["read", "write", "run-command", "list", "dispatch-subagent", "session-send"].map(name => ({ agent: { idempotencyKey: name, toolNames: ["lookup", name] } })),
+      { rootRef: { kind: "authorized-root", id: "fake", revision: 1 } }, { runTool: async () => "forbidden" }, { subagents: {} },
+      { grants: { toolNames: ["lookup"], paths: ["."] } }, { context: { projectTrusted: true } },
+      { agent: { idempotencyKey: "skills", toolNames: ["lookup"], skillNames: ["anything"] } },
+      { agent: { idempotencyKey: "directory", toolNames: ["lookup"], workingDirectory: "." } },
+    ]) {
+      await expect(f.runtime.startAgentRun({ ...base, ...change } as never)).rejects.toMatchObject({ code: "AGENT_START_INVALID" });
+    }
+    // Another Session's pack tools are not this one's.
+    const bare = await f.runtime.sessions.create();
