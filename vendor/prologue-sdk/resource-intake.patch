+  } finally {
+    await runtime.shutdown(); server.closeAllConnections();
+    await new Promise<void>(resolve => server.close(() => resolve())); await rm(home, { recursive: true, force: true });
+  }
+});
diff --git a/packages/sdk/test/bounded-run-results.test.ts b/packages/sdk/test/bounded-run-results.test.ts
new file mode 100644
index 00000000..011ebde1
--- /dev/null
+++ b/packages/sdk/test/bounded-run-results.test.ts
@@ -0,0 +1,65 @@
+import { expect, it } from "vitest";
+import { collectRun, validateAgainst, assertSchemaSupported, unknownUsage, type ModelEvent, type Run, type JsonSchema } from "../src/index.js";
+
+function replay(events: ModelEvent[]) {
+  let detached = 0, cancelled = 0;
+  const run: Run = { ref: { kind: "run", id: "test-run", revision: 1 }, state: "completed",
+    subscribe(listener) { for (const event of events) listener(event); return () => { detached++; }; },
+    async cancel() { cancelled++; } };
+  return { run, get detached() { return detached; }, get cancelled() { return cancelled; } };
+}
+const options = () => ({ signal: AbortSignal.timeout(5_000), maxTextChars: 100, maxEvents: 20 });
+
+it("collects committed synchronous replay once, preserving unknown usage and the original terminal", async () => {
+  const receipt = unknownUsage();
+  const f = replay([{ type: "text-delta", text: "answer" }, { type: "model-reported", model: "actual" },
+    { type: "usage-recorded", callId: "c", receipt }, { type: "completed" }]);
+  const seen: string[] = [];
+  const result = await collectRun(f.run, { ...options(), onEvent: event => seen.push(event.type) });
+  expect(result).toMatchObject({ ref: f.run.ref, state: "completed", text: "answer", reportedModels: ["actual"], usage: [receipt] });
+  expect(result.usage[0]!.input.tokens).toBeUndefined();
+  expect(seen).toHaveLength(4);
+  expect(f.detached).toBe(1); expect(f.cancelled).toBe(0);
+});
+
+it.each(["cancelled", "tripped", "circuit-tripped", "failed"] as const)("retains %s instead of returning apparent success", async state => {
+  const terminal = { type: state } as ModelEvent;
+  const f = replay([terminal]);
+  expect((await collectRun(f.run, options())).state).toBe(state);
+  expect(f.detached).toBe(1);
+});
+
+it("bounds both content and events, cancels and detaches without accepting late completion", async () => {
+  for (const limits of [{ maxTextChars: 2, maxEvents: 20 }, { maxTextChars: 100, maxEvents: 1 }]) {
+    const f = replay([{ type: "text-delta", text: "long" }, { type: "completed" }]);
+    await expect(collectRun(f.run, { ...options(), ...limits })).rejects.toMatchObject({ code: "MODEL_RESPONSE_INVALID" });
+    expect(f.cancelled).toBe(1); expect(f.detached).toBe(1);
+  }
+});
+
+it("an observer failure or synchronous cancellation releases the subscription and original Run", async () => {
+  for (const kind of ["throw", "abort"] as const) {
+    const controller = new AbortController(), error = new Error("stop");
+    const f = replay([{ type: "completed" }]);
+    await expect(collectRun(f.run, { ...options(), signal: controller.signal, onEvent() {
+      if (kind === "throw") throw error;
+      controller.abort(error);
+    } })).rejects.toBe(error);
+    expect(f.cancelled).toBe(1); expect(f.detached).toBe(1);
+  }
+});
+
+it("validates nullable alternatives, length/number bounds and enum together with type", () => {
+  const schema: JsonSchema = { type: "object", properties: {
+    title: { type: ["string", "null"], minLength: 1, maxLength: 2 },
+    values: { type: "array", minItems: 1, maxItems: 2, items: { type: "number", minimum: 0, maximum: 1 } },
+    extra: { anyOf: [{ type: "null" }, { type: "integer", minimum: 1 }] },
+  }, required: ["title", "values", "extra"], additionalProperties: false };
+  assertSchemaSupported(schema);
+  expect(validateAgainst({ title: "😀", values: [0, 1], extra: null }, schema)).toEqual([]);
+  expect(validateAgainst({ title: "", values: [2], extra: 0.5 }, schema).map(v => v.path)).toEqual(["$.title", "$.values[0]", "$.extra"]);
+  expect(validateAgainst(1, { type: "string", enum: [1] })).not.toEqual([]);
+  for (const malformed of [{ type: "string", minLength: -1 }, { type: "number", minimum: "0" }, { anyOf: [] }, { type: "mystery" }]) {
+    expect(() => assertSchemaSupported(malformed as JsonSchema)).toThrow(expect.objectContaining({ code: "MODEL_STRUCTURED_UNSUPPORTED" }));
+  }
+});
diff --git a/packages/sdk/test/dispatch-denied.live.test.ts b/packages/sdk/test/dispatch-denied.live.test.ts
new file mode 100644
index 00000000..5d80ae7c
--- /dev/null
+++ b/packages/sdk/test/dispatch-denied.live.test.ts
@@ -0,0 +1,83 @@
+import { mkdtempSync, rmSync } from "node:fs";
+import { createServer, type ServerResponse } from "node:http";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { expect, it } from "vitest";
+import { createRuntime, type ModelEvent, type Run } from "../src/index.js";
+import { createNodeHost } from "../src/node.js";
+
+/**
+ * The App's last check before model bytes leave (`beforeModelDispatch`) said no: a Character was disabled, a grant
+ * withdrawn. That is a denial, not a network failure — nothing was sent, and sending again or to a fallback target
+ * gets the same answer. It used to surface as `MODEL_NETWORK_FAILED`, which sent people off to check their network.
+ */
+function end(run: Run) {
+  return new Promise<ModelEvent[]>((resolve, reject) => {
+    const events: ModelEvent[] = [];
+    const timer = setTimeout(() => reject(new Error(`Run did not finish: ${events.map(e => e.type).join(",")}`)), 8000);
+    run.subscribe(event => { events.push(event); if (["completed", "failed", "cancelled"].includes(event.type)) { clearTimeout(timer); resolve(events); } });
+  });
+}
+function say(response: ServerResponse) {
+  response.writeHead(200, { "content-type": "text/event-stream" });
+  response.end(`data: ${JSON.stringify({ model: "provider-model", choices: [{ delta: { content: "answered" } }], usage: { prompt_tokens: 7, completion_tokens: 3 } })}\n\ndata: [DONE]\n\n`);
+}
+async function fixture(guard: () => Promise<void>) {
+  const home = mkdtempSync(join(tmpdir(), "prologue-dispatch-denied-"));
+  const requests: unknown[] = [];
+  const server = createServer(async (request, response) => { let raw = ""; for await (const chunk of request) raw += chunk; requests.push(JSON.parse(raw)); say(response); });
+  await new Promise<void>(resolve => server.listen(0, "127.0.0.1", resolve));
+  const address = server.address(); if (!address || typeof address === "string") throw new Error("missing endpoint");
+  const host = createNodeHost({ storageRoot: join(home, "store"), beforeModelDispatch: guard });
+  const runtime = await createRuntime({ app: { appId: "prologue.dispatch-denied", appVersion: "1.0.0" }, host, preset: "local-agent",
+    network: { model: true, loopback: true }, posture: { sandbox: "workspace-write" }, permissionMode: { mode: "ask-always" } });
+  const credentialRef = (await runtime.credentials.write({ label: "test", secret: { plaintext: new TextEncoder().encode("synthetic") } })).ref;
+  const target = (model: string) => ({ protocol: "openai-compatible" as const, endpoint: `http://127.0.0.1:${address.port}/chat`, credentialRef, model });
+  return { runtime, requests, target, async close() { await runtime.shutdown(); server.closeAllConnections(); await new Promise<void>(resolve => server.close(() => resolve())); rmSync(home, { recursive: true, force: true }); } };
+}
+
+it("an agent round the App refuses fails as a denial with the App's reason, sends nothing and does not fall back", async () => {
+  const f = await fixture(async () => { throw new Error("Character disabled"); });
+  try {
+    const session = await f.runtime.sessions.create();
+    const { run } = await f.runtime.startAgentRun({ session, workspace: "none", history: "session",
+      start: { ...f.target("primary"), fallback: [f.target("backup")], messages: [{ role: "user", text: "task" }] },
+      agent: { idempotencyKey: "denied", toolNames: [] } });
+    const events = await end(run);
+    const last = events.at(-1);
+    expect(last?.type).toBe("failed");
+    if (last?.type !== "failed") return;
+    expect(last.error.code).toBe("EFFECT_NOT_AUTHORIZED");
+    expect(last.error.safeMessage).toMatch(/Character disabled/);
+    expect(events.some(event => event.type === "fallback")).toBe(false);
+    expect(f.requests).toHaveLength(0);
+  } finally { await f.close(); }
+});
+
+it("a one-shot run the App refuses fails as a denial, not a network failure", async () => {
+  const f = await fixture(async () => { throw new Error("grant withdrawn"); });
+  try {
+    const session = await f.runtime.sessions.create({ ephemeral: true });
+    const run = await session.startRun({ ...f.target("primary"), messages: [{ role: "user", text: "hello" }], timeoutMs: 5000 });
+    const last = (await end(run)).at(-1);
+    expect(last?.type).toBe("failed");
+    if (last?.type !== "failed") return;
+    expect(last.error.code).toBe("EFFECT_NOT_AUTHORIZED");
+    expect(last.error.safeMessage).toMatch(/grant withdrawn/);
+    expect(f.requests).toHaveLength(0);
+  } finally { await f.close(); }
+});
+
+it("cancelling while the App is still deciding stays a cancellation", async () => {
+  const entered = Promise.withResolvers<void>(), release = Promise.withResolvers<void>();
+  const f = await fixture(async () => { entered.resolve(); await release.promise; });
+  try {
+    const session = await f.runtime.sessions.create({ ephemeral: true });
+    const run = await session.startRun({ ...f.target("primary"), messages: [{ role: "user", text: "hello" }], timeoutMs: 5000 });
+    const ended = end(run);
+    await entered.promise;
+    await run.cancel();
+    expect((await ended).at(-1)?.type).toBe("cancelled");
+    expect(f.requests).toHaveLength(0);
+  } finally { release.resolve(); await f.close(); }
+});
diff --git a/packages/sdk/test/network-dispatch-authority.live.test.ts b/packages/sdk/test/network-dispatch-authority.live.test.ts
new file mode 100644
index 00000000..1f06710e
