-/** 哪几种动作归哪一档。**闭集**——归不了类的不该被当成安全的。 */
-function kindOf(action: UiAction): EffectKind {
-  switch (action.what) {
-    case "pointer":
-    case "key":
-    case "text":
-    case "navigate":
-      // 点、打字、跳页都在改这台机器上的状态，而且人看得见。
-      return "mutate-local";
-    case "scroll":
-      /*
-       * 滚动看起来只是「往下看」，**但它改得了值**：指针底下是一个滑块、一个数字框、一个
-       * 下拉菜单时，滚一下就是改一下；无限滚动的页面滚到底会去拉下一页。归只读或「只是人
-       * 看得见」的话，一条「让它随便看」的规则就把这些也放过去了。
-       */
-      return "mutate-local";
-    case "drag":
-      // 拖动是在搬东西：挪文件、重排、选中一段再拖走。和点击同一档。
-      return "mutate-local";
-    case "menu":
-      // 菜单项什么都可能是：存储、删除、退出。和点击同一档；收不回的那几项由驱动说。
-      return "mutate-local";
-    case "app":
-      /*
-       * 切应用会**启动**一个应用（它开起来就在跑它自己的代码、恢复它自己的窗口），也会把
-       * 人眼前的那个应用换掉。这是在改这台机器的状态，不是「人看得见」那一档。
-       */
-      return "mutate-local";
-    case "hover":
-      /*
-       * 移指针什么都不提交——提交要靠点或按键，那几样各自过门。但**人看得见**：指针在他
-       * 的屏幕上动，悬停菜单和提示会弹出来。和 `wait` 一样它仍然过门，不留一种能不过门的
-       * 动作。
-       */
-      return "user-visible";
-    case "download":
-      // 落到本机磁盘上。和上面几样同一档。
-      return "mutate-local";
-    case "upload":
-      /*
-       * **`mutate-external`，不是 `mutate-local`。**
-       *
-       * 上传是把本机的字节送出这台机器——归本机那一档的话，一条
-       * 「本机随便改」的规则会顺手把外传也放过去，而写规则的人从没
-       * 打算允许这件事。
