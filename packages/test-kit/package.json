{
  "name": "@molis-ai/molis-work-test-kit",
  "version": "0.0.0",
  "private": true,
  "description": "Business-neutral test helpers: package import boundary rules, a headless Chrome/CDP launcher and driver, and a client for the Host's local HTTP management routes.",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "import": "./dist/browser/index.js"
    },
    "./local-host-http": {
      "types": "./dist/local-host-http/index.d.ts",
      "import": "./dist/local-host-http/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json",
    "test": "pnpm --filter \"@molis-ai/molis-work-test-kit^...\" run build && pnpm build && node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@molis-ai/molis-work-contracts": "workspace:*"
  },
  "molis-work": {
    "path": "packages/test-kit",
    "kind": "foundation",
    "maturity": "slice",
    "contract": "@molis-ai/molis-work-contracts/platform/testing",
    "migrationGoals": [
      "goal-reorg-f2",
      "goal-reorg-f3"
    ],
    "ssot": "docs/SSOT-MATRIX.md"
  }
}
