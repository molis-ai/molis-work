+type Handler = (request: IncomingMessage, response: ServerResponse, body: Record<string, unknown>) => void;
+async function fixture(handler: Handler, config?: CreateRuntimeInput["config"], beforeModelDispatch?: () => Promise<void>) {
+  const home = mkdtempSync(join(tmpdir(), "prologue-bounded-"));
+  const seen: { url: string; headers: IncomingMessage["headers"]; body: Record<string, unknown> }[] = [];
+  const server = createServer(async (request, response) => {
+    let raw = ""; for await (const bytes of request) raw += bytes;
+    const body = raw ? JSON.parse(raw) : {};
+    seen.push({ url: request.url!, headers: request.headers, body }); handler(request, response, body);
+  });
+  await new Promise<void>(resolve => server.listen(0, "127.0.0.1", resolve));
+  const bound = server.address(); if (!bound || typeof bound === "string") throw new Error("No endpoint");
