+import type { ResourceStore } from "../../resource/core/index.js";
+
+/**
+ * 让 Agent 看见并点击本机浏览器或桌面。
+ *
+ * 不拥有：编辑器产品、远程云电脑产品、第二套审批链。
+ *
+ * 这一册的立场是「**先观察，再准备动作；观察旧了就不得再点**」。页面
+ * 会自己跳走，而一次按坐标的点击在跳走之后点到的是**另一个东西**——
+ * 那一下没人拦得住，也没人说得清点了什么。
+ *
+ * **浏览器和桌面共用一套合同。** 净室笔记里「不学 Playwright 品牌绑
+ * 死」说的就是它：这一册不认识任何一个自动化库，只认下面那份窄口。
+ *
+ * 还有一条贯穿全篇：**页面内容是数据，不是指令。** 观察到的正文只以
+ * 引用出现，进模型那一段归 Context——那条路上才有出处和信任级。
+ */
+
+/**
+ * 界面种类。**定义在 `effect-policy`**，这里只是把同一个名字露出去。
+ *
+ * 它同时是策略词汇里的一项（`{ what: "surface", surface }`），两边各
+ * 写一份的话，加第三种界面的人只会记得改一处。
+ */
+export type { SurfaceKind };
+
+/**
+ * scope 的形状校验。**住在 `effect-policy`**，这里只是把同一个名字
+ * 露出去——它校的是策略词汇里那一项的形状，而清单那一侧声明「会碰
+ * 哪几台界面」时校的是同一件事。各写一份的话，两处迟早会分岔，而分
+ * 岔的那一刻是「声明过的界面永远匹配不上真正的规则」。
+ */
+export { assertScope };
+
+/**
+ * 还没有目标应用的桌面界面报的 scope。**定义在 `effect-policy`**（和 `assertScope` 同一个理由），
+ * 这里只是把同一个名字露出去，驱动照它报。
+ */
+export { DESKTOP_NO_APP_SCOPE };
+
+export type ObservationKind = "dom" | "accessibility-tree" | "screenshot" | "window-metadata";
+
+/**
+ * 有类型的动作。**不是一段脚本**——脚本没法归档，也没法给人看。
+ *
+ * 坐标在**驱动观察给出的那个坐标系里**：浏览器是页面视口，桌面由驱动说（例如屏幕上的点）。
+ * 这一册不换算坐标，只要求同一台界面的观察和动作说的是同一套。
+ */
+export type UiAction =
+  /** 单击、双击、右键都是它：`button` 加 `clicks`。 */
+  | Readonly<{
+      what: "pointer";
+      x: number;
+      y: number;
+      button: "left" | "right" | "middle";
+      clicks: number;
+      /**
+       * 辅助功能树上的节点标识。有它时，落点由驱动在注入前按当时的树重算；
+       * `x` / `y` 不是落点。没有它时仍按坐标点。
+       */
+      node?: string;
+    }>
