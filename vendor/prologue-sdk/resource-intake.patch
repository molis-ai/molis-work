+    const start = (shape = schema) => session.startRun({ protocol: "openai-compatible", model: "configured-model",
+      endpoint: `http://127.0.0.1:${address.port}/v1/chat/completions`, credentialRef,
+      messages: [{ role: "user", text: "return JSON" }], params: { structured: { mode: "local", schema: shape } } });
+    const options = () => ({ signal: AbortSignal.timeout(10_000), maxTextChars: 1000, maxEvents: 100 });
+    const successful = await start();
+    const result = await collectRun(successful, options());
+    expect(result).toMatchObject({ ref: successful.ref, state: "completed", text, reportedModels: ["reported-model"], usage: [{ input: { source: "reported", tokens: 12 }, output: { source: "reported", tokens: 3 } }] });
+    expect(await collectRun(successful, options())).toEqual(result);
+    expect(requests).toBe(1);
+    text = '{"title":""}';
+    const invalid = await start(), failed = await collectRun(invalid, options());
+    expect(invalid.state).toBe("failed");
+    expect(failed.terminal).toMatchObject({ type: "failed", error: { code: "MODEL_STRUCTURED_INVALID" } });
+    expect(failed.usage).toHaveLength(1);
+    expect(requests).toBe(2);
+    await expect(start({ type: "string", pattern: "secret" } as unknown as JsonSchema)).rejects.toMatchObject({ code: "MODEL_STRUCTURED_UNSUPPORTED" });
+    expect(requests).toBe(2);
+    hold = true;
