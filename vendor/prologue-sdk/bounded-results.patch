+import { mkdtemp, rm } from "node:fs/promises";
+import { createServer } from "node:http";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { expect, it } from "vitest";
+import { collectRun, createRuntime, type JsonSchema } from "../src/index.js";
+import { createNodeHost } from "../src/node.js";
+
+it("real Node Host validates local structured output before terminal publication, keeps receipts and cancels the original request", async () => {
+  const home = await mkdtemp(join(tmpdir(), "prologue-collected-"));
+  let text = '{"title":"ok"}', requests = 0, hold = false;
+  const entered = Promise.withResolvers<void>();
+  const server = createServer(async (request, response) => {
+    for await (const _ of request) { /* consume request */ }
+    requests++;
+    if (hold) { entered.resolve(); return; }
+    response.writeHead(200, { "content-type": "text/event-stream" });
+    response.end(`data: ${JSON.stringify({ model: "reported-model", choices: [{ index: 0, delta: { content: text }, finish_reason: null }] })}\n\n` +
+      `data: ${JSON.stringify({ choices: [{ index: 0, delta: {}, finish_reason: "stop" }], usage: { prompt_tokens: 12, completion_tokens: 3 } })}\n\ndata: [DONE]\n\n`);
+  });
+  await new Promise<void>(resolve => server.listen(0, "127.0.0.1", resolve));
+  const address = server.address(); if (!address || typeof address === "string") throw new Error("no endpoint");
+  const runtime = await createRuntime({ app: { appId: "prologue.collected", appVersion: "1.0.0" },
+    host: createNodeHost({ storageRoot: home }), network: { model: true, loopback: true } });
+  try {
+    const credentialRef = (await runtime.credentials.write({ label: "fixture", secret: { plaintext: new TextEncoder().encode("synthetic-key") } })).ref;
+    const session = await runtime.sessions.create({ ephemeral: true });
+    const schema: JsonSchema = { type: "object", required: ["title"], properties: { title: { type: "string", minLength: 1 } }, additionalProperties: false };
+    const start = (shape = schema) => session.startRun({ protocol: "openai-compatible", model: "configured-model",
+      endpoint: `http://127.0.0.1:${address.port}/v1/chat/completions`, credentialRef,
+      messages: [{ role: "user", text: "return JSON" }], params: { structured: { mode: "local", schema: shape } } });
+    const options = () => ({ signal: AbortSignal.timeout(10_000), maxTextChars: 1000, maxEvents: 100 });
+    const successful = await start();
+    const result = await collectRun(successful, options());
+    expect(result).toMatchObject({ ref: successful.ref, state: "completed", text, reportedModels: ["reported-model"], usage: [{ input: { source: "reported", tokens: 12 }, output: { source: "reported", tokens: 3 } }] });
+    expect(await collectRun(successful, options())).toEqual(result);
+    expect(requests).toBe(1);
+    text = '{"title":""}';
+    const invalid = await start(), failed = await collectRun(invalid, options());
+    expect(invalid.state).toBe("failed");
+    expect(failed.terminal).toMatchObject({ type: "failed", error: { code: "MODEL_STRUCTURED_INVALID" } });
+    expect(failed.usage).toHaveLength(1);
+    expect(requests).toBe(2);
+    await expect(start({ type: "string", pattern: "secret" } as unknown as JsonSchema)).rejects.toMatchObject({ code: "MODEL_STRUCTURED_UNSUPPORTED" });
+    expect(requests).toBe(2);
+    hold = true;
+    const cancelled = await start(), controller = new AbortController();
+    const pending = collectRun(cancelled, { ...options(), signal: controller.signal });
+    const rejection = expect(pending).rejects.toMatchObject({ name: "AbortError" });
+    await entered.promise; controller.abort(); await rejection;
+    await cancelled.cancel();
+    expect(cancelled.state).toBe("cancelled");
+    expect(requests).toBe(3);
+  } finally {
+    await runtime.shutdown(); server.closeAllConnections();
+    await new Promise<void>(resolve => server.close(() => resolve())); await rm(home, { recursive: true, force: true });
+  }
+});
