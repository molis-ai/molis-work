// molis/no-double-cast: a double assertion through `unknown`: `value as unknown as Target`, `(value as unknown) as Target`
// (any number of parentheses) and the angle-bracket form `<Target><unknown>value`. It reports exactly what the earlier
// `as unknown as` counter reported (specs/repository-anti-corruption W1-04). A single `as unknown` and `as any as Target`
// are other things and are not reported here.
language js(typescript);

pattern asserted_to_unknown() {
  or {
    TsAsExpression(ty = TsUnknownType()),
    TsTypeAssertionExpression(ty = TsUnknownType()),
    JsParenthesizedExpression(expression = asserted_to_unknown())
  }
}

or {
  TsAsExpression(expression = asserted_to_unknown()),
  TsTypeAssertionExpression(expression = asserted_to_unknown())
} as $cast where {
  register_diagnostic(
    span = $cast,
    message = "molis/no-double-cast: type the value, narrow it, or validate it instead of asserting through unknown.",
    severity = "error"
  )
}
