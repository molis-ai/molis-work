+import { mkdtempSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+import { createNodeHost } from "../src/node.js";
+import { createRuntime, memoryKeywords, type ModelEvent, type PrologueError, type Runtime } from "../src/index.js";
+import { createMemoryHost } from "../src/testing/api/index.js";
+
+const APP = { appId: "prologue.harness", appVersion: "0.1.0" };
+const SAYS_OK = { turns: [{ frames: ['data: {"choices":[{"delta":{"content":"ok"}}]}\n', "data: [DONE]\n"] }] };
+let root: string;
+
+beforeEach(() => {
+  root = mkdtempSync(join(tmpdir(), "mem-platform-"));
+});
+afterEach(() => {
+  rmSync(root, { recursive: true, force: true });
+});
+
+const onDisk = (): Promise<Runtime> => createRuntime({ app: APP, host: createNodeHost({ storageRoot: root }), preset: "local-agent" });
+const failure = (run: () => Promise<unknown>): Promise<PrologueError> =>
+  run().then(() => { throw new Error("expected a failure"); }, (error: unknown) => error as PrologueError);
+
+describe("记忆条目的结构化信息、暂停与到期", () => {
+  it("**结构化信息随条目落盘；超界或不认识的字段整条不写；暂停与到期的不召回，恢复后又召回**", async () => {
+    const first = await onDisk();
+    const user = { scope: "user" as const, owner: "alice" };
+    const kept = await first.memory.write({ ...user, text: "周报用要点列表", origin: "你说的", meta: {
+      kind: "preference", source: "said", basis: "explicit", approvedBy: { by: "person" },
+      appliesWhen: { task: "写周报时" }, evidence: [{ kind: "said", text: "以后周报都用要点列表" }] } });
+    expect(kept.meta.kind).toBe("preference");
+    expect(kept.createdAtMs).toBeGreaterThan(0);
+    expect((await failure(() => first.memory.write({ ...user, text: "x", origin: "o", meta: { mood: "happy" } as never }))).code).toBe("MEMORY_META_INVALID");
+    expect((await failure(() => first.memory.write({ ...user, text: "x", origin: "o", meta: { evidence: [{ kind: "said", text: "长".repeat(201) }] } }))).code).toBe("MEMORY_META_INVALID");
+    expect((await failure(() => first.memory.write({ ...user, text: "x", origin: "o", meta: { approvedBy: { by: "model" } as never } }))).code).toBe("MEMORY_META_INVALID");
+    const expired = await first.memory.write({ ...user, text: "周报九月底前发给王总", origin: "你说的", meta: { kind: "fact", expiresAtMs: Date.now() - 1000 } });
+    expect(first.memory.recall({ ...user, text: "写周报" }).hits.map((hit) => hit.entry.text)).toEqual(["周报用要点列表"]);
+    expect(first.memory.list(user).map((entry) => entry.ref.id)).toContain(expired.ref.id);
+
+    await first.memory.pause(kept.ref, "用户停用了");
+    expect(first.memory.recall({ ...user, text: "写周报" }).hits).toEqual([]);
+    expect(first.memory.get(kept.ref)?.paused?.reason).toBe("用户停用了");
+    const withMeta = await first.memory.setMeta(kept.ref, { ...kept.meta, kind: "convention" });
+    expect(withMeta.version).toBe(kept.version);
+    await first.shutdown();
+
+    const second = await onDisk();
+    try {
+      await second.memory.hydrate([user]);
+      const back = second.memory.get(kept.ref)!;
+      expect(back.meta.kind).toBe("convention");
+      expect(back.paused?.reason).toBe("用户停用了");
+      await second.memory.resume(kept.ref);
+      expect(second.memory.recall({ ...user, text: "写周报", kinds: ["convention"] }).hits.map((hit) => hit.entry.text)).toEqual(["周报用要点列表"]);
+      expect(second.memory.recall({ ...user, text: "写周报", kinds: ["fact"] }).hits).toEqual([]);
+    } finally {
+      await second.shutdown();
+    }
+  });
+
+  it("**中文按两字切：一句没有空格的话也能召回，回执写明切法**", async () => {
+    const runtime = await onDisk();
+    try {
+      const project = { scope: "project" as const, owner: "p" };
+      await runtime.memory.write({ ...project, text: "北极星指标叫 NSM", origin: "o" });
+      const byText = runtime.memory.recall({ ...project, text: "这周北极星指标怎么样" });
+      expect(byText.segmentation).toBe("cjk-bigram");
+      expect(byText.hits.map((hit) => hit.entry.text)).toEqual(["北极星指标叫 NSM"]);
+      // 旧的做法（按空格切）：整句是一个词，一条也召不回。
+      expect(runtime.memory.recall({ ...project, keywords: ["这周北极星指标怎么样"] }).hits).toEqual([]);
+      expect(memoryKeywords("NSM 这周")).toEqual(["nsm", "这周"]);
+    } finally {
+      await runtime.shutdown();
+    }
+  });
+});
+
+describe("落盘的候选箱", () => {
+  it("**同一句只算一条；人接受时批准者是人，策略晋升时写明规则和版本；重启后候选还在**", async () => {
+    const first = await onDisk();
+    const project = { scope: "project" as const, owner: "p" };
+    const one = await first.memoryCandidates.propose({ ...project, text: "周报先写风险", origin: "工作「周报」", meta: { kind: "convention", basis: "repeated" } });
+    const again = await first.memoryCandidates.propose({ ...project, text: " 周报先写风险 ", origin: "另一处" });
+    expect(again.ref.id).toBe(one.ref.id);
+    // 候选不是记忆：不召回。
+    expect(first.memory.recall({ ...project, text: "写周报" }).hits).toEqual([]);
+    // 候选想自己带批准者：不算数，由候选箱写。
+    const sneaky = await first.memoryCandidates.propose({ ...project, text: "发布前先跑回归", origin: "o", meta: { approvedBy: { by: "person" } } });
+    expect(sneaky.meta.approvedBy).toBeUndefined();
+    const other = await first.memoryCandidates.propose({ ...project, text: "会议纪要当天发", origin: "o" });
+    await first.shutdown();
+
+    const second = await onDisk();
+    try {
+      await second.memoryCandidates.hydrate([project]);
+      await second.memory.hydrate([project]);
+      expect(second.memoryCandidates.list(project).map((item) => item.state)).toEqual(["pending", "pending", "pending"]);
+      const promoted = await second.memoryCandidates.promote(one.ref, { policy: "molis.write-gate", version: 1 });
+      expect(promoted.meta.approvedBy).toEqual({ by: "policy", policy: "molis.write-gate", version: 1 });
+      expect(second.memoryCandidates.get(one.ref)?.state).toBe("promoted");
+      expect(second.memoryCandidates.get(one.ref)?.entry?.id).toBe(promoted.ref.id);
+      const accepted = await second.memoryCandidates.accept(sneaky.ref, { text: "发布前先跑全量回归" });
+      expect(accepted.meta.approvedBy).toEqual({ by: "person" });
+      expect(accepted.text).toBe("发布前先跑全量回归");
+      await second.memoryCandidates.discard(other.ref);
+      expect((await failure(() => second.memoryCandidates.accept(other.ref))).code).toBe("MEMORY_NOT_ACCEPTED");
+      expect((await failure(() => second.memoryCandidates.promote(one.ref, { policy: "x", version: 1 }))).code).toBe("MEMORY_NOT_ACCEPTED");
+    } finally {
+      await second.shutdown();
+    }
+  });
+});
+
+describe("开跑时按引用注入记忆", () => {
+  async function ready() {
+    const runtime = await createRuntime({ app: APP, host: createMemoryHost({ script: SAYS_OK, files: { "a.ts": "export const a = 1;\n" } }),
+      preset: "local-agent", network: { model: true }, posture: { sandbox: "workspace-write" } });
+    const cred = await runtime.credentials.write({ label: "k", secret: { plaintext: new TextEncoder().encode("sk-x") } });
+    const grant = await runtime.workspace.authorize({ path: "/project" });
+    const character = runtime.characters.create({ id: "reader", version: 1, name: "reader", role: "reads", memoryPolicy: { recall: true, write: false } });
+    runtime.characters.publish(character.ref);
+    return { runtime, cred: cred.ref, root: grant.ref, characterRef: character.ref };
+  }
+  const events = (run: { subscribe(listener: (event: ModelEvent) => void): () => void }): Promise<ModelEvent[]> => new Promise((resolve) => {
+    const seen: ModelEvent[] = [];
+    run.subscribe((event) => { seen.push(event); if (event.type === "completed" || event.type === "failed" || event.type === "cancelled") resolve(seen); });
+  });
+
+  it("**点名的才注入，删了、暂停的不注入；放不下的记成没放下；Run 事件只有引用和版本**", async () => {
+    const ctx = await ready();
+    const user = { scope: "user" as const, owner: "alice" };
+    const style = await ctx.runtime.memory.write({ ...user, text: "回答用要点列表", origin: "你说的" });
+    const long = await ctx.runtime.memory.write({ ...user, text: "很长的背景：" + "项目细节".repeat(80), origin: "你说的" });
+    const paused = await ctx.runtime.memory.write({ ...user, text: "已经停用的偏好", origin: "你说的" });
+    await ctx.runtime.memory.pause(paused.ref, "停用");
+    const gone = await ctx.runtime.memory.write({ ...user, text: "删掉的那条", origin: "你说的" });
+    await ctx.runtime.memory.purge(gone.ref);
+    const { pack, run } = await ctx.runtime.startAgentRun({
+      session: await ctx.runtime.sessions.create(), rootRef: ctx.root,
+      start: { protocol: "openai-compatible", endpoint: "https://api.example.com/v1/chat/completions", model: "m", credentialRef: ctx.cred, messages: [{ role: "user", text: "写周报" }] },
+      agent: { idempotencyKey: "m1", mode: "plan", characterRef: ctx.characterRef, memory: { pinned: [style.ref, long.ref, paused.ref, gone.ref], budgetChars: 200 } },
+    });
+    const seen = await events(run);
+    const recalled = pack.items.filter((item) => item.source === "memory-recall");
+    expect(recalled.map((item) => item.text)).toEqual(["回答用要点列表"]);
+    expect(recalled[0]!.origin).toBe(`你说的 [memory:${style.ref.id}@v1]`);
+    const receipt = seen.find((event) => event.type === "memory-recalled");
+    expect(receipt).toEqual({ type: "memory-recalled", method: "pinned", segmentation: "given", injected: [{ id: style.ref.id, version: 1 }],
+      omitted: [{ id: long.ref.id, version: 1 }], unavailable: [paused.ref.id, gone.ref.id] });
+    expect(JSON.stringify(receipt)).not.toContain("回答用要点列表");
+    await ctx.runtime.shutdown();
+  });
+
+  it("**按几个格子召回：个人和本项目都查，别的项目不查；中文按两字切**", async () => {
+    const ctx = await ready();
+    await ctx.runtime.memory.write({ scope: "user", owner: "alice", text: "周报用要点列表", origin: "个人" });
+    await ctx.runtime.memory.write({ scope: "project", owner: "p1", text: "周报先写风险", origin: "项目一" });
+    await ctx.runtime.memory.write({ scope: "project", owner: "p2", text: "周报用表格", origin: "项目二" });
+    const { pack, run } = await ctx.runtime.startAgentRun({
+      session: await ctx.runtime.sessions.create(), rootRef: ctx.root,
+      start: { protocol: "openai-compatible", endpoint: "https://api.example.com/v1/chat/completions", model: "m", credentialRef: ctx.cred, messages: [{ role: "user", text: "帮我写这周的周报" }] },
+      agent: { idempotencyKey: "m2", mode: "plan", characterRef: ctx.characterRef, memory: { scopes: [{ scope: "user", owner: "alice" }, { scope: "project", owner: "p1" }] } },
+    });
+    const seen = await events(run);
+    expect(pack.items.filter((item) => item.source === "memory-recall").map((item) => item.text).sort()).toEqual(["周报先写风险", "周报用要点列表"]);
+    const receipt = seen.find((event) => event.type === "memory-recalled") as Extract<ModelEvent, { type: "memory-recalled" }>;
+    expect(receipt.method).toBe("recall");
+    expect(receipt.segmentation).toBe("cjk-bigram");
+    await ctx.runtime.shutdown();
+  });
+
+  it("**档案不读记忆时，点名也是扩权，直接失败**", async () => {
+    const ctx = await ready();
+    const character = ctx.runtime.characters.create({ id: "silent", version: 1, name: "silent", role: "no memory" });
+    ctx.runtime.characters.publish(character.ref);
+    const kept = await ctx.runtime.memory.write({ scope: "user", owner: "alice", text: "x", origin: "o" });
+    const session = await ctx.runtime.sessions.create();
+    const failed = await failure(() => ctx.runtime.startAgentRun({
+      session, rootRef: ctx.root,
