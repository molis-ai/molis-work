{
  "name": "@molis-ai/molis-work-plugin-schedule",
  "version": "0.0.0",
  "private": true,
  "description": "Protected first-party Schedule conversation tasks, alarm list, and pause.",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./registration": {
      "types": "./dist/registration.d.ts",
      "import": "./dist/registration.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.browser.json && esbuild src/browser/factory.ts --bundle --format=iife --platform=browser --minify --charset=utf8 '--banner:js=(host) => {' --footer:js=} --outfile=dist/schedule-client.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.browser.json"
  },
  "dependencies": {
    "@molis-ai/molis-work-contracts": "workspace:*",
    "@molis-ai/molis-work-plugin-sdk": "workspace:*"
  },
  "molis-work": {
    "path": "plugins/native/schedule",
    "kind": "native-plugin",
    "maturity": "partial",
    "contract": "@molis-ai/molis-work-contracts/platform/plugin",
    "summary": "Protected first-party Schedule alarm list, receipts, and pause.",
    "notResponsibleFor": "Feed/Goal facts, cron expressions, or owner execute implementations.",
    "legacySources": [
      "src/web/render.ts"
    ],
    "migrationGoals": [
      "goal-reorg-f2"
    ],
    "ssot": "docs/SSOT-MATRIX.md",
    "capabilities": [
      "schedule.ui-contribution.v1",
      "schedule.http-routes.v1"
    ],
    "extraWorkspaceDependencies": [
      "@molis-ai/molis-work-plugin-sdk"
    ],
    "extraDependencies": {},
    "registration": "./registration"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
