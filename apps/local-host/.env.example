# One V2 environment for installation login and the selected Home.
MOLIS_WORK_ACCOUNT_CONFIG={"environmentId":"unified-local","environmentKind":"LOCAL","authOrigin":"http://127.0.0.1:8787","productOrigin":"http://127.0.0.1:4207","applicationId":"molis-work-unified-local-app","clientId":"molis-work-unified-local","policyProfile":"unified-account-v2","redirectAllowlist":["http://127.0.0.1:4207/account/callback"],"providerMode":"MOCK","deliveryMode":"MOCK"}
MOLIS_WORK_SYNC_LOCAL=0
