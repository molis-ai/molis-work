+describe("回答被输出上限截断时接着写", () => {
+  const cut = (text: string) => nativeToolFrames({ text, tools: [], stopReason: "max_tokens" });
+  const end = (text: string) => nativeToolFrames({ text, tools: [], stopReason: "end_turn" });
+  const thoughtOut = () => nativeToolFrames({ thinkingParts: [THINK_A], signatureParts: [SIG_A], tools: [], stopReason: "max_tokens" });
+  const written = (seen: readonly ModelEvent[]) =>
+    seen.filter((one) => one.type === "text-delta").map((one) => (one as { text: string }).text).join("");
+  const code = (event: ModelEvent) => (event as { error?: { code?: string } }).error?.code;
+
+  it("截下来的那段留在历史里，续写到写完为止，几段连成一条完整回答", async () => {
+    const probe: MemoryHostPrepareProbe = {};
+    const started = await boot({ probe, turns: [{ frames: cut("第一段，") }, { frames: cut("第二段，") }, { frames: end("写完了。") }] });
+    expect((await started.wait()).type).toBe("completed");
+    expect(written(started.seen)).toBe("第一段，第二段，写完了。");
+    const [, second, third] = probe.bodies ?? [];
+    expect(second).toContain("第一段，");
+    expect(second).toContain("cut off at the output limit");
+    expect(third).toContain("第一段，");
+    expect(third).toContain("第二段，");
+    expect(started.seen.filter((one) => one.type === "model-response-repair" && one.reason === "output-truncated")).toHaveLength(2);
+    await started.runtime.shutdown();
+  });
+
+  it("续写到上界还在被截断：如实失败，不把半截当成完成", async () => {
+    const probe: MemoryHostPrepareProbe = {};
+    const started = await boot({ probe, turns: Array.from({ length: 9 }, (_, index) => ({ frames: cut(`第${index + 1}段，`) })) });
+    const terminal = await started.wait();
+    expect(terminal.type).toBe("failed");
+    expect(code(terminal)).toBe("MODEL_OUTPUT_TRUNCATED");
+    expect(probe.bodies).toHaveLength(9);
+    await started.runtime.shutdown();
+  });
+
+  it("思考用完上限、还没写正文：让它少想一点再答；一直如此就失败，不交空回答", async () => {
+    const recovered: MemoryHostPrepareProbe = {};
+    const once = await boot({ probe: recovered, params: { thinking: "adaptive" }, turns: [{ frames: thoughtOut() }, { frames: end("答案。") }] });
+    expect((await once.wait()).type).toBe("completed");
+    expect(written(once.seen)).toBe("答案。");
+    expect(recovered.bodies?.[1]).toContain("Keep your reasoning shorter");
+    await once.runtime.shutdown();
+
+    const probe: MemoryHostPrepareProbe = {};
+    const started = await boot({ probe, params: { thinking: "adaptive" }, turns: [{ frames: thoughtOut() }, { frames: thoughtOut() }, { frames: thoughtOut() }] });
+    const terminal = await started.wait();
+    expect(terminal.type).toBe("failed");
+    expect(code(terminal)).toBe("MODEL_OUTPUT_TRUNCATED");
+    await started.runtime.shutdown();
