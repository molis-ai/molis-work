+    f.runtime.surfaces.attach(page, { owner: session.ref });
+    const run = watch((await f.runtime.startAgentRun({ session, workspace: "app", start: f.start(), agent: { idempotencyKey: "typed", mode: "build", toolNames: [...APP_MODE_SURFACE_TOOLS] } })).run);
+    const asked = await run.until("awaiting-approval") as Extract<ModelEvent, { type: "awaiting-approval" }>;
+    const pending = f.runtime.effects.pendings.get(asked.pendingRef);
+    const effect = pending?.effectRef ? f.runtime.effects.get(pending.effectRef) : undefined;
+    const review = effect?.proposal.reviewRef;
+    expect(review).toBeDefined();
+    const handle = f.runtime.resources.inspect(review!);
+    const chunk = await f.runtime.resources.readChunk(review!, 0, handle!.byteLength);
+    expect(new TextDecoder().decode(chunk.bytes)).toBe("你好，这是要输入的内容");
+    expect(effect?.proposal.summary).not.toContain("你好");
+    await f.runtime.effects.pendings.answer(asked.pendingRef, { kind: "effect-approval", answer: "allow" }, await f.runtime.readClock());
+    expect((await run.until("terminal")).type).toBe("completed");
