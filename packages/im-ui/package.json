{
  "name": "@molis-ai/molis-work-im-ui",
  "version": "0.0.0",
  "private": true,
  "description": "Shared group conversation and inline Thread UI; no server identity or storage implementation.",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "resources",
    "README.md"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json && esbuild src/browser/entry.ts --bundle --format=iife --platform=browser --target=es2022 --charset=utf8 --minify --legal-comments=none --outfile=dist/im-client.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@molis-ai/molis-work-contracts": "workspace:*",
    "@molis-ai/molis-work-design-system": "workspace:*",
    "@molis-ai/molis-work-plugin-sdk": "workspace:*"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
