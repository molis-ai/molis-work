index 00000000..e85318e6
--- /dev/null
+++ b/crates/prologue-host-tauri/tests/workspace_large_read.rs
@@ -0,0 +1,25 @@
+//! 整读仍然有 64 KiB 的上限；行窗和编辑可以明说要读到 2 MiB。
+
+use std::collections::HashMap;
+use std::fs;
+use std::sync::Mutex;
+
+use prologue_host_tauri::testing::{authorize, read_text, read_text_up_to};
+
+#[test]
+fn a_large_file_reads_only_when_a_larger_limit_is_asked_for() {
+    let dir = std::env::temp_dir().join(format!("prologue-rs-large-read-{}", uuid::Uuid::new_v4()));
+    fs::create_dir_all(&dir).expect("temp dir");
+    fs::write(dir.join("big.css"), format!("{}\n.tail {{ color: red; }}\n", "x".repeat(80 * 1024))).expect("big file");
+    let roots = Mutex::new(HashMap::new());
+    let grant = authorize(dir.to_string_lossy().into_owned(), &roots).expect("authorize");
+
+    assert!(read_text(grant.root_ref.clone(), "big.css".into(), &roots).is_err(), "a plain read keeps the cap");
+    let held = read_text_up_to(grant.root_ref.clone(), "big.css".into(), Some(2 * 1024 * 1024), &roots).expect("larger read");
+    assert!(held.text.ends_with(".tail { color: red; }\n"));
+    // Asking for less than the whole-read cap never lowers it; asking for more than 2 MiB is clamped.
+    assert!(read_text_up_to(grant.root_ref.clone(), "big.css".into(), Some(1), &roots).is_err());
+    fs::write(dir.join("huge.txt"), "y".repeat(3 * 1024 * 1024)).expect("huge file");
+    assert!(read_text_up_to(grant.root_ref, "huge.txt".into(), Some(u64::MAX), &roots).is_err());
+    fs::remove_dir_all(&dir).ok();
+}
