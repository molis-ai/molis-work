+import { createPrologueError, mintRef, type ExactRef } from "../../kernel/core/index.js";
+import { assertMemoryMeta, type MemoryEntry, type MemoryMeta, type MemoryScope, type MemoryStore } from "./memory.js";
+
+/**
+ * 待认可的候选：**落盘、分作用域**，进库只有两条路——人接受，或 App 登记的确定性策略晋升。
+ *
+ * 为什么不是 `ExtractionInbox`：那一份只在进程内存里（重启就没了），不分作用域，接受只能由人点。
+ * App 要“人事后可撤销的自动记住”时，批准者必须是**有版本的规则**，而不是假装人点了接受——
+ * 所以晋升单独一个入口，批准者写在条目上（`meta.approvedBy`）。
+ *
+ * **不另开写入路径**：接受和晋升都经 `MemoryStore.write` 那一个入口。
+ */
+export interface ScopedCandidate {
+  readonly ref: ExactRef<"memory-candidate">;
+  readonly scope: MemoryScope;
+  readonly owner: string;
+  readonly text: string;
+  readonly origin: string;
+  readonly tags: readonly string[];
+  /** 进库时写到条目上的结构化信息（批准者除外，由这一册写）。 */
+  readonly meta: MemoryMeta;
+  readonly state: "pending" | "accepted" | "promoted" | "discarded" | "expired";
+  readonly createdAtMs: number;
+  readonly settledAtMs?: number;
+  /** 进了库的话，是哪一条。 */
+  readonly entry?: ExactRef<"memory">;
+}
+
+export interface StoredCandidate {
+  readonly id: string;
+  readonly scope: MemoryScope;
+  readonly owner: string;
+  readonly text: string;
+  readonly origin: string;
+  readonly tags: readonly string[];
+  readonly meta: MemoryMeta;
+  readonly state: ScopedCandidate["state"];
+  readonly createdAtMs: number;
+  readonly settledAtMs?: number;
+  readonly entryId?: string;
+}
+
+/** 候选怎么落盘。形状同 `MemoryRowStore`，另一张表。 */
+export interface CandidateRowStore {
+  put(input: {
+    readonly scope: { readonly kind: "owner"; readonly id: string };
+    readonly id: string;
+    readonly version: number;
+    readonly shape: number;
+    readonly value: StoredCandidate;
+  }): Promise<unknown>;
+  list(scope: { readonly kind: "owner"; readonly id: string }): Promise<readonly { readonly value: StoredCandidate }[]>;
+  purge(scope: { readonly kind: "owner"; readonly id: string }, id: string, version: number): Promise<void>;
+}
+
+export interface CandidateBox {
+  /** 把落盘的读回来。重启后先调它。 */
+  hydrate(scopes: readonly { readonly scope: MemoryScope; readonly owner: string }[]): Promise<void>;
+  /**
+   * 提一条候选。**同一格子里同一句话只算一条**（空白与大小写不计）：已有未作废的就返回那一条。
+   * 候选**不进召回**——它还不是记忆。
+   */
+  propose(input: {
+    readonly scope: MemoryScope;
+    readonly owner: string;
+    readonly text: string;
+    readonly origin: string;
+    readonly tags?: readonly string[];
+    readonly meta?: MemoryMeta;
+  }): Promise<ScopedCandidate>;
+  get(ref: ExactRef<"memory-candidate">): ScopedCandidate | undefined;
+  list(query: { readonly scope: MemoryScope; readonly owner: string }): readonly ScopedCandidate[];
+  /** 人接受（可以改写正文）。批准者记为人。 */
+  accept(ref: ExactRef<"memory-candidate">, change?: { readonly text?: string }): Promise<MemoryEntry>;
+  /**
+   * App 登记的确定性策略晋升。**不是模型**：调用方是 App 自己的规则代码，名字和版本写进条目的
+   * `meta.approvedBy`，人事后看得见“谁批准的”，也就撤得回。
+   */
+  promote(ref: ExactRef<"memory-candidate">, by: { readonly policy: string; readonly version: number }): Promise<MemoryEntry>;
+  discard(ref: ExactRef<"memory-candidate">): Promise<ScopedCandidate>;
