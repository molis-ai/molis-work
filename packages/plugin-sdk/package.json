{
  "name": "@molis-ai/molis-work-plugin-sdk",
  "version": "0.0.0",
  "private": true,
  "description": "Stable author-facing Plugin APIs, UI extension types, and testing entrypoints.",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./highlight": {
      "types": "./dist/highlight.d.ts",
      "import": "./dist/highlight.js"
    },
    "./rich-text": {
      "types": "./dist/rich-text.d.ts",
      "import": "./dist/rich-text.js"
    },
    "./diff-view": {
      "types": "./dist/diff-view.d.ts",
      "import": "./dist/diff-view.js"
    },
    "./oauth": {
      "types": "./dist/oauth.d.ts",
      "import": "./dist/oauth.js"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "import": "./dist/ui.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./page-globals": {
      "types": "./dist/page-globals.d.ts",
      "import": "./dist/page-globals.js"
    },
    "./whole-units": {
      "types": "./dist/whole-units.d.ts",
      "import": "./dist/whole-units.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@molis-ai/molis-work-contracts": "workspace:*"
  },
  "peerDependencies": {
    "marked": "^18.0.11",
    "sanitize-html": "^2.17.7"
  },
  "peerDependenciesMeta": {
    "marked": {
      "optional": true
    },
    "sanitize-html": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/sanitize-html": "^2.16.1",
    "marked": "^18.0.11",
    "sanitize-html": "^2.17.7"
  }
}
