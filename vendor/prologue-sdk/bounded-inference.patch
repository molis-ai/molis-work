+      expect(run.state).toBe("failed");
+      expect(await session.replay(run.ref)).toContainEqual(expect.objectContaining({ type: "failed", error: expect.objectContaining({ code: "MODEL_NETWORK_FAILED", safeMessage: expect.stringContaining('"model" channel was never allowed') }) }));
+    }
+  } finally { await runtime.shutdown(); }
+});
+
+for (const address of ["127.0.0.1", "::1"]) it(`public Session uses a real HTTP model on ${address}, with cancellation and local replay`, async () => {
+  const storageRoot = mkdtempSync(join(tmpdir(), "prologue-loopback-"));
+  let requests = 0, hold = false;
+  const entered = Promise.withResolvers<void>();
+  const bodies: string[] = [], keys: (string | string[] | undefined)[] = [];
+  const server = createServer(async (request, response) => {
+    let body = ""; for await (const chunk of request) body += chunk;
+    requests++; bodies.push(body); keys.push(request.headers.authorization);
+    if (hold) { entered.resolve(); return; }
+    response.writeHead(200, { "content-type": "text/event-stream" });
+    response.end(`data: ${JSON.stringify({ choices: [{ index: 0, delta: { content: "local result" }, finish_reason: null }] })}\n\ndata: ${JSON.stringify({ choices: [{ index: 0, delta: {}, finish_reason: "stop" }] })}\n\ndata: [DONE]\n\n`);
+  });
+  await new Promise<void>((resolve, reject) => { server.once("error", reject); server.listen(0, address, resolve); });
+  const bound = server.address(); if (!bound || typeof bound === "string") throw new Error("No server address");
+  const endpoint = `http://${address === "::1" ? "[::1]" : address}:${bound.port}/v1/chat/completions`;
+  const { runtime, session, start } = await ready(createNodeHost({ storageRoot }), { model: true, loopback: true });
+  try {
+    runtime.models.register({ ...definition, endpoint });
+    const run = await start(endpoint); await terminal(run);
+    expect(run.state).toBe("completed"); expect(requests).toBe(1);
+    expect(keys).toEqual(["Bearer loopback-fixture-key"]);
+    expect(JSON.parse(bodies[0]!)).toMatchObject({ model: "local-model", messages: [{ role: "user", content: "local evidence" }] });
+    expect(await session.replay(run.ref)).toContainEqual(expect.objectContaining({ type: "text-delta", text: "local result" }));
+    expect(requests).toBe(1);
+    hold = true;
+    const cancelled = await start(endpoint); await entered.promise;
+    await cancelled.cancel(); await terminal(cancelled);
+    expect(cancelled.state).toBe("cancelled"); expect(requests).toBe(2);
+    expect(JSON.stringify(await session.replay(cancelled.ref))).not.toContain("loopback-fixture-key");
+  } finally {
+    await runtime.shutdown(); server.closeAllConnections();
+    await new Promise<void>(resolve => server.close(() => resolve()));
+    rmSync(storageRoot, { recursive: true, force: true });
+  }
+}, 15_000);
