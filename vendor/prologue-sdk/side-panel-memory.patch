+import { mkdtempSync, writeFileSync, readdirSync, rmSync } from "node:fs";
+import { join } from "node:path";
+import { tmpdir } from "node:os";
+import { expect, it } from "vitest";
+import { createRuntime, type Runtime, type ModuleConfig } from "../src/index.js";
+import { createNodeHost } from "../src/node.js";
+
+async function fixture(config: ModuleConfig, run: (f: {
+  runtime: Runtime; root: Parameters<Runtime["beginIntake"]>[0]; directory: string; store: string;
+  hold: (boundary: "stage" | "publish", after?: boolean) => { entered: Promise<void>; release(): void };
+}) => Promise<void>) {
+  const directory = mkdtempSync(join(tmpdir(), "intake-limits-")), store = join(directory, "store");
+  writeFileSync(join(directory, "a.txt"), "aaaa"); writeFileSync(join(directory, "b.txt"), "bbbb");
+  const host = createNodeHost({ storageRoot: store });
+  let gate: { boundary: string; after: boolean; entered: ReturnType<typeof Promise.withResolvers<void>>; release: ReturnType<typeof Promise.withResolvers<void>> } | undefined;
+  const intake = new Proxy(host.intake!, { get(target, key) {
+    if (key === "stage" || key === "publish") return async (input: never) => {
+      const latch = gate?.boundary === key ? gate : undefined;
+      if (latch) {
+        gate = undefined;
+        if (latch.after) { const result = await target[key](input); latch.entered.resolve(); await latch.release.promise; return result; }
+        latch.entered.resolve(); await latch.release.promise;
+      }
+      return target[key](input);
+    };
+    const value = Reflect.get(target, key); return typeof value === "function" ? value.bind(target) : value;
+  } });
+  const runtime = await createRuntime({ app: { appId: "prologue.intake.limits", appVersion: "1.0.0" }, host: { ...host, intake }, preset: "local-agent", config });
+  try {
+    const root = (await runtime.workspace.authorize({ path: directory })).ref;
+    await run({ runtime, root, directory, store, hold: (boundary, after = false) => {
+      const latch = { boundary, after, entered: Promise.withResolvers<void>(), release: Promise.withResolvers<void>() }; gate = latch;
+      return { entered: latch.entered.promise, release: () => latch.release.resolve() };
+    } });
+  } finally { await runtime.shutdown(); rmSync(directory, { recursive: true, force: true }); }
+}
+
+it("intake follows configured publish limits above and below the module default", async () => {
+  await fixture({ resource: { publish: { maxBytes: 9 * 1024 * 1024 }, intake: { maxItemBytes: 10 * 1024 * 1024 } } }, async f => {
+    writeFileSync(join(f.directory, "large.bin"), new Uint8Array(9 * 1024 * 1024));
+    const batch = f.runtime.beginIntake(f.root), item = await batch.add("large.bin");
+    await batch.publish(); expect(f.runtime.resources.inspect(item.ref)?.byteLength).toBe(9 * 1024 * 1024);
+    await f.runtime.resources.revoke(item.ref);
+  });
+  await fixture({ resource: { publish: { maxBytes: 3 }, intake: { maxItemBytes: 10 } } }, async f => {
+    const batch = f.runtime.beginIntake(f.root);
+    await expect(batch.add("a.txt")).rejects.toMatchObject({ code: "RESOURCE_LIMIT_EXCEEDED" });
+    expect(batch.items).toEqual([]); await batch.cancel();
+  });
+});
+
+it("concurrent batches recheck shared capacity after real Host publication and cannot partly publish", async () => fixture({ resource: { publish: { maxBytes: 16, maxTotalBytes: 8 } } }, async f => {
+  const first = f.runtime.beginIntake(f.root); const a = await first.add("a.txt"), b = await first.add("b.txt");
+  const other = f.runtime.beginIntake(f.root); const c = await other.add("a.txt");
+  const latch = f.hold("publish"), pending = first.publish();
+  const rejected = expect(pending).rejects.toMatchObject({ code: "RESOURCE_LIMIT_EXCEEDED" });
+  await latch.entered; await other.publish(); latch.release(); await rejected;
+  expect(first.state).toBe("cancelled"); expect(f.runtime.resources.publishedBytes).toBe(4);
+  expect(f.runtime.resources.inspect(a.ref)).toBeUndefined(); expect(f.runtime.resources.inspect(b.ref)).toBeUndefined();
+  expect(readdirSync(join(f.store, "intake", "published"))).toHaveLength(1);
+  await f.runtime.resources.revoke(c.ref); expect(f.runtime.resources.publishedBytes).toBe(0);
+}));
+
+it("a revoked item cannot cause a partly published batch", async () => fixture({}, async f => {
+  const batch = f.runtime.beginIntake(f.root), a = await batch.add("a.txt"), b = await batch.add("b.txt");
+  const latch = f.hold("publish", true), pending = batch.publish();
+  const rejected = expect(pending).rejects.toBeDefined();
+  await latch.entered; await f.runtime.resources.revoke(b.ref); latch.release(); await rejected;
+  expect(f.runtime.resources.inspect(a.ref)).toBeUndefined(); expect(f.runtime.resources.publishedBytes).toBe(0);
+  expect(readdirSync(join(f.store, "intake", "published"))).toHaveLength(0);
+}));
+
+for (const boundary of ["stage", "publish"] as const) it(`cancel during ${boundary} waits for real I/O and never revives a batch`, async () => fixture({}, async f => {
+  const batch = f.runtime.beginIntake(f.root); if (boundary === "publish") await batch.add("a.txt");
+  const latch = f.hold(boundary), pending = boundary === "stage" ? batch.add("b.txt") : batch.publish();
+  const rejected = expect(pending).rejects.toMatchObject({ code: "RESOURCE_BATCH_FAILED" });
+  await latch.entered;
+  await expect(batch.add("a.txt")).rejects.toMatchObject({ code: "RESOURCE_BATCH_FAILED" });
+  const cancelled = batch.cancel(); latch.release(); await Promise.all([rejected, cancelled]);
+  expect(batch.state).toBe("cancelled"); expect(f.runtime.resources.publishedBytes).toBe(0);
+  expect(readdirSync(join(f.store, "intake", "staged"))).toEqual([]);
+  expect(readdirSync(join(f.store, "intake", "published"))).toEqual([]);
+  for (const item of batch.items) await expect(f.runtime.resources.readChunk(item.ref, 0)).rejects.toBeDefined();
+}));
+
+it("a previously staged memory resource also rechecks capacity consumed by intake", async () => fixture({ resource: { publish: { maxBytes: 8, maxTotalBytes: 4 } } }, async f => {
+  const memory = f.runtime.resources.stage({ mediaKind: "text", byteLength: 4, label: "pending" }); memory.write(new Uint8Array(4));
+  const batch = f.runtime.beginIntake(f.root), item = await batch.add("a.txt"); await batch.publish();
+  expect(() => memory.publish()).toThrowError(expect.objectContaining({ code: "RESOURCE_LIMIT_EXCEEDED" }));
+  await expect(memory.publishDurable()).rejects.toMatchObject({ code: "RESOURCE_LIMIT_EXCEEDED" });
+  expect(f.runtime.resources.publishedBytes).toBe(4);
+  await f.runtime.resources.revoke(item.ref); memory.discard();
+}));
