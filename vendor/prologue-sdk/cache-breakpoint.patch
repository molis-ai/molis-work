+import { unknownUsage, type TypeSafeRequest, type TypeSafeOutcome, type TypeSafeAdapter, type UsageLedger } from "../../model/core/index.js";
+import type { ExactRef } from "../../kernel/core/index.js";
+import type { ModelResponses } from "./model-response.js";
+export interface TypeSafeInput extends TypeSafeRequest {
+  readonly protocol: "typesafe"; readonly endpoint: string; readonly credentialRef: ExactRef<"credential">;
+  readonly timeoutMs?: number; readonly signal?: AbortSignal;
+}
+export interface TypeSafeSurface { evaluate(input: TypeSafeInput): Promise<TypeSafeOutcome> }
+export function createTypeSafeSurface(deps: { responses: ModelResponses; adapter: TypeSafeAdapter; usage: UsageLedger; assertReady(): void; maxResponseBytes: number }): TypeSafeSurface {
+  return { evaluate(input) { return deps.responses.run(input.signal, async signal => {
+    deps.assertReady(); signal.throwIfAborted();
+    const response = await deps.responses.request({ channel: "model", endpoint: input.endpoint, credentialRef: input.credentialRef,
+      authScheme: "bearer", body: deps.adapter.buildBody(input), timeoutMs: input.timeoutMs ?? 30_000, maxResponseBytes: deps.maxResponseBytes }, signal);
+    const result = deps.adapter.readOutcome(new TextDecoder().decode(response.bytes));
+    signal.throwIfAborted();
+    const usage = unknownUsage();
+    const count = (n: unknown) => typeof n === "number" && Number.isFinite(n) && n >= 0 ? { source: "reported" as const, tokens: n } : usage.input;
+    deps.usage.record({ ...usage, input: count(result.usage?.input_tokens), output: count(result.usage?.output_tokens) });
+    return result;
+  }); } };
+}
