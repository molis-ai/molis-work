{
  "application": {
    "identifier": "com.molis.work",
    "productName": "Molis Work",
    "minimumSystemVersion": "13.0"
  },
  "runtime": {
    "nodeVersionFile": ".nvmrc"
  },
  "connectorApplications": {
    "test": {
      "secretPrefix": "OAUTH_APP_",
      "fallbackMapRef": "OAUTH_APPS"
    },
    "release": {
      "secretPrefix": null,
      "fallbackMapRef": null
    }
  },
  "macOS": {
    "machO": [
      "Contents/MacOS/*",
      "Contents/Resources/resources/molis-work-runtime/runtime/*",
      "Contents/Resources/resources/molis-work-runtime/node_modules/**/*.node",
      "Contents/Resources/resources/molis-work-runtime/node_modules/**/*.dylib",
      "Contents/Resources/resources/molis-work-runtime/node_modules/**/native/*/bin/**/*"
    ],
    "secretRefs": {
      "certificate": "APPLE_CERTIFICATE",
      "certificatePassword": "APPLE_CERTIFICATE_PASSWORD",
      "signingIdentity": "APPLE_SIGNING_IDENTITY",
      "teamId": "APPLE_TEAM_ID",
      "appleId": "APPLE_ID",
      "notaryPassword": "APPLE_PASSWORD"
    }
  },
  "profiles": {
    "dev": {
      "accountEnvironment": null,
      "desktopApplication": null,
      "signingIdentity": "-",
      "notarization": "off",
      "entitlements": null,
      "connectors": {
        "brokerOrigin": null,
        "applicationRefs": {},
        "applications": "test"
      },
      "publisherKeyRef": "MOLIS_WORK_DEV_PUBLISHER_KEY_FILE",
      "updateChannel": null,
      "symbolUploadTarget": null,
      "crashReporting": false
    },
    "test": {
      "accountEnvironment": "test",
      "desktopApplication": {
        "identifier": "com.molis.work.test",
        "productName": "Molis Work Test",
        "home": ".molis-work-environments/installed-test"
      },
      "signingIdentity": "-",
      "notarization": "off",
      "entitlements": null,
      "connectors": {
        "brokerOrigin": null,
        "applicationRefs": {},
        "applications": "test"
      },
      "publisherKeyRef": "MOLIS_WORK_TEST_PUBLISHER_KEY_FILE",
      "updateChannel": null,
      "symbolUploadTarget": null,
      "crashReporting": false
    },
    "release": {
      "accountEnvironment": "prod",
      "desktopApplication": null,
      "signingIdentity": null,
      "notarization": null,
      "entitlements": null,
      "connectors": {
        "brokerOrigin": null,
        "applicationRefs": {},
        "applications": null
      },
      "publisherKeyRef": null,
      "updateChannel": null,
      "symbolUploadTarget": null,
      "crashReporting": false
    }
  }
}
