+++ b/packages/sdk/test/model-loopback.live.test.ts
@@ -0,0 +1,112 @@
+import { mkdtempSync, rmSync } from "node:fs";
+import { createServer } from "node:http";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { expect, it } from "vitest";
+import { createRuntime, type NetworkAllowance, type Run } from "../src/index.js";
+import { createNodeHost } from "../src/node.js";
+import { createMemoryHost } from "../src/testing/api/index.js";
+import { checkNetworkTarget } from "../src/host/core/index.js";
+
+const app = { appId: "prologue.loopback", appVersion: "0.1.0" };
+const definition = { name: "Local", protocol: "openai-compatible", model: "local-model", purposes: [], capabilities: { tools: false, structuredOutput: false, promptCache: false } } as const;
+
+function terminal(run: Run): Promise<void> {
+  if (["completed", "failed", "cancelled"].includes(run.state)) return Promise.resolve();
+  return new Promise(resolve => {
+    const stop = run.subscribe(event => {
+      if (["completed", "failed", "cancelled"].includes(event.type)) { stop(); resolve(); }
+    });
+  });
+}
+async function ready(host: Parameters<typeof createRuntime>[0]["host"], network: NetworkAllowance = {}) {
+  const runtime = await createRuntime({ app, host, network });
+  const credential = await runtime.credentials.write({ label: "fixture", secret: { plaintext: new TextEncoder().encode("loopback-fixture-key") } });
+  const session = await runtime.sessions.create();
+  const start = (endpoint: string) => session.startRun({ protocol: definition.protocol, model: definition.model, endpoint, credentialRef: credential.ref, messages: [{ role: "user", text: "local evidence" }] });
+  return { runtime, session, start };
+}
+
+it("catalog and Run reject malformed or non-loopback plaintext endpoints before execution", async () => {
+  const { runtime, session, start } = await ready(createMemoryHost(), { model: true, loopback: true });
+  try {
+    for (const endpoint of ["", "https://", "not-a-url", "file:///tmp/model", "http://api.example.com/v1", "http://localhost.example.com/v1", "http://127.example.com/v1", "http://127.0.0.1.example.com/v1", "http://localhost@api.example.com/v1", "http://192.168.0.1/v1"]) {
+      expect(() => runtime.models.register({ ...definition, endpoint })).toThrow(expect.objectContaining({ code: "RUNTIME_OPTIONS_INVALID" }));
+      await expect(start(endpoint)).rejects.toMatchObject({ code: "RUNTIME_OPTIONS_INVALID" });
+      expect(() => checkNetworkTarget(endpoint, { model: true, loopback: true })).toThrow(expect.objectContaining({ code: "NETWORK_TARGET_DENIED" }));
+    }
+    expect(runtime.models.list()).toHaveLength(0);
+    expect(await session.terminalRuns()).toHaveLength(0);
+  } finally { await runtime.shutdown(); }
+});
+
+it("catalog and Run share normalized local endpoint shapes; registration cannot enable the model channel", async () => {
+  const { runtime, session, start } = await ready(createMemoryHost());
+  try {
+    for (const endpoint of ["http://localhost:11434/v1", "http://model.localhost:11434/v1", "http://127.0.0.1/v1", "http://127.2.3.4/v1", "http://[::1]/v1", "http://[0:0:0:0:0:0:0:1]/v1", "https://api.example.com/v1"]) {
+      const entry = runtime.models.register({ ...definition, endpoint });
+      expect(runtime.models.resolve({ ref: entry.ref }).endpoint).toBe(endpoint);
+      const run = await start(endpoint);
+      await terminal(run);
+      expect(run.state).toBe("failed");
+      expect(await session.replay(run.ref)).toContainEqual(expect.objectContaining({ type: "failed", error: expect.objectContaining({ code: "MODEL_NETWORK_FAILED", safeMessage: expect.stringContaining('"model" channel was never allowed') }) }));
+    }
+  } finally { await runtime.shutdown(); }
+});
+
+for (const address of ["127.0.0.1", "::1"]) it(`public Session uses a real HTTP model on ${address}, with cancellation and local replay`, async () => {
+  const storageRoot = mkdtempSync(join(tmpdir(), "prologue-loopback-"));
+  let requests = 0, hold = false;
+  const entered = Promise.withResolvers<void>();
+  const bodies: string[] = [], keys: (string | string[] | undefined)[] = [];
+  const server = createServer(async (request, response) => {
+    let body = ""; for await (const chunk of request) body += chunk;
+    requests++; bodies.push(body); keys.push(request.headers.authorization);
+    if (hold) { entered.resolve(); return; }
+    response.writeHead(200, { "content-type": "text/event-stream" });
+    response.end(`data: ${JSON.stringify({ choices: [{ index: 0, delta: { content: "local result" }, finish_reason: null }] })}\n\ndata: ${JSON.stringify({ choices: [{ index: 0, delta: {}, finish_reason: "stop" }] })}\n\ndata: [DONE]\n\n`);
+  });
+  await new Promise<void>((resolve, reject) => { server.once("error", reject); server.listen(0, address, resolve); });
+  const bound = server.address(); if (!bound || typeof bound === "string") throw new Error("No server address");
+  const endpoint = `http://${address === "::1" ? "[::1]" : address}:${bound.port}/v1/chat/completions`;
+  const { runtime, session, start } = await ready(createNodeHost({ storageRoot }), { model: true, loopback: true });
+  try {
+    runtime.models.register({ ...definition, endpoint });
+    const run = await start(endpoint); await terminal(run);
+    expect(run.state).toBe("completed"); expect(requests).toBe(1);
+    expect(keys).toEqual(["Bearer loopback-fixture-key"]);
+    expect(JSON.parse(bodies[0]!)).toMatchObject({ model: "local-model", messages: [{ role: "user", content: "local evidence" }] });
+    expect(await session.replay(run.ref)).toContainEqual(expect.objectContaining({ type: "text-delta", text: "local result" }));
+    expect(requests).toBe(1);
+    hold = true;
+    const cancelled = await start(endpoint); await entered.promise;
+    await cancelled.cancel(); await terminal(cancelled);
+    expect(cancelled.state).toBe("cancelled"); expect(requests).toBe(2);
+    expect(JSON.stringify(await session.replay(cancelled.ref))).not.toContain("loopback-fixture-key");
+  } finally {
+    await runtime.shutdown(); server.closeAllConnections();
+    await new Promise<void>(resolve => server.close(() => resolve()));
+    rmSync(storageRoot, { recursive: true, force: true });
+  }
+}, 15_000);
+
+it("real Node Host requires explicit loopback and model grants even for a registered model", async () => {
+  let requests = 0;
+  const server = createServer((_request, response) => { requests++; response.end("unexpected"); });
+  await new Promise<void>(resolve => server.listen(0, "127.0.0.1", resolve));
+  const bound = server.address(); if (!bound || typeof bound === "string") throw new Error("No server address");
+  const endpoint = `http://127.0.0.1:${bound.port}/v1/chat/completions`;
+  try {
+    for (const [network, reason] of [[{}, /model.*channel was never allowed/], [{ model: true }, /explicitly enabled loopback/], [{ loopback: true }, /model.*channel was never allowed/]] as const) {
+      const storageRoot = mkdtempSync(join(tmpdir(), "prologue-loopback-denied-"));
+      const { runtime, session, start } = await ready(createNodeHost({ storageRoot }), network);
+      try {
+        runtime.models.register({ ...definition, endpoint });
+        const run = await start(endpoint); await terminal(run);
+        expect(run.state).toBe("failed");
+        expect(await session.replay(run.ref)).toContainEqual(expect.objectContaining({ type: "failed", error: expect.objectContaining({ code: "MODEL_NETWORK_FAILED", safeMessage: expect.stringMatching(reason) }) }));
+        expect(requests).toBe(0);
+      } finally { await runtime.shutdown(); rmSync(storageRoot, { recursive: true, force: true }); }
+    }
+  } finally { server.closeAllConnections(); await new Promise<void>(resolve => server.close(() => resolve())); }
+});
