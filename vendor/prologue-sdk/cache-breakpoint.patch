+import { expect, it } from "vitest";
+import { createRuntime } from "../src/index.js";
+import { buildAnthropicCompatibleBody } from "../src/model/plugin/anthropic-compatible.js";
+import { createMemoryHost, type MemoryHostPrepareProbe } from "../src/testing/api/index.js";
+
+const app = { appId: "prologue.cache-breakpoint", appVersion: "1.0.0" };
+const answer = [
+  'data: {"type":"content_block_delta","delta":{"type":"text_delta","text":"ok"}}\n',
+  'data: {"type":"message_stop"}\n',
+];
+const decode = (body: Uint8Array) => JSON.parse(new TextDecoder().decode(body)) as {
+  system?: unknown;
+  messages: { role: string; content: unknown }[];
+};
+
+/** 有界文字那条路：一次性会话、一条用户消息、没有系统段。 */
+async function sentBody(promptCache: "off" | "best-effort" | "required", system?: string) {
+  const probe: MemoryHostPrepareProbe = {};
+  const host = createMemoryHost({ script: { frames: answer } }, probe);
+  const runtime = await createRuntime({ app, host, network: { model: true } });
+  const credentialRef = (await runtime.credentials.write({ label: "k", secret: { plaintext: new TextEncoder().encode("synthetic") } })).ref;
+  const session = await runtime.sessions.create({ ephemeral: true });
+  const run = await session.startRun({
+    protocol: "anthropic-compatible", endpoint: "https://api.anthropic.com/v1/messages", model: "m", credentialRef,
+    messages: [...(system === undefined ? [] : [{ role: "system" as const, text: system }]), { role: "user", text: "写一段摘要" }],
+    promptCache,
+  });
+  const outcome = await new Promise<string>((resolve) => {
+    run.subscribe((event) => {
+      if (event.type === "completed" || event.type === "failed" || event.type === "cancelled") resolve(event.type);
+    });
+  });
+  await runtime.shutdown();
+  expect(outcome).toBe("completed");
+  return JSON.parse(probe.bodyText!) as { system?: unknown; messages: { role: string; content: unknown }[] };
+}
+
+it.each(["best-effort", "required"] as const)("没有系统段时 `%s` 把断点挂在用户消息上", async (mode) => {
+  const body = await sentBody(mode);
+  expect(body.system).toBeUndefined();
+  expect(body.messages).toEqual([
+    { role: "user", content: [{ type: "text", text: "写一段摘要", cache_control: { type: "ephemeral" } }] },
+  ]);
+});
+
+it("`off` 档一个缓存字段都不带，正文仍是原来的字符串", async () => {
+  const body = await sentBody("off");
+  expect(JSON.stringify(body)).not.toContain("cache_control");
+  expect(body.messages).toEqual([{ role: "user", content: "写一段摘要" }]);
+});
+
+it("有系统段时断点只在系统段上，用户消息不动", async () => {
+  const body = await sentBody("best-effort", "你是编辑");
+  expect(body.system).toEqual([{ type: "text", text: "你是编辑", cache_control: { type: "ephemeral" } }]);
+  expect(body.messages).toEqual([{ role: "user", content: "写一段摘要" }]);
+});
+
+it("带附件时断点落在正文块上，图片块不带", () => {
+  const body = decode(buildAnthropicCompatibleBody({
+    model: "m",
+    messages: [{ role: "user", text: "看图" }],
+    attachments: [{ placeholder: "@@img@@", mediaType: "image/png" }],
+    cache: { useCache: true },
+  }));
+  expect(body.messages[0]!.content).toEqual([
+    { type: "image", source: { type: "base64", media_type: "image/png", data: "@@img@@" } },
+    { type: "text", text: "看图", cache_control: { type: "ephemeral" } },
+  ]);
+});
+
+it("多轮时只挂最后一条用户消息，前面的不动", () => {
+  const body = decode(buildAnthropicCompatibleBody({
+    model: "m",
+    messages: [{ role: "user", text: "一" }, { role: "assistant", text: "二" }, { role: "user", text: "三" }],
+    cache: { useCache: true },
+  }));
+  expect(body.messages).toEqual([
+    { role: "user", content: "一" },
+    { role: "assistant", content: "二" },
+    { role: "user", content: [{ type: "text", text: "三", cache_control: { type: "ephemeral" } }] },
+  ]);
+});
