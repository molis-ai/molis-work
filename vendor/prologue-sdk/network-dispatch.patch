@@ -0,0 +1,70 @@
+import { AsyncLocalStorage } from "node:async_hooks";
+import { mkdtempSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { expect, it } from "vitest";
+import { createNodeHost } from "../src/node.js";
+import { createRuntime, openMcpHttp, type McpHttpPort } from "../src/index.js";
+import { startMcpHttpServer } from "./fixtures/mcp-http-server.mjs";
+
+async function fixture(guard: () => void | Promise<void>, prepare?: () => Promise<void>) {
+  const root = mkdtempSync(join(tmpdir(), "sdk-network-authority-"));
+  let modelChecks = 0;
+  const host = createNodeHost({ storageRoot: root, beforeNetworkDispatch: guard, beforeModelDispatch: () => { modelChecks++; } });
+  const runtime = await createRuntime({ app: { appId: "prologue.network-authority", appVersion: "1.0.0" }, host, network: { mcp: true, loopback: true } });
+  const server = await startMcpHttpServer();
+  let callHandle: Awaited<ReturnType<typeof host.prepareModelNetwork>> | undefined;
+  const port: McpHttpPort = { prepareModelNetwork: async input => {
+    const handle = await host.prepareModelNetwork(input);
+    if (JSON.parse(new TextDecoder().decode(input.body)).method === "tools/call") { callHandle = handle; await prepare?.(); }
+    return handle;
+  }, executeModelNetwork: input => host.executeModelNetwork(input), cancelModelNetwork: handle => host.cancelModelNetwork(handle), inspectModelNetwork: handle => host.inspectModelNetwork(handle) };
+  const session = await openMcpHttp({ port, spec: { endpoint: `http://127.0.0.1:${server.port}/mcp`, requestTimeoutMs: 5000 }, clientName: "authority-test" });
+  const call = (control?: Parameters<typeof session.request>[1]) => session.request(id => ({ jsonrpc: "2.0", id, method: "tools/call", params: { name: "lookup", arguments: { q: "one" } } }), control);
+  return { call, seen: server.seen, inspect: () => host.inspectModelNetwork(callHandle!), modelChecks: () => modelChecks, async close() {
+    await session.close(); await runtime.shutdown(); server.server.closeAllConnections(); await new Promise<void>(resolve => server.server.close(() => resolve())); rmSync(root, { recursive: true, force: true });
+  } };
+}
+
+it("MCP authority revoked after real preparation prevents dispatch and remains a denial; a fresh authorized call works", async () => {
+  let allowed = true, pause = true;
+  const entered = Promise.withResolvers<void>(), release = Promise.withResolvers<void>();
+  const f = await fixture(() => { if (!allowed) throw new Error("MCP grant withdrawn"); }, async () => { if (pause) { entered.resolve(); await release.promise; } });
+  try {
+    const pending = f.call(), rejected = expect(pending).rejects.toMatchObject({ code: "EFFECT_NOT_AUTHORIZED" });
+    await entered.promise; allowed = false; release.resolve(); await rejected;
+    expect(f.seen.methods.filter(method => method === "tools/call")).toHaveLength(0);
+    expect(await f.inspect()).toMatchObject({ dispatched: false, retryable: false, status: "failed" });
+    allowed = true; pause = false;
+    expect(JSON.stringify(await f.call())).toContain("found it");
+    expect(f.seen.methods.filter(method => method === "tools/call")).toHaveLength(1);
+    expect(f.modelChecks()).toBe(0);
+  } finally { allowed = true; release.resolve(); await f.close(); }
+});
+
+it("cancellation while the final MCP guard waits sends no tool bytes and does not hang on the guard", async () => {
+  let hold = false;
+  const entered = Promise.withResolvers<void>(), release = Promise.withResolvers<void>(), abort = new AbortController();
+  const f = await fixture(async () => { if (hold) { entered.resolve(); await release.promise; } });
+  try {
+    hold = true;
+    const pending = f.call({ signal: abort.signal }), rejected = expect(pending).rejects.toMatchObject({ code: "CANCELLED" });
+    await entered.promise; abort.abort(); await rejected;
+    expect(f.seen.methods.filter(method => method === "tools/call")).toHaveLength(0);
+    expect(await f.inspect()).toMatchObject({ dispatched: false, status: "cancelled" });
+  } finally { hold = false; release.resolve(); await f.close(); }
+});
+
+it("concurrent MCP callers keep separate authority and a denied caller does not contaminate a later call", async () => {
+  const guards = new AsyncLocalStorage<() => void | Promise<void>>();
+  const f = await fixture(async () => { await guards.getStore()?.(); });
+  const entered = Promise.withResolvers<void>(), release = Promise.withResolvers<void>();
+  try {
+    const rejected = expect(guards.run(async () => { entered.resolve(); await release.promise; throw new Error("Only this caller is revoked"); }, () => f.call())).rejects.toMatchObject({ code: "EFFECT_NOT_AUTHORIZED" });
+    await entered.promise;
+    expect(JSON.stringify(await guards.run(() => {}, () => f.call()))).toContain("found it");
+    release.resolve(); await rejected;
+    expect(JSON.stringify(await f.call())).toContain("found it");
+    expect(f.seen.methods.filter(method => method === "tools/call")).toHaveLength(2);
+  } finally { release.resolve(); await f.close(); }
+});
