{
  "name": "@molis-ai/molis-work-plugin-goals",
  "version": "0.0.0",
  "private": true,
  "description": "Protected first-party Goals: navigation, UI, commands, composition, and the Goal and Governance facts it stores.",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contract": {
      "types": "./dist/contract/index.d.ts",
      "import": "./dist/contract/index.js"
    },
    "./module": {
      "types": "./dist/module/index.d.ts",
      "import": "./dist/module/index.js"
    },
    "./governance": {
      "types": "./dist/governance/index.d.ts",
      "import": "./dist/governance/index.js"
    },
    "./page": {
      "types": "./dist/page/index.d.ts",
      "import": "./dist/page/index.js"
    },
    "./registration": {
      "types": "./dist/registration.d.ts",
      "import": "./dist/registration.js"
    }
  },
  "files": [
    "dist",
    "methods",
    "README.md"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@molis-ai/molis-work-contracts": "workspace:*",
    "@molis-ai/molis-work-plugin-sdk": "workspace:*"
  },
  "molis-work": {
    "maturity": "production",
    "capabilities": [
      "goals.event-application.v1",
      "goals.policy-ui.v1",
      "goals.relation-ui.v1",
      "goals.tree-ui.v1",
      "goals.momentum-ui.v1",
      "goals.document-ui.v1",
      "goals.context-ui.v1",
      "goals.planning-ui.v1",
      "goals.status-ui.v1",
      "goals.factors-ui.v1",
      "goals.dialogs-ui.v1",
      "goals.document-routes.v1",
      "goals.command.v1",
      "goals.repository.v1",
      "goals.lifecycle.v1",
      "goals.planning.v1",
      "goals.query.v1",
      "governance.proposals.v1",
      "governance.decisions.v1",
      "governance.event-decisions.v1"
    ],
    "registration": "./registration",
    "extraWorkspaceDependencies": [
      "@molis-ai/molis-work-plugin-sdk"
    ],
    "extraDependencies": {}
  }
}
