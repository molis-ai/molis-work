{
  "name": "@molis-ai/molis-work-service-runtime-host",
  "version": "0.0.0",
  "private": true,
  "description": "Runtime provider discovery, start/resume/stream/interrupt/stop, and technical Receipts.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@molis-ai/molis-work-contracts": "workspace:*",
    "node-pty": "1.1.0"
  },
  "molis-work": {
    "path": "horizontal/runtime-host",
    "kind": "horizontal",
    "maturity": "partial",
    "contract": "@molis-ai/molis-work-contracts/services/runtime-host",
    "migrationGoals": [
      "goal-reorg-f2",
      "goal-reorg-wk2"
    ],
    "ssot": "docs/SSOT-MATRIX.md"
  }
}
