{
  "name": "molis-work-sync-local",
  "main": "build/index.js",
  "compatibility_date": "2026-09-19",
  "workers_dev": false,
  "preview_urls": false,
  "build": {"command": "node build.mjs"},
  "d1_databases": [{"binding":"DB","database_name":"molis-work-sync-local","database_id":"00000000-0000-0000-0000-000000000000","migrations_dir":"migrations"}],
  "vars": {"AUTH_ORIGIN":"http://127.0.0.1:8787","APPLICATION_ID":"configure-molis-work-application-id"}
}
