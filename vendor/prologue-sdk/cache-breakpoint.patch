+  const credentialRef = (await runtime.credentials.write({ label: "fixture", secret: { plaintext: new TextEncoder().encode("synthetic-key") } })).ref;
+  return { runtime, host, seen, origin, credentialRef, async close() { await runtime.shutdown(); server.closeAllConnections(); await new Promise<void>(resolve => server.close(() => resolve())); rmSync(home, { recursive: true, force: true }); } };
+}
+const json = (response: ServerResponse, body: unknown) => { response.writeHead(200, { "content-type": "application/json" }); response.end(JSON.stringify(body)); };
+
+it("OpenAI image bytes and Gemini native parts use one Runtime with real Host auth and resource receipts", async () => {
+  const f = await fixture((request, response) => request.url === "/openai"
+    ? json(response, { data: Array.from({ length: 5 }, (_, i) => i === 4 ? { b64_json: "invalid" } : { b64_json: png.toString("base64") }) })
+    : json(response, { candidates: [{ content: { parts: [{ thought: true, inlineData: { data: "invalid" } }, { inline_data: { data: png.toString("base64"), mime_type: "image/png" } }] } }] }), { model: { images: { maxImages: 4 } } });
+  try {
+    const first = await f.runtime.images.generate({ protocol: "openai-images", endpoint: f.origin + "/openai", model: "image", prompt: "draw", credentialRef: f.credentialRef });
