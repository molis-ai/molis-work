{
  "name": "@molis-ai/molis-work-plugin-alchemist",
  "version": "0.0.0",
  "private": true,
  "description": "First-party Alchemist workbench: turn a direction into comparable idea cards and a decision.",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./registration": {
      "types": "./dist/registration.d.ts",
      "import": "./dist/registration.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json && node tooling/build-studio.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@molis-ai/molis-work-contracts": "workspace:*",
    "@molis-ai/molis-work-plugin-sdk": "workspace:*",
    "@molis-ai/molis-work-storage": "workspace:*",
    "better-sqlite3": "12.8.0",
    "hono": "4.12.32",
    "zod": "4.4.3"
  },
  "molis-work": {
    "maturity": "slice",
    "capabilities": [
      "alchemist.ui-contribution.v1",
      "alchemist.http-routes.v1"
    ],
    "registration": "./registration",
    "extraWorkspaceDependencies": [
      "@molis-ai/molis-work-plugin-sdk",
      "@molis-ai/molis-work-storage"
    ],
    "extraDependencies": {
      "better-sqlite3": "12.8.0",
      "hono": "4.12.32",
      "zod": "4.4.3"
    }
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "vitest": "4.1.10"
  }
}
