{
  "name": "@molis-ai/molis-work-plugin-probe",
  "version": "0.0.0",
  "private": true,
  "description": "Declaration-only probe that walks the built-in plugin lifecycle in a one-off Home (W4-01).",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./registration": {
      "types": "./dist/registration.d.ts",
      "import": "./dist/registration.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@molis-ai/molis-work-contracts": "workspace:*",
    "@molis-ai/molis-work-plugin-sdk": "workspace:*"
  },
  "molis-work": {
    "maturity": "experimental",
    "capabilities": [],
    "registration": "./registration",
    "extraWorkspaceDependencies": [
      "@molis-ai/molis-work-plugin-sdk"
    ],
    "extraDependencies": {}
  }
}
