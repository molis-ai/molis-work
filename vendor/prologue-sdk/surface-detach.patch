-    case "pointer":
-      if (!finite(action.x, action.y)) bad("A pointer action needs finite coordinates.");
-      if (!Number.isInteger(action.clicks) || action.clicks < 1) bad("A pointer action needs a whole number of clicks, at least one.");
-      return;
-    case "hover":
-      if (!finite(action.x, action.y)) bad("A hover needs finite coordinates.");
-      return;
-    case "scroll":
-      if (!finite(action.x, action.y, action.dx, action.dy)) bad("A scroll needs finite coordinates and amounts.");
-      if (action.dx === 0 && action.dy === 0) bad("A scroll needs a nonzero amount.");
-      return;
-    case "drag":
-      if (!finite(action.x, action.y, action.toX, action.toY)) bad("A drag needs finite coordinates for both ends.");
