+      assertMemoryMeta(meta);
+      const existing = [...held.values()].find((row) => row.scope === request.scope && row.owner === request.owner && row.state !== "expired" && same(row.text) === same(request.text));
+      if (existing !== undefined) return view(existing);
+      const row: StoredCandidate = { id: input.newId(), scope: request.scope, owner: request.owner, text: request.text, origin: request.origin,
+        tags: [...(request.tags ?? [])], meta, state: "pending", createdAtMs: await clock() };
+      await save(row);
+      return view(row);
+    },
+
+    get(ref): ScopedCandidate | undefined {
+      const row = held.get(ref.id);
+      return row === undefined ? undefined : view(row);
+    },
+
+    list(query): readonly ScopedCandidate[] {
+      return Object.freeze([...held.values()].filter((row) => row.scope === query.scope && row.owner === query.owner).map(view));
+    },
+
+    async accept(ref, change = {}): Promise<MemoryEntry> {
+      const row = pending(ref);
+      const text = change.text?.trim() ? change.text.trim() : row.text;
+      return settle(row, text, { by: "person" }, "accepted");
+    },
+
+    async promote(ref, by): Promise<MemoryEntry> {
+      const row = pending(ref);
+      if (typeof by.policy !== "string" || !by.policy.trim() || !Number.isSafeInteger(by.version) || by.version < 1) {
+        throw createPrologueError("MEMORY_NOT_ACCEPTED", "A promotion names the App's policy and its version.");
+      }
+      return settle(row, row.text, { by: "policy", policy: by.policy, version: by.version }, "promoted");
+    },
+
+    async discard(ref): Promise<ScopedCandidate> {
+      const row = pending(ref);
+      const next: StoredCandidate = { ...row, state: "discarded", settledAtMs: await clock() };
+      await save(next);
+      return view(next);
+    },
+
+    async expire(ref): Promise<ScopedCandidate> {
+      const row = pending(ref);
+      const next: StoredCandidate = { ...row, state: "expired", settledAtMs: await clock() };
+      await save(next);
+      return view(next);
+    },
+
+    async purge(ref): Promise<void> {
+      const row = held.get(ref.id);
+      if (row !== undefined && input.store !== undefined) await input.store.purge(scopeOf(row.scope, row.owner), ref.id, ROW_VERSION);
+      held.delete(ref.id);
+    },
+  };
+}
