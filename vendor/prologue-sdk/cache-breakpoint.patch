+import { createPrologueError } from "../../kernel/core/index.js";
+import type { TypeSafeAdapter, TypeSafeOutcome } from "../core/typesafe.js";
+export const TYPESAFE_SYSTEMONE: TypeSafeAdapter = {
+  buildBody(input) {
+    if (!input.model.trim() || typeof input.state !== "string" || !input.questions || Array.isArray(input.questions) || !Object.keys(input.questions).length) throw createPrologueError("MODEL_REQUEST_INVALID", "A TypeSafe request needs a model, state and native questions.");
+    return new TextEncoder().encode(JSON.stringify({ model: input.model, state: input.state, questions: input.questions }));
+  },
+  readOutcome(raw) {
+    let result: unknown;
+    try { result = JSON.parse(raw); } catch { throw createPrologueError("MODEL_RESPONSE_INVALID", "The judgment response was not JSON."); }
+    if (!result || typeof result !== "object" || !("answers" in result) || !result.answers || typeof result.answers !== "object" || Array.isArray(result.answers)) throw createPrologueError("MODEL_RESPONSE_INVALID", "The judgment response carried no native answers.");
+    return result as TypeSafeOutcome;
+  },
+};
