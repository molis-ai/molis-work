+ *
+ * **桌面驱动一次只对一个应用。** 它有一个目标应用：`scope()` 报它的身份（还没有目标时报
+ * `DESKTOP_NO_APP_SCOPE`），`observe` 只看它自己的窗口，`perform` 只落在它的窗口里。驱动
+ * 的几条义务，这一册判不了屏幕上哪块归谁，所以写在这里：
+ *
+ * - 落点被别的应用的窗口盖着、拖动的任一端不在目标应用里、还没有目标应用就要点——**动手
+ *   之前**抛 `createSurfaceRefusal("outside-target")`。
+ * - `{ what: "app" }`：它要激活的那个应用报出来的身份必须**正好等于** `action.app`；大小写
+ *   或别名对不上就拒，不替模型猜。规则是精确比的，替它猜等于让一个换了大小写的身份绕过
+ *   写好的拒绝。
+ * - `{ what: "navigate" }` 在桌面上由驱动拒；`{ what: "menu" }` 在浏览器上由驱动拒。
+ * - 注入多个事件的动作（拖动、组合键、打字），**每个事件之前**都要再确认人没有接手、屏幕
+ *   没锁；中途发现了就抛 `createSurfaceRefusal(reason, { partial: true })`。
+ */
+export interface UiSurface {
+  readonly kind: SurfaceKind;
+  /** Original in-process authority, checked synchronously at the existing read/write/dispatch fences. Never return a promise. */
+  assertCurrent?(): void;
+  /**
+   * 现在这一页/这一窗是谁。
+   *
+   * 观察时记一次，执行前再问一次；**对不上就不点**。这里要的只是「等
+   * 值」，所以回一个不透明串也成立——**这一册原样比对，不解释它的含
+   * 义，也不把它交出去**。
+   */
+  identity(): Promise<string>;
+  /**
+   * 现在这一页/这一窗**属于谁**。规则按它挑目标。
+   *
+   * **和 `identity()` 是两样东西，两个方向换都错。**
+   *
+   * - 拿 `identity` 当 scope：那个 `?token=` 会跟着策略主体进副作用账
+   *   和审计投影——刚把它从观察记录上挪走，又从这儿漏出去。
+   * - 拿 scope 当 `identity`：origin 在站内跳转时不变，于是
+   *   `?page=1` 和 `?page=2` 算成同一页，而那一下按坐标的点击点到的
+   *   是另一行。
+   *
+   * 所以这个口要的是**粗粒度、有含义、进得了回执**的那一个：
+   *
+   * - 浏览器：**只到 origin**（scheme + host + port）。带路径、查询串
+   *   或片段一律当场拒——那几截正是令牌待的地方。
+   * - 桌面：**稳定的应用身份**。macOS 的 bundle id、Windows 的 AUMID，
+   *   或签名主体加产品名。**不收路径**：按二进制文件在哪儿认应用是
+   *   可伪造的，Codex 那边的 Windows 一支特意按签名主体而不按路径，
+   *   也是这个理由。
+   */
+  scope(): Promise<string>;
+  /** 看一眼。回的是字节，**这一册不解释它的含义**。 */
+  observe(kind: ObservationKind, expected: UiExpectedTarget): Promise<Uint8Array>;
+  /**
+   * 真的动一下。**只在过完那条门之后被叫到。**
+   *
+   * 回 `{ image }` 表示这一步的树不够，附上目标窗口的一张 PNG，下一轮模型调用只在这一步的工具结果里看见它。
+   * 不回、或回 `void`，就是没有图。不是每一步都给图。
+   */
+  perform(action: UiAction, expected: UiExpectedTarget): Promise<void | UiActPicture>;
+  /** 关掉。之后动作次数为零；失败后的显式清理可重试，只清理原目标。成功关闭不再重复调用。 */
+  close(): Promise<void>;
+  /**
+   * 现在能用吗；不能用是哪一种。**可选**——不给就是一直能用（浏览器驱动多半如此）。
+   *
+   * 这一册在**拿字节之前**问一次（排在规则那道门后面）、在**动手之前**和另外几样（开着、新鲜、
+   * 没切过应用、那一页、那一家）一起再问一次——只有这两处碰屏幕；准备不问。一时的「锁着」
+   * 「人在用」不该盖掉一条长期的拒绝。答「不行」时字节数和动作数都是零，理由进回执。答不上来
+   * （抛了、答了闭集外的东西）按 `driver-unavailable` 办。`identity()` / `scope()` 答不上来时
+   * 也可以直接抛一个拒绝说为什么。
+   *
+   * 刚在 App 的窗口里点了「允许」的那一下是人在**交还**电脑，不是人在用——驱动可以等一个有
+   * 界的片刻让输入安静下来再答，而不是把那一下读成 `person-present`。
+   */
+  readiness?(): Promise<UiReadiness>;
+  /**
+   * 这一下做了收不回吗：发送、付款、删除、提交——例如点一个写着「发送」的按钮、按
+   * `cmd+return`。**可选**。准备时、进副作用链之前问；说收不回的那一笔归 `mutate-external`，
+   * 摘要里写着收不回。
+   *
+   * 答不上来（抛了、答得不成形）**按收不回办**：那样多问一次人；直接拒的话，一个时灵时不灵
+   * 的判断器会把整台界面拖成不可用。
+   */
+  assess?(action: UiAction, expected: UiExpectedTarget): Promise<UiAssessment>;
+}
+
+/** Internal shared check for driver authority and the public system-tool constructor's captured guard. */
+export function assertSurfaceAuthority(check: (() => void) | undefined): void {
+  const result: unknown = check?.();
+  if (result !== null && (typeof result === "object" || typeof result === "function") && "then" in result && typeof result.then === "function") {
+    void Promise.resolve(result).catch(() => undefined);
+    throw createPrologueError("UI_TARGET_UNAVAILABLE", "The original interface authority check must be synchronous.");
+  }
+}
+
+export interface UiTarget {
+  readonly ref: ExactRef<"ui-target">;
+  readonly kind: SurfaceKind;
+  readonly open: boolean;
+  /**
+   * 只给这一条会话用的界面。**不给就是这台 Runtime 上谁都看得见。**
+   *
+   * 一个 App 常同时开着几件事：给甲项目开的那一页，乙项目那条会话既不该在
+   * `surface-list` 里看见，也不该拿得到它的观察去点。归属在挂上的那一刻定，
+   * 之后不改。
+   */
+  readonly owner?: ExactRef<"session">;
+}
+
+export interface UiLimits {
+  /** 一次观察新鲜多久。 */
+  readonly observationTtlMs: number;
+  /** 一次观察最多多少字节。超了整份失败，不给半份。 */
+  readonly maxObservationBytes: number;
+}
+
+export const DEFAULT_UI_LIMITS: UiLimits = {
+  observationTtlMs: 10_000,
+  maxObservationBytes: 4 * 1024 * 1024,
+};
+
+/**
+ * 截图怎么办。
+ *
+ * **默认脱敏。** 桌面截图里可能有另一个窗口的密码框、另一个人的邮件。
+ * 没装脱敏器就照实不可用——给一张原图比不给更糟。
+ */
+export type ScreenshotPolicy = "redact" | "allow-raw";
+
+export interface UiControlDeps {
+  readonly chain: EffectChain;
+  readonly store: ResourceStore;
+  readonly newId: () => string;
+  readonly limits?: UiLimits;
+  /** 截图策略。**不给就是脱敏。** */
+  readonly screenshots?: ScreenshotPolicy;
+  /**
+   * 截图脱敏器。**App 或插件提供**——SDK 认不出屏幕上哪一块是密码框。
+   *
+   * 策略是 `redact` 而这个没装：截图**明确不可用**，不是悄悄给原图。
+   */
+  readonly redactScreenshot?: (bytes: Uint8Array) => Promise<Uint8Array>;
+}
+
+export interface UiProposal {
+  readonly effect: Effect;
+  readonly decision: PolicyDecision;
+  /** 绑的是哪一次观察。**这一笔只对那一次有效。** */
+  readonly observationRef: ExactRef<"observation">;
+}
+
+/** 这一步要给模型的一张窗口图。只有树不够时驱动才回它。 */
+export interface UiActPicture {
+  readonly image: Uint8Array;
+}
+
+export interface UiReceipt {
+  readonly effectRef: ExactRef<"effect">;
+  readonly state: EffectState;
+  /** 真的动了几次。**过期、被拒、关掉之后都是零。** */
+  readonly actions: number;
+  readonly why: string | undefined;
+  /**
+   * 驱动说「现在不行」的理由，**机器可读**。不是拒绝就没有这一项。
+   *
+   * 有它的回执永远不是 `completed`；可能已落了一部分的那一笔是 `reconcile-required`。
+   * **不自动重试**——人在用、锁着屏，再试一次也只是再跟人抢一次。
+   */
+  readonly refused?: SurfaceRefusalReason;
+  /**
+   * 这一步之后要给模型的一张 PNG。没有就是这一步不给图。
+   * 字节只活到工具结果把它放进资源；不进事件账正文。
+   */
+  readonly modelImage?: Uint8Array;
+}
+
+export interface UiControl {
+  /** 挂上一台。给了 `owner` 就只归那一条会话。 */
+  attach(surface: UiSurface, options?: { readonly owner?: ExactRef<"session"> }): UiTarget;
+  /** 一次观察看的是哪一台。认不出就是没有。 */
+  targetOfObservation(ref: ExactRef<"observation">): UiTarget | undefined;
+  get(ref: ExactRef<"ui-target">): UiTarget | undefined;
+  list(): readonly UiTarget[];
+  /** Exact original pending effect only. Closed, detached, stale, cancelled or non-awaiting plans return undefined. */
+  reviewTarget(effectRef: ExactRef<"effect">): UiReviewTarget | undefined;
+  /** 看一眼。**正文落进资源库，这里只回引用和时效。** */
+  observe(input: {
+    readonly targetRef: ExactRef<"ui-target">;
+    readonly kind: ObservationKind;
+    readonly nowMs: number;
+    /** This observation only; must synchronously return a boolean. It does not cancel later actions using the observation. */
+    readonly cancelled?: () => boolean;
+  }): Promise<Observation>;
+  /**
+   * 准备一次动作。
+   *
+   * **绑那次观察**，归档过门（改本机 / 人看得见 / 改外部；驱动说收不回的归改外部）。这一步
+   * 目标界面动作次数为零。观察之后切过应用就不准备，抛出来。
+   */
+  prepare(input: {
+    readonly observationRef: ExactRef<"observation">;
+    readonly action: UiAction;
+    readonly now: ClockReading;
+    readonly nowMs: number;
+    /**
+     * 模型那条路上的门：谁在要、能等多久、外层想收多紧，以及**落到等人上时停下来等**。
+     *
+     * 不给就和原来一样——一笔要问的动作准备好就回来，由 App 自己去问、去批、再 perform。
+     * 给了就在这里等到人答复：回来的 `effect` 是答复之后的状态。
+     */
+    readonly gate?: EffectGate;
+    /** 等完之后此刻的墙钟——「观察还新鲜吗」要把等人的这段扣掉。不给就不顺延。 */
+    readonly clockMs?: () => Promise<number>;
+    /** Retained by this exact plan through approval and dispatch; once observed, cancellation cannot be undone. */
+    readonly cancelled?: () => boolean;
+  }): Promise<UiProposal>;
+  /**
+   * 执行。**最多一次**，栅栏在链上。
+   *
+   * 执行前再核：没放弃、目标还开着、观察还新鲜、观察之后没切过应用、驱动现在能用、那一页还是
+   * 那一页、还属于刚才那一家。任何一样对不上，动作次数为零；驱动说不行的，理由在回执的
+   * `refused` 上。
+   */
+  perform(input: {
+    readonly effectRef: ExactRef<"effect">;
+    readonly nowMs: number;
+    /**
+     * 中途放弃。**在向界面动手之前判**。
+     *
+     * 等和执行都可能很久（一次 `wait`、一次慢页面），而这中间人可能
+     * 已经改主意了。判在动手之前：动手之后再判就成了「点完了才说不点」。
+     */
+    readonly cancelled?: () => boolean;
+  }): Promise<UiReceipt>;
+  /** 关掉。**之后这台上的动作次数必须为零。** */
+  close(ref: ExactRef<"ui-target">): Promise<UiTarget>;
+  /** 最终释放：立即移出清单，取消原未派出动作，并清掉观察与计划索引。重复调用安全。 */
+  detach(ref: ExactRef<"ui-target">): Promise<void>;
+}
+
+/**
+ * 界面驱动报错脱敏。
+ *
+ * **和 MCP、数据源那两份故意各写一份**：那两边脱的是服务地址和连接串，
+ * 这边脱的是**地址栏里那一截**——一个带 `?token=` 的 URL 出现在报错里，
+ * 它就跟着回执走了。顺带脱掉本机路径和栈。
+ *
+ * 这一册的整个前提是「屏幕上的东西不可信」，那么驱动说的话也一样。
+ */
+export function redactSurfaceError(raw: unknown): string {
+  const text = typeof raw === "string" ? raw : ((raw as { message?: string })?.message ?? "");
+  return text
+    /*
+     * URL 只留到路径为止。
+     *
+     * 查询串和片段是令牌最常待的地方，而它们对「为什么没点成」这件事
+     * 一点用都没有。
+     */
+    .replace(/(https?:\/\/[^\s?#]*)[?#][^\s]*/gi, "$1[redacted query]")
+    .replace(/(?:\/(?:Users|home|var|tmp|etc|opt|private)\/[^\s"']*|[A-Za-z]:\\[^\s"']*)/g, "[redacted path]")
+    .split("\n")
+    .filter((line) => !/^\s*at\s/.test(line))
+    .join("\n")
+    .slice(0, 300);
+}
+
+/** 哪几种动作归哪一档。**闭集**——归不了类的不该被当成安全的。 */
+export function kindOf(action: UiAction): EffectKind {
+  switch (action.what) {
+    case "pointer":
+    case "key":
+    case "text":
+    case "navigate":
+      // 点、打字、跳页都在改这台机器上的状态，而且人看得见。
+      return "mutate-local";
+    case "scroll":
+      /*
+       * 滚动看起来只是「往下看」，**但它改得了值**：指针底下是一个滑块、一个数字框、一个
+       * 下拉菜单时，滚一下就是改一下；无限滚动的页面滚到底会去拉下一页。归只读或「只是人
+       * 看得见」的话，一条「让它随便看」的规则就把这些也放过去了。
+       */
+      return "mutate-local";
+    case "drag":
+      // 拖动是在搬东西：挪文件、重排、选中一段再拖走。和点击同一档。
+      return "mutate-local";
+    case "menu":
+      // 菜单项什么都可能是：存储、删除、退出。和点击同一档；收不回的那几项由驱动说。
+      return "mutate-local";
+    case "app":
+      /*
+       * 切应用会**启动**一个应用（它开起来就在跑它自己的代码、恢复它自己的窗口），也会把
+       * 人眼前的那个应用换掉。这是在改这台机器的状态，不是「人看得见」那一档。
+       */
+      return "mutate-local";
+    case "hover":
+      /*
+       * 移指针什么都不提交——提交要靠点或按键，那几样各自过门。但**人看得见**：指针在他
+       * 的屏幕上动，悬停菜单和提示会弹出来。和 `wait` 一样它仍然过门，不留一种能不过门的
+       * 动作。
+       */
+      return "user-visible";
+    case "download":
+      // 落到本机磁盘上。和上面几样同一档。
+      return "mutate-local";
+    case "upload":
+      /*
+       * **`mutate-external`，不是 `mutate-local`。**
+       *
+       * 上传是把本机的字节送出这台机器——归本机那一档的话，一条
+       * 「本机随便改」的规则会顺手把外传也放过去，而写规则的人从没
+       * 打算允许这件事。
+       */
+      return "mutate-external";
+    case "wait":
+      /*
+       * 等一会儿什么都不改。
+       *
+       * **但它仍然过门**：`user-visible` 那一档默认也要问，而一个能
+       * 不过门的动作种类，迟早会被拿来当「先等一下再点」的绕行。
+       */
+      return "user-visible";
+  }
+}
+
+/** `void` 是没有图。有图就必须是一张字节，别的形状停在这一步，不改成每步都发图。 */
+export function actPicture(acted: void | UiActPicture): Uint8Array | undefined {
+  if (acted === undefined) return undefined;
+  if (typeof acted === "object" && acted.image instanceof Uint8Array) return acted.image;
+  throw createPrologueError(
+    "RESOURCE_PARSE_FAILED",
+    "This step returned a picture that is not one window image, so nothing was sent on.",
+  );
+}
+
+export function labelOf(action: UiAction): string {
+  switch (action.what) {
+    case "pointer":
+      return action.node === undefined
+        ? `click (${String(action.clicks)}×${action.button}) at ${String(action.x)},${String(action.y)}`
+        : `click node ${action.node} (${String(action.clicks)}×${action.button}); the point is read from the tree at injection`;
+    case "key":
+      return `press ${action.keys.join("+")}`;
+    case "text":
+      // **不放正文。** 要打的字在资源里，摘要里只说有这么一份。
+      return "type text from a resource";
+    case "navigate":
+      return `navigate to ${action.url}`;
+    case "wait":
+      return `wait ${String(action.ms)}ms`;
+    case "upload":
+      /*
+       * **路径写全。** 批准这一笔的人要看见送出去的是哪一个文件——
+       * 「上传一个文件」这句话里没有他要判断的那件事。
+       */
+      return `upload ${action.from.join("/")}`;
+    case "download":
+      return `download to ${action.to.join("/")}`;
+    case "scroll":
+      return `scroll by (${String(action.dx)}, ${String(action.dy)}) points at ${String(action.x)},${String(action.y)}`;
+    case "drag":
+      // **两端都写。** 「拖一下」里没有人要判断的那件事——拖到哪儿去了才是。
+      return `drag from ${String(action.x)},${String(action.y)} to ${String(action.toX)},${String(action.toY)}`;
+    case "hover":
+      return `move the pointer to ${String(action.x)},${String(action.y)}`;
+    case "app":
+      // **写哪一个应用。** 「切换应用」这句话里没有人要判断的那件事。
+      return `switch to application ${action.app} (launching it if needed)`;
+    case "menu":
+      return `choose menu ${action.path.join(" > ")}`;
+  }
+}
+
+/** 菜单路径最多几层、每层最多多长。进摘要和指纹的东西不该是一整篇。 */
+const MAX_MENU_DEPTH = 8;
+const MAX_MENU_TITLE_CHARS = 200;
+
+const finite = (...values: readonly number[]): boolean => values.every((one) => typeof one === "number" && Number.isFinite(one));
+
+/**
+ * 动作本身成不成立。**准备之前当场判**，动作次数为零、链上不留一笔。
+ *
+ * 公开入口上的 App 和工具那条路上的模型都从这里过，所以形状只判这一处——工具那一层另外再
+ * 收一道给模型看的上限。
+ */
+export function assertActionShape(action: UiAction, surface: SurfaceKind): void {
+  const bad = (message: string): never => {
+    throw createPrologueError("UI_ACTION_INVALID", message);
+  };
+  switch (action.what) {
+    case "wait":
+      if (!Number.isFinite(action.ms) || action.ms < 0) bad("A wait needs a non-negative number of milliseconds.");
+      return;
+    case "pointer":
+      if (!finite(action.x, action.y)) bad("A pointer action needs finite coordinates.");
+      if (!Number.isInteger(action.clicks) || action.clicks < 1) bad("A pointer action needs a whole number of clicks, at least one.");
+      return;
+    case "hover":
+      if (!finite(action.x, action.y)) bad("A hover needs finite coordinates.");
+      return;
+    case "scroll":
+      if (!finite(action.x, action.y, action.dx, action.dy)) bad("A scroll needs finite coordinates and amounts.");
+      if (action.dx === 0 && action.dy === 0) bad("A scroll needs a nonzero amount.");
+      return;
+    case "drag":
+      if (!finite(action.x, action.y, action.toX, action.toY)) bad("A drag needs finite coordinates for both ends.");
+      return;
+    case "app":
+      /*
+       * **浏览器上没有这一种。** 它的 scope 是 origin，「切到某个应用」在它上面说不出策略主体；
+       * 交给驱动去拒的话，那一笔已经按一个说不清的主体过过门了。
+       */
+      if (surface !== "desktop") bad("Switching applications is a desktop action; this surface has no applications to switch to.");
+      if (typeof action.app !== "string") bad("An app switch needs the application's identity.");
+      if (action.app === DESKTOP_NO_APP_SCOPE) bad("An app switch needs a real application, not the no-application scope.");
+      // 和桌面 scope 同一种形状、同一处校验：它就是切过去之后的 scope。
+      assertScope("desktop", action.app);
+      return;
+    case "menu":
+      if (
+        !Array.isArray(action.path) ||
+        action.path.length === 0 ||
+        action.path.length > MAX_MENU_DEPTH ||
+        action.path.some(
+          (title) =>
+            typeof title !== "string" ||
+            title.trim().length === 0 ||
+            title.length > MAX_MENU_TITLE_CHARS ||
+            /\p{Cc}/u.test(title),
+        )
+      ) {
+        bad(`A menu choice needs a path of 1 to ${String(MAX_MENU_DEPTH)} nonempty titles of at most ${String(MAX_MENU_TITLE_CHARS)} characters.`);
+      }
+      return;
+    case "upload":
+    case "download": {
+      const carried = action.what === "upload" ? action.from : action.to;
+      if (carried.length === 0) bad("A file action needs a path.");
+      return;
+    }
+    case "key":
+    case "text":
+    case "navigate":
+      return;
+  }
+}
+
+/** 驱动对「现在能用吗」的回答。**答不上来按 `driver-unavailable` 办**——朝关着的方向错。 */
+export async function readinessOf(surface: UiSurface): Promise<UiReadiness> {
+  if (surface.readiness === undefined) return "ready";
+  try {
+    const said: unknown = await surface.readiness();
+    return said === "ready" || (typeof said === "string" && REFUSAL_REASONS.has(said))
+      ? (said as UiReadiness)
+      : "driver-unavailable";
+  } catch (error) {
+    return surfaceRefusalOf(error)?.reason ?? "driver-unavailable";
+  }
+}
+
+/**
+ * 驱动对「这一下做了收不回吗」的回答。**答不上来按收不回办。**
+ *
+ * 朝关着的方向错，但不是直接拒：按收不回办是多问一次人；直接拒的话，一个时灵时不灵的判断
+ * 器会把整台界面拖成不可用，而 App 会因此干脆不装它。
+ */
+export async function assessmentOf(
+  surface: UiSurface,
+  action: UiAction,
+  expected: UiExpectedTarget,
+): Promise<{ readonly irreversible: boolean; readonly why: string | undefined }> {
+  if (surface.assess === undefined) return { irreversible: false, why: undefined };
+  let said: unknown;
+  try {
+    said = await surface.assess(action, expected);
+    expected.assertCurrent();
+  } catch {
+    return { irreversible: true, why: "the driver could not tell whether this can be undone" };
+  }
+  const answer = said as { irreversible?: unknown; why?: unknown } | null | undefined;
+  if (typeof answer !== "object" || answer === null || typeof answer.irreversible !== "boolean") {
+    return { irreversible: true, why: "the driver gave no usable answer about whether this can be undone" };
+  }
+  if (!answer.irreversible) return { irreversible: false, why: undefined };
+  /*
+   * 理由多半是屏幕上的字（按钮上写的「发送」）——**屏幕上的东西不可信**，所以脱一遍、压成
+   * 一行、截短，再进摘要。它只能把这一笔往严里推，推不松。
+   */
+  const why =
+    typeof answer.why === "string" ? redactSurfaceError(answer.why).replace(/\s+/g, " ").trim().slice(0, 120) : "";
+  return { irreversible: true, why: why.length > 0 ? why : undefined };
+}
