+import { mkdirSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from "node:fs";
+import { createServer, type ServerResponse } from "node:http";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { expect, it } from "vitest";
+import { createRuntime, OFFICIAL_CODING_PACK, type CreateRuntimeInput, type ModelEvent, type Run, type ScenarioPack } from "../src/index.js";
+import { createNodeHost } from "../src/node.js";
+
+function end(run: Run) {
+  return new Promise<ModelEvent[]>((resolve, reject) => {
+    const events: ModelEvent[] = [];
+    const timer = setTimeout(() => reject(new Error(`Run did not finish: ${events.map(e => e.type).join(",")}`)), 8000);
+    run.subscribe(event => { events.push(event); if (["completed", "failed", "cancelled"].includes(event.type)) { clearTimeout(timer); resolve(events); } });
+  });
+}
+function say(response: ServerResponse, text = "answered") {
+  response.writeHead(200, { "content-type": "text/event-stream" });
+  response.end(`data: ${JSON.stringify({ model: "provider-model", choices: [{ delta: { content: text } }], usage: { prompt_tokens: 7, completion_tokens: 3 } })}\n\ndata: [DONE]\n\n`);
+}
+function call(response: ServerResponse, name: string, args: object) {
+  response.writeHead(200, { "content-type": "text/event-stream" });
+  response.end(`data: ${JSON.stringify({ usage: { prompt_tokens: 7, completion_tokens: 3 }, choices: [{ delta: { tool_calls: [{ index: 0, id: "c1", type: "function", function: { name, arguments: JSON.stringify(args) } }] } }] })}\n\ndata: [DONE]\n\n`);
+}
+async function fixture(handler: (body: any, response: ServerResponse, turn: number) => void, over: Partial<CreateRuntimeInput> = {}) {
+  const home = mkdtempSync(join(tmpdir(), "prologue-agent-scopes-"));
+  const workspaceCalls: string[] = [];
+  const requests: any[] = [];
+  const turns = new Map<string, number>();
+  const server = createServer(async (request, response) => {
+    let raw = ""; for await (const chunk of request) raw += chunk;
+    const body = JSON.parse(raw); requests.push(body);
+    const turn = turns.get(body.model) ?? 0; turns.set(body.model, turn + 1);
+    handler(body, response, turn);
+  });
+  await new Promise<void>(resolve => server.listen(0, "127.0.0.1", resolve));
+  const address = server.address(); if (!address || typeof address === "string") throw new Error("missing endpoint");
+  let dispatchGuards = 0;
+  const actual = createNodeHost({ storageRoot: join(home, "store"), beforeModelDispatch: async () => { dispatchGuards += 1; } });
+  const methods = new Set(["authorizeRoot", "listDirectory", "searchFiles", "readFile", "readBinary", "writeFile", "applyPatch", "prepareCommand", "runCommand"]);
+  const host = new Proxy(actual, { get(target, key, receiver) { const value = Reflect.get(target, key, receiver); return typeof value !== "function" ? value : (...args: unknown[]) => { if (methods.has(String(key))) workspaceCalls.push(String(key)); return value.apply(target, args); }; } });
+  const runtime = await createRuntime({ app: { appId: "prologue.agent-scopes", appVersion: "1.0.0" }, host, preset: "local-agent",
+    network: { model: true, loopback: true }, posture: { sandbox: "workspace-write" }, permissionMode: { mode: "ask-always" }, ...over });
+  const credentialRef = (await runtime.credentials.write({ label: "test", secret: { plaintext: new TextEncoder().encode("synthetic") } })).ref;
