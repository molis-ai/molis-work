+/**
+ * App 的撤权复核拒绝了这一次派出（授权被收回、Character 被停用）。
+ *
+ * **不是网络失败**：一个字节都没出本机，重发或换备选得到的还是同一个答复。
+ * 报成 `MODEL_NETWORK_FAILED` 会让人去查网络。App 给的原因保留在消息里。
+ */
+function dispatchDenied(error: unknown): PrologueError {
+  const mapped = errorFromUnknown(error);
+  if (mapped.code === "CANCELLED" || mapped.code === "EFFECT_NOT_AUTHORIZED") return mapped;
+  return createPrologueError("EFFECT_NOT_AUTHORIZED", `The App refused this model dispatch before sending: ${mapped.safeMessage}`);
+}
