diff --git a/packages/sdk/src/ui-control/core/control-operations.ts b/packages/sdk/src/ui-control/core/control-operations.ts
new file mode 100644
index 0000000000000000000000000000000000000000..61385b6f1ee0a1ca10f66ffd3acaad3b265ed3fe
--- /dev/null
+++ b/packages/sdk/src/ui-control/core/control-operations.ts
@@ -0,0 +1,376 @@
+import { alwaysDenies, assertScope, isUncertainPolicyCommit } from "../../effect-policy/core/index.js";
+import { createPrologueError, mintRef } from "../../kernel/core/index.js";
+import {
+  actPicture, assertActionShape, assessmentOf, createSurfaceRefusal, DEFAULT_UI_LIMITS,
+  kindOf, labelOf, readinessOf, redactSurfaceError, surfaceRefusalOf,
+  type Observation, type SurfaceRefusalReason, type UiControl, type UiControlDeps, type UiProposal, type UiReceipt,
+} from "./surface.js";
+import { surfaceCancellation, type SurfaceState } from "./control-state.js";
+
+export async function observeSurface(state: SurfaceState, deps: UiControlDeps, { targetRef, kind, nowMs, cancelled }: Parameters<UiControl["observe"]>[0]): Promise<Observation> {
+  const { targetOf, observations } = state;
+  const assertNotCancelled = surfaceCancellation(cancelled);
+  const assertCurrent = (target: Parameters<SurfaceState["assertCurrent"]>[0], epoch: number) => {
+    assertNotCancelled(); state.assertCurrent(target, epoch);
+  };
+  const limits = deps.limits ?? DEFAULT_UI_LIMITS;
+  const policy = deps.screenshots ?? "redact";
+  const target = targetOf(targetRef);
+  if (!target.open) {
+    throw createPrologueError(
+      "UI_TARGET_UNAVAILABLE",
+      "That interface target is closed; there is nothing left to observe.",
+    );
+  }
+  const epoch = target.epoch;
+  assertCurrent(target, epoch);
+  let identity: string;
+  let reported: string;
+  try {
+    identity = await target.surface.identity();
+    assertCurrent(target, epoch);
+    reported = await target.surface.scope();
+    assertCurrent(target, epoch);
+  } catch (error) {
+    // 驱动连「这一窗属于谁」都答不上来时可以直接说为什么（例如辅助进程没在跑）。
+    const refusal = surfaceRefusalOf(error);
+    if (refusal !== undefined) throw createSurfaceRefusal(refusal.reason);
+    throw error;
+  }
+  // **在这一刻定下规则要看的那个值。** 核过形状才收。
+  const scope = assertScope(target.surface.kind, reported);
+  const expected = state.expected(target, epoch, identity, scope, assertNotCancelled);
+  // **看也要过规则——「看得见」和「动得了」是两根轴。**
+  const ruled = deps.chain.evaluate({
+    kind: "safe-read",
+    subject: { what: "surface", surface: target.surface.kind, scope, action: "observe" },
+    summary: `Look at this ${target.surface.kind}.`,
+    inputFingerprint: `ui-observe:${scope}:${kind}`,
+  });
+  if (ruled.reason !== "default-deny" && ruled.outcome !== "allow") {
+    throw createPrologueError(
+      "UI_OBSERVATION_DENIED",
+      ruled.outcome === "ask"
+        ? "A rule asks before looking at this surface, but observing raises no approval; allow it outright or leave it alone."
+        : "A rule forbids looking at this surface; nothing was captured.",
+    );
+  }
+  // **规则过完了才真的看。**
+  // **没脱敏器就连截都不截。**
+  const redact = kind === "screenshot" && policy === "redact" ? deps.redactScreenshot : undefined;
+  if (kind === "screenshot" && policy === "redact" && redact === undefined) {
+    throw createPrologueError(
+      "UI_OBSERVATION_DENIED",
+      "Screenshots are set to be redacted but no redactor is installed; nothing was captured.",
+    );
+  }
+  // **驱动现在能用吗——不能用就一个字节都不拿。**
+  const ready = await readinessOf(target.surface);
+  assertCurrent(target, epoch);
+  if (ready !== "ready") {
+    throw createSurfaceRefusal(ready);
+  }
+  let bytes: Uint8Array;
+  try {
+    bytes = await target.surface.observe(kind, expected);
+    assertCurrent(target, epoch);
+  } catch (error) {
+    /*
+     * 驱动拍到一半发现锁屏了、人接手了：**照原理由报，但用这一册自己的话**——驱动的原话
+     * 里可能有窗口标题和路径。不是拒绝的错误照原样往上走，和原来一样。
+     */
+    const refusal = surfaceRefusalOf(error);
+    if (refusal !== undefined) throw createSurfaceRefusal(refusal.reason);
+    throw error;
+  }
+  if (redact !== undefined) {
+    bytes = await redact(bytes);
+  }
+  assertCurrent(target, epoch);
+  if (bytes.byteLength > limits.maxObservationBytes) {
+    // 超界**整份失败**，不给半份。
+    throw createPrologueError(
+      "UI_OBSERVATION_DENIED",
+      `That observation is ${String(bytes.byteLength)} bytes, over the ${String(limits.maxObservationBytes)}-byte ceiling; nothing was kept.`,
+    );
+  }
+  const ref = mintRef("observation", deps.newId());
+  assertCurrent(target, epoch);
+  const stage = deps.store.stage({
+    mediaKind: kind === "screenshot" ? "binary" : "text",
+    byteLength: bytes.byteLength,
+    label: `${target.surface.kind} ${kind}`,
+  });
+  let body: Observation["body"];
+  try {
+    assertCurrent(target, epoch); stage.write(bytes); assertCurrent(target, epoch);
+    body = stage.publish().ref;
+  } catch (error) { stage.discard(); throw error; }
+  const observation: Observation = {
+    ref, targetRef: target.ref, kind, body, takenAtMs: nowMs, expiresAtMs: nowMs + limits.observationTtlMs,
+  };
+  // 身份原文进内部册子，**不进上面那份记录**。
+  observations.set(observation.ref.id, { observation, target, identity, scope, epoch });
+  return observation;
+}
+
+export async function prepareSurface(state: SurfaceState, deps: UiControlDeps, { observationRef, action, now, nowMs, gate, clockMs, cancelled }: Parameters<UiControl["prepare"]>[0]): Promise<UiProposal> {
+  const { observations, cancelOriginal, planned } = state;
+  const assertNotCancelled = surfaceCancellation(cancelled);
+  const assertCurrent = (target: Parameters<SurfaceState["assertCurrent"]>[0], epoch: number) => {
+    assertNotCancelled(); state.assertCurrent(target, epoch);
+  };
+  const seen = observations.get(observationRef.id);
+  if (seen === undefined) {
+    throw createPrologueError("UI_OBSERVATION_STALE", "There is no such observation.");
+  }
+  if (!seen.target.open) {
+    throw createPrologueError(
+      "UI_TARGET_UNAVAILABLE",
+      "That interface target is closed; nothing was prepared.",
+    );
+  }
+  if (nowMs >= seen.observation.expiresAtMs) {
+    // **过期的观察连提案都不给。**
+    throw createPrologueError(
+      "UI_OBSERVATION_STALE",
+      "That observation has expired; observe again before preparing an action.",
+    );
+  }
+  if (seen.epoch !== seen.target.epoch) {
+    /*
+     * **切过应用之后，之前的观察连提案都不给。** 那一眼看的是另一个应用的窗口，照着它算出
+     * 来的坐标落在现在这个应用的哪儿，谁都说不清。
+     */
+    throw createPrologueError(
+      "UI_OBSERVATION_STALE",
+      "This surface switched applications after that observation; observe again before preparing an action.",
+    );
+  }
+  assertActionShape(action, seen.target.surface.kind);
+  const carried = action.what === "upload" ? action.from : action.what === "download" ? action.to : undefined;
+  if (carried !== undefined) {
+    // **照那张「任何姿态都拒」的表核一遍本机路径。**
+    if (alwaysDenies({ what: "path", segments: carried })) {
+      throw createPrologueError(
+        "UI_ACTION_DENIED",
+        "That path is denied in every posture; nothing was prepared and nothing was transferred.",
+      );
+    }
+  }
+  /*
+   * **准备不问驱动现在能不能用。** 准备不碰屏幕：它只是判这一笔该不该做、把它摆到人面前。
+   * 在这里问的话，一时的「人在用」「锁着」会盖掉一条长期的拒绝——锁屏的时候规则说「别碰
+   * 钥匙串」就再也说不出来了。能不能用在拿字节之前和动手之前问，那两处才碰屏幕。
+   */
+  /*
+   * **做了收不回吗——在进链之前问。** 说收不回的那一笔归 `mutate-external`：一条「这个应用
+   * 里本机改动都不用问」的批准，写的人想的是「可以帮我改改草稿」，不是「可以替我发出去」。
+   */
+  assertCurrent(seen.target, seen.epoch);
+  const assessed = await assessmentOf(seen.target.surface, action, state.expected(seen.target, seen.epoch, seen.identity, seen.scope, assertNotCancelled));
+  assertCurrent(seen.target, seen.epoch);
+  const label = labelOf(action);
+  // **切应用那一笔按要切过去的那个应用判。**
+  const scope = action.what === "app" ? action.app : seen.scope;
+  const fingerprint = `ui:${seen.observation.ref.id}:${label}${action.what === "text" ? `:${action.body.id}` : ""}`;
+  const check = (): void => {
+    assertCurrent(seen.target, seen.epoch);
+    if (seen.target.failedPreparations.has(fingerprint)) throw seen.target.failedPreparations.get(fingerprint);
+  };
+  check();
+  const preparing = deps.chain.prepare(
+    {
+      kind: assessed.irreversible ? "mutate-external" : kindOf(action),
+      // **主体里有「对谁动手」。**
+      subject: {
+        what: "surface",
+        surface: seen.target.surface.kind,
+        scope,
+        action: action.what,
+      },
+      summary: assessed.irreversible
+        ? `On this ${seen.target.surface.kind}: ${label}. IRREVERSIBLE${assessed.why === undefined ? "" : ` (${assessed.why})`}: this cannot be undone.`
+        : `On this ${seen.target.surface.kind}: ${label}.`,
+      // 内容键里有**那一次观察**。
+      inputFingerprint: fingerprint,
+      /*
+       * **要打的字就是这一笔的审查正文。** 批准的人得看见准确要输入什么——摘要里故意不放正文
+       * （它会跟着回执和事件走），所以正文走审查引用，由 App 的审查界面按引用读出来给人看。
+       */
+      ...(action.what === "text" ? { reviewRef: action.body } : {}),
+      ...(gate?.origin === undefined ? {} : { origin: gate.origin }),
+      ...(gate?.approvalTtlMs === undefined ? {} : { approvalTtlMs: gate.approvalTtlMs }),
+    },
+    now,
+    gate?.restrict,
+    check,
+  ).then(async (effect) => {
+    const ref = Object.freeze({ ...effect.ref });
+    let original = seen.target.effects.get(ref.id);
+    if (!original) {
+      original = { ref, plan: { seen, action, waitedMs: 0, assertNotCancelled } };
+      seen.target.effects.set(ref.id, original);
+      if (seen.target.open && !state.ending) planned.set(ref.id, original.plan);
+    }
+    const plan = original.plan, ownsPlan = plan.assertNotCancelled === assertNotCancelled;
+    if (!ownsPlan) check(); // A duplicate's private cancellation never enters the original effect's cleanup catch.
+    try { plan.assertNotCancelled(); state.assertCurrent(plan.seen.target, plan.seen.epoch); if (ownsPlan) check(); }
+    catch (error) { await cancelOriginal(seen.target, original.ref.id); throw error; }
+    if (!ownsPlan) check();
+    // Registration and starting the existing approval notification share the
+    // tracked job's last check. Only the human wait lives outside that job.
+    let approval: Promise<UiProposal["effect"]> | undefined;
+    try { approval = effect.state === "awaiting-approval" ? gate?.awaitApproval?.(effect, now) : undefined; }
+    catch (error) {
+      try { plan.assertNotCancelled(); } catch { await cancelOriginal(seen.target, original.ref.id); }
+      throw error;
+    }
+    void approval?.catch(() => undefined);
+    return { ref: original.ref, plan, approval };
+  }, (error: unknown) => {
+    if (isUncertainPolicyCommit(error)) seen.target.failedPreparations.set(fingerprint, error);
+    throw error;
+  });
+  seen.target.preparing.add(preparing);
+  let ready: Awaited<typeof preparing>;
+  try {
+    ready = await preparing;
+  } finally {
+    seen.target.preparing.delete(preparing);
+  }
+  try {
+    ready.plan.assertNotCancelled();
+    if (ready.approval !== undefined) {
+      await ready.approval; // The callback wakes this call; it cannot choose another effect or invent its state.
+      ready.plan.assertNotCancelled(); assertCurrent(seen.target, seen.epoch);
+      if (clockMs !== undefined) {
+        const waited = Math.max(0, (await clockMs()) - nowMs);
+        ready.plan.assertNotCancelled(); assertCurrent(seen.target, seen.epoch);
+        if (ready.plan.assertNotCancelled === assertNotCancelled) ready.plan.waitedMs = waited;
+      }
+    }
+    check();
+    const effect = deps.chain.get(ready.ref);
+    if (!effect) throw createPrologueError("UI_ACTION_INVALID", "The original interface effect is no longer available.");
+    return { effect, decision: effect.decision, observationRef: seen.observation.ref };
+  } catch (error) {
+    // A predicate does not wake arbitrary approval promises, but once they settle their original effect must close.
+    try { ready.plan.assertNotCancelled(); }
+    catch { await state.cancelAfterPrepare(seen.target, ready.ref.id); }
+    throw error;
+  }
+}
+
+export async function performSurface(state: SurfaceState, deps: UiControlDeps, { effectRef: suppliedRef, nowMs, cancelled }: Parameters<UiControl["perform"]>[0]): Promise<UiReceipt> {
+  const effectRef = Object.freeze({ ...suppliedRef });
+  const { assertCurrent } = state;
+  const held = state.planOf(effectRef);
+  if (held === undefined) {
+    throw createPrologueError("UI_ACTION_INVALID", "That effect was not prepared as an interface action.");
+  }
+  const assertNotCancelled = surfaceCancellation(cancelled);
+  const assertCall = () => { held.assertNotCancelled(); assertNotCancelled(); };
+  let actions = 0;
+  let modelImage: Uint8Array | undefined;
+  /*
+   * 驱动说「现在不行」的理由。**执行前那一问和中途抛出来的都记在这儿**，回执上照实报——
+   * 「人在用」和「失败了」是模型要分开对待的两件事。
+   */
+  let refused: { readonly reason: SurfaceRefusalReason; readonly partial: boolean } | undefined;
+  const current = (): boolean => {
+    try { assertCall(); assertCurrent(held.seen.target, held.seen.epoch); return true; }
+    catch (error) {
+      const refusal = surfaceRefusalOf(error);
+      if (refusal !== undefined) refused = { reason: refusal.reason, partial: false };
+      return false;
+    }
+  };
+  try {
+    const receipt = await deps.chain.dispatch(effectRef, {
+      recheck: async (): Promise<boolean> => {
+        /*
+         * 执行前再核：没放弃、开着、新鲜、没切过应用、驱动能用、那一页、那一家。
+         *
+         * 任何一样对不上就不动手，链会把它标成失败，动作次数为零。
+         */
+        if (!current()) return false;
+        if (nowMs >= held.seen.observation.expiresAtMs + held.waitedMs) {
+          return false;
+        }
+        /*
+         * **驱动现在能用吗。** 准备时问过一次，可那之后人可能等了一分钟才批——这中间他可能
+         * 锁了屏、拿回了鼠标。这一问排在身份和 scope 前面：驱动没在跑的时候那两样也答不上来，
+         * 而「驱动不可用」比「对不上」说得清。
+         */
+        const ready = await readinessOf(held.seen.target.surface);
+        if (!current()) return false;
+        if (ready !== "ready") {
+          refused = { reason: ready, partial: false };
+          return false;
+        }
+        try {
+          if ((await held.seen.target.surface.identity()) !== held.seen.identity) {
+            return false;
+          }
+          if (!current()) return false;
+          // **scope 也再核一遍。**
+          const scope = await held.seen.target.surface.scope();
+          return current() && scope === held.seen.scope;
+        } catch (error) {
+          const refusal = surfaceRefusalOf(error);
+          if (refusal !== undefined) refused = { reason: refusal.reason, partial: false };
+          return false;
+        }
+      },
+      run: async (): Promise<void> => {
+        assertCurrent(held.seen.target, held.seen.epoch);
+        assertCall();
+        if (held.action.what === "app") {
+          /*
+           * **派出切应用就算切过。** 在叫驱动之前加：一次抛了错的切换也可能已经把前台换掉了，
+           * 朝关着的方向错——之前的观察一律不作数，模型再看一眼就是了。
+           */
+          held.seen.target.epoch += 1;
+        }
+        try {
+          const acted = await held.seen.target.surface.perform(held.action, state.expected(held.seen.target, held.seen.target.epoch, held.seen.identity, held.seen.scope, assertCall));
+          modelImage = actPicture(acted);
+        } catch (error) {
+          const refusal = surfaceRefusalOf(error);
+          if (refusal === undefined) throw error;
+          refused = { reason: refusal.reason, partial: refusal.partial };
+          /*
+           * **中途拒、可能已落了一部分的那一笔进对账**：它不是「明确没发生」，也不能「再来
+           * 一次」——拖动按下了一半，再拖一次就是另一件事。一下都没落的就是一次失败。
+           */
+          throw refusal.partial
+            ? createPrologueError(
+                "EFFECT_RECONCILE_REQUIRED",
+                "The surface refused part-way through; part of that action may already have happened.",
+              )
+            : createSurfaceRefusal(refusal.reason);
+        }
+        actions += 1;
+      },
+    });
+    return { effectRef, state: receipt.state, actions, why: undefined, ...(modelImage === undefined ? {} : { modelImage }) };
+  } catch (error) {
+    // 状态**从链上读**。
+    const after = deps.chain.get(effectRef);
+    return {
+      effectRef,
+      state: after?.state ?? "failed",
+      actions,
+      /*
+       * 拒绝用这一册自己的话说（驱动的原话里可能有窗口标题和路径）；别的错误照原来，驱动
+       * 那边说的话**脱一遍再走**——它可能带着地址栏和本机路径。
+       */
+      why:
+        refused === undefined
+          ? redactSurfaceError(error)
+          : createSurfaceRefusal(refused.reason, { partial: refused.partial }).safeMessage,
+      ...(refused === undefined ? {} : { refused: refused.reason }),
+    };
+  }
+}
