diff --git a/packages/sdk/test/ui-surface-detach.live.test.ts b/packages/sdk/test/ui-surface-detach.live.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..472da41ec2e05eabe3da8bf2a1143b3cd255a199
--- /dev/null
+++ b/packages/sdk/test/ui-surface-detach.live.test.ts
@@ -0,0 +1,668 @@
+import { mkdtemp, rm } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { afterEach, describe, expect, it, vi } from "vitest";
+import {
+  createPrologueError,
+  createRuntime,
+  createSystemToolRunner,
+  createIgnoreRules,
+  createSurfaceRefusal,
+  createUiControl,
+  type Effect,
+  type EffectProposal,
+  type UiAction,
+  type UiControlDeps,
+  type UiSurface,
+} from "../src/index.js";
+import { createNodeHost } from "../src/node.js";
+import { createMemoryHost } from "../src/testing/api/index.js";
+
+const APP = { appId: "prologue.surface-detach", appVersion: "0.1.0" };
+const CLICK: UiAction = { what: "pointer", x: 10, y: 20, button: "left", clicks: 1 };
+const BYTES = new TextEncoder().encode("orders");
+const shutdowns: (() => Promise<unknown>)[] = [];
+afterEach(async () => {
+  vi.restoreAllMocks();
+  for (const shutdown of shutdowns.splice(0).reverse()) await shutdown();
+});
+
+function latch() {
+  let release!: () => void;
+  const wait = new Promise<void>((resolve) => { release = resolve; });
+  return { wait, release };
+}
+
+function surface(over: Partial<UiSurface> = {}): UiSurface {
+  return {
+    kind: "browser",
+    identity: async () => "orders-tab-1",
+    scope: async () => "https://example.com",
+    observe: async () => BYTES,
+    perform: async () => undefined,
+    close: async () => undefined,
+    ...over,
+  };
+}
+
+async function rig(options: {
+  driver?: UiSurface;
+  ask?: boolean;
+  host?: ReturnType<typeof createNodeHost>;
+  redactScreenshot?: UiControlDeps["redactScreenshot"];
+} = {}) {
+  const host = options.host ?? createMemoryHost();
+  const runtime = await createRuntime({
+    app: APP,
+    host,
+    rules: [
+      { source: "user", effect: "allow", match: { what: "surface", action: "observe" } },
+      { source: "user", effect: options.ask ? "ask" : "allow", match: { what: "surface", action: "pointer" } },
+    ],
+  });
+  const cleanup = () => runtime.shutdown();
+  shutdowns.push(cleanup);
+  let ids = 0;
+  const control = createUiControl({
+    chain: runtime.effects,
+    store: runtime.resources,
+    newId: () => `ui-${++ids}`,
+    ...(options.redactScreenshot === undefined ? {} : { redactScreenshot: options.redactScreenshot }),
+  });
+  const target = control.attach(options.driver ?? surface());
+  const now = await runtime.readClock();
+  const observe = () => control.observe({ targetRef: target.ref, kind: "dom", nowMs: 0 });
+  const prepare = async () => control.prepare({ observationRef: (await observe()).ref, action: CLICK, now, nowMs: 1 });
+  return { host, runtime, control, target, now, observe, prepare, cleanup };
+}
+
+describe("UID-01 / UID-02: final Surface lifetime", () => {
+  it("rejects already revoked authority before reading identity or assessing a new action", async () => {
+    let current = true;
+    const identity = vi.fn(async () => "original"), assess = vi.fn(async () => ({ irreversible: false }));
+    const kit = await rig({ driver: surface({ kind: "desktop", scope: async () => "com.example.Notes", identity, assess,
+      assertCurrent() { if (!current) throw createPrologueError("UI_TARGET_UNAVAILABLE", "Original authority revoked."); },
+    }) });
+    const seen = await kit.observe(); identity.mockClear(); current = false;
+    await expect(kit.observe()).rejects.toMatchObject({ code: "UI_TARGET_UNAVAILABLE" });
+    await expect(kit.control.prepare({ observationRef: seen.ref, action: CLICK, now: kit.now, nowMs: 1 })).rejects.toMatchObject({ code: "UI_TARGET_UNAVAILABLE" });
+    expect(identity).not.toHaveBeenCalled(); expect(assess).not.toHaveBeenCalled();
+    expect((await kit.runtime.effects.readRecovery()).effects).toEqual([]);
+  });
+
+  it("stops execution prechecks at revoked authority before reading the next identity", async () => {
+    let current = true;
+    const identity = vi.fn(async () => "original"), perform = vi.fn(async () => undefined);
+    const driver = surface({ identity, perform, assertCurrent() { if (!current) throw createPrologueError("UI_TARGET_UNAVAILABLE", "Original authority revoked."); } });
+    const kit = await rig({ driver });
+    const proposal = await kit.prepare(); identity.mockClear();
+    const entered = latch(), resume = latch();
+    driver.readiness = async () => { entered.release(); await resume.wait; return "ready"; };
+    const acting = kit.control.perform({ effectRef: proposal.effect.ref, nowMs: 2 });
+    await entered.wait; current = false; resume.release();
+    expect((await acting).actions).toBe(0);
+    expect(identity).not.toHaveBeenCalled(); expect(perform).not.toHaveBeenCalled();
+    expect(kit.runtime.effects.get(proposal.effect.ref)?.state).toBe("failed");
+  });
+  it("keeps close queryable, removes detached indexes immediately, shares one close, then accepts a new target", async () => {
+    const closing = latch();
+    const close = vi.fn(() => closing.wait);
+    const kit = await rig({ driver: surface({ close }) });
+    const seen = await kit.observe();
+    const proposal = await kit.control.prepare({ observationRef: seen.ref, action: CLICK, now: kit.now, nowMs: 1 });
+    const firstClose = kit.control.close(kit.target.ref);
+    expect(kit.control.get(kit.target.ref)?.open).toBe(false);
+    expect(kit.control.list()).toHaveLength(1);
+    const detached = kit.control.detach(kit.target.ref);
+    const again = kit.control.detach(kit.target.ref);
+    expect(kit.control.get(kit.target.ref)).toBeUndefined();
+    expect(kit.control.list()).toEqual([]);
+    expect(kit.control.targetOfObservation(seen.ref)).toBeUndefined();
+    await expect(kit.control.perform({ effectRef: proposal.effect.ref, nowMs: 2 })).rejects.toMatchObject({ code: "UI_ACTION_INVALID" });
+    closing.release();
+    expect((await firstClose).open).toBe(false);
+    await Promise.all([detached, again, kit.control.detach(kit.target.ref)]);
+    expect(close).toHaveBeenCalledTimes(1);
+    expect(kit.runtime.effects.get(proposal.effect.ref)?.state).toBe("cancelled");
+    const act = vi.fn(async () => undefined);
+    const next = kit.control.attach(surface({ perform: act }));
+    const nextSeen = await kit.control.observe({ targetRef: next.ref, kind: "dom", nowMs: 3 });
+    const nextPlan = await kit.control.prepare({ observationRef: nextSeen.ref, action: CLICK, now: kit.now, nowMs: 4 });
+    expect(await kit.control.perform({ effectRef: nextPlan.effect.ref, nowMs: 5 })).toMatchObject({ state: "completed", actions: 1 });
+    expect(act).toHaveBeenCalledTimes(1);
+    await expect(kit.control.prepare({ observationRef: seen.ref, action: CLICK, now: kit.now, nowMs: 6 })).rejects.toMatchObject({ code: "UI_OBSERVATION_STALE" });
+  });
+
+  it.each(["identity", "scope", "readiness", "observe", "redact"] as const)("refuses observation after detach during %s and publishes no resource", async (step) => {
+    const entered = latch();
+    const resume = latch();
+    const pause = async <T>(value: T): Promise<T> => { entered.release(); await resume.wait; return value; };
+    const capture = vi.fn(async () => step === "observe" ? pause(BYTES) : BYTES);
+    const kit = await rig({
+      driver: surface({
+        identity: async () => step === "identity" ? pause("orders-tab-1") : "orders-tab-1",
+        scope: async () => step === "scope" ? pause("https://example.com") : "https://example.com",
+        readiness: async () => step === "readiness" ? pause("ready" as const) : "ready",
+        observe: capture,
+      }),
+      ...(step === "redact" ? { redactScreenshot: () => pause(BYTES) } : {}),
+    });
+    const publish = vi.spyOn(kit.runtime.resources, "stage");
+    const observing = kit.control.observe({ targetRef: kit.target.ref, kind: step === "redact" ? "screenshot" : "dom", nowMs: 0 });
+    const refused = expect(observing).rejects.toMatchObject({ code: "UI_TARGET_UNAVAILABLE" });
+    await entered.wait;
+    await kit.control.detach(kit.target.ref);
+    resume.release();
+    await refused;
+    expect(publish).not.toHaveBeenCalled();
+    expect(capture).toHaveBeenCalledTimes(step === "redact" || step === "observe" ? 1 : 0);
+  });
+
+  it.each(["close", "detach"] as const)("does not prepare an Effect after %s during assess", async (end) => {
+    const entered = latch();
+    const resume = latch();
+    const kit = await rig({ driver: surface({ assess: async () => { entered.release(); await resume.wait; return { irreversible: false }; } }) });
+    const preparing = kit.prepare();
+    const refused = expect(preparing).rejects.toMatchObject({ code: "UI_TARGET_UNAVAILABLE" });
+    await entered.wait;
+    await kit.control[end](kit.target.ref);
+    resume.release();
+    await refused;
+    expect((await kit.runtime.effects.readRecovery()).effects).toEqual([]);
+  });
+
+  it("joins detach-first close and permits an explicit retry after a failed driver close", async () => {
+    const resume = latch();
+    const close = vi.fn(async (): Promise<void> => { await resume.wait; throw createPrologueError("UI_TARGET_UNAVAILABLE", "Driver cleanup failed."); });
+    const kit = await rig({ driver: surface({ close }) });
+    const detached = expect(kit.control.detach(kit.target.ref)).rejects.toMatchObject({ code: "UI_TARGET_UNAVAILABLE" });
+    const joined = expect(kit.control.close(kit.target.ref)).rejects.toMatchObject({ code: "UI_TARGET_UNAVAILABLE" });
+    resume.release();
+    await Promise.all([detached, joined]);
+    expect(close).toHaveBeenCalledTimes(1);
+    close.mockResolvedValue(undefined);
+    await kit.control.detach(kit.target.ref);
+    await kit.control.detach(kit.target.ref);
+    expect(close).toHaveBeenCalledTimes(2);
+    expect(kit.control.list()).toEqual([]);
+  });
+
+  it.each(["origin", "conflict"] as const)("a known pre-write %s refusal does not poison later preparation or final cleanup", async (reason) => {
+    const kit = await rig();
+    const seen = await kit.observe();
+    const commit = vi.spyOn(kit.host.storage, "commitBatch");
+    if (reason === "conflict") commit.mockRejectedValueOnce(createPrologueError("STORAGE_CONFLICT", "Another writer won before this write."));
+    await expect(kit.control.prepare({
+      observationRef: seen.ref, action: CLICK, now: kit.now, nowMs: 1,
+      ...(reason === "origin" ? { gate: { origin: { toolCall: "" } } } : {}),
+    })).rejects.toMatchObject({ code: reason === "origin" ? "EFFECT_ORIGIN_INVALID" : "STORAGE_CONFLICT" });
+    expect((await kit.runtime.effects.readRecovery()).effects).toEqual([]);
+    const valid = await kit.control.prepare({ observationRef: seen.ref, action: CLICK, now: kit.now, nowMs: 2 });
+    expect(valid.effect.state).toBe("authorized");
+    await kit.control.detach(kit.target.ref);
+    expect(kit.runtime.effects.get(valid.effect.ref)?.state).toBe("cancelled");
+  });
+});
+
+describe("UID-03: original Pending and dispatch settle", () => {
