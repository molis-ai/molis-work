@@ -0,0 +1,72 @@
+import { createPrologueError, type ExactRef } from "../../kernel/core/index.js";
+import { pathSegments, type EffectChain, type EffectProposal, type EffectScopeAuthority, type PolicyRule } from "../../effect-policy/core/index.js";
+
+/** Trusted App authority for one Run on its already authorized root. Never inherited. */
+export interface AgentRunGrants {
+  readonly toolNames: readonly string[];
+  /** This bounded API accepts [] or ["."]. Authorize a narrower directory as its own root. */
+  readonly paths: readonly string[];
+}
+
+export function freezeAgentGrants(input: AgentRunGrants | undefined): AgentRunGrants | undefined {
+  if (input === undefined) return undefined;
+  if (!Array.isArray(input.toolNames) || !Array.isArray(input.paths) ||
+      input.toolNames.some((name) => typeof name !== "string" || name.length === 0) ||
+      input.paths.some((path) => typeof path !== "string" || path.length === 0 ||
+        path.startsWith("/") || path.includes("\\") || /^[A-Za-z]:/.test(path) || path.split("/").includes(".."))) {
+    throw createPrologueError("AGENT_START_INVALID", "Run grants require explicit tool names and paths inside the authorized root.");
+  }
+  if (input.paths.length > 1 || input.paths.some((path) => path !== ".")) {
+    throw createPrologueError("AGENT_START_INVALID", "Run grants accept only [] or ['.']; authorize a narrower directory as its own root.");
+  }
+  return Object.freeze({ toolNames: Object.freeze([...input.toolNames]), paths: Object.freeze([...input.paths]) });
+}
+
+/** A private facade over the same effect ledger. Origin strings cannot create this authority. */
+export function bindAgentEffects(input: {
+  readonly effects: EffectChain;
+  readonly grants: AgentRunGrants;
+  readonly session: ExactRef<"session">;
+  readonly root: ExactRef<"authorized-root">;
+  readonly runId: () => string | undefined;
+  readonly scopes: WeakMap<object, EffectScopeAuthority>;
+}): { readonly effects: EffectChain; readonly revoke: () => void } {
+  let active = true;
+  let scope: EffectScopeAuthority | undefined;
+  const rules: readonly PolicyRule[] = Object.freeze([
+    ...input.grants.toolNames.map((name): PolicyRule => Object.freeze({ source: "runtime", effect: "approved", match: Object.freeze({ what: "tool", name }) })),
+    ...input.grants.paths.map((path): PolicyRule => Object.freeze({ source: "runtime", effect: "approved", kinds: Object.freeze(["mutate-local"] as const), match: Object.freeze({ what: "path", under: Object.freeze([...pathSegments(path)]) }) })),
+  ]);
+  const authority = (): EffectScopeAuthority => {
+    const run = input.runId();
+    if (!active || run === undefined) throw createPrologueError("EFFECT_NOT_AUTHORIZED", "This Run's trusted grants are no longer active.");
+    scope ??= Object.freeze({ id: JSON.stringify({ session: input.session, run, root: input.root }), rules, active: () => active });
+    return scope;
+  };
+  const sealed = (proposal: EffectProposal): EffectProposal => {
+    const held = authority();
+    const copied = structuredClone(proposal);
+    const subject = copied.subject;
+    if (subject.what === "path" && subject.segments.some((part) => part === ".." || part.includes("/") || part.includes("\\"))) {
+      throw createPrologueError("EFFECT_NOT_AUTHORIZED", "A scoped path must remain inside its authorized root.");
+    }
+    const result: EffectProposal = { ...copied,
+      origin: { ...copied.origin, session: input.session.id, run: input.runId()! },
+      inputFingerprint: `@run-scope:${JSON.stringify([held.id, copied.kind, copied.subject, copied.escalation === true, copied.inputFingerprint])}`,
+    };
+    input.scopes.set(result, held);
+    return result;
+  };
+  const effects = Object.freeze<EffectChain>({ ...input.effects,
+    evaluate: (proposal: EffectProposal) => input.effects.evaluate(sealed(proposal)),
+    restriction: (proposal: EffectProposal) => input.effects.restriction(sealed(proposal)),
+    prepare: (proposal, now, restrict) => input.effects.prepare(sealed(proposal), now, restrict),
+    dispatch: (ref, request) => {
+      const held = authority();
+      const bound = { ...request, recheck: async (effect: Parameters<typeof request.recheck>[0]) => active && await request.recheck(effect) };
+      input.scopes.set(bound, held);
+      return input.effects.dispatch(ref, bound);
+    },
+  });
+  return { effects, revoke: () => { active = false; } };
+}
