+      mode = value;
+      await expect(f.runtime.images.generate({ protocol: value === "mime" ? "gemini" : "openai-images", endpoint: f.origin + "/image", model: "image", prompt: "draw", credentialRef: f.credentialRef })).rejects.toMatchObject({ code: "MODEL_RESPONSE_INVALID" });
+      expect(f.runtime.resources.publishedBytes).toBe(0);
+    }
+  } finally { await f.close(); }
+});
+
+it("multi-megabyte image decoding remains bounded without recursive regular-expression overflow", async () => {
+  const large = Buffer.concat([png, Buffer.alloc(2 * 1024 * 1024)]);
