{
  "name": "@molis-ai/molis-work-plugin-feed",
  "version": "0.0.0",
  "private": true,
  "description": "First-party Feed navigation, UI, disposition, and Module composition.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@molis-ai/molis-work-contracts": "workspace:*",
    "@molis-ai/molis-work-design-system": "workspace:*",
    "marked": "^18.0.11",
    "sanitize-html": "^2.17.7",
    "@adeptify/search-evidence-layer": "file:../../../vendor/search-evidence-layer/adeptify-search-evidence-layer-0.4.1.tgz",
    "@adeptify/intelligence-client": "file:../../../vendor/intelligence-client/adeptify-intelligence-client-0.2.2.tgz"
  },
  "molis-work": {
    "path": "plugins/native/feed",
    "kind": "native-plugin",
    "maturity": "partial",
    "contract": "@molis-ai/molis-work-contracts/platform/plugin",
    "migrationGoals": [
      "goal-reorg-f2",
      "goal-reorg-fd4"
    ],
    "ssot": "docs/SSOT-MATRIX.md",
    "capabilities": [
      "feed.native-plugin.contract.v1",
      "feed.ui-contribution.v1",
      "feed.http-routes.v1"
    ]
  },
  "devDependencies": {
    "@types/sanitize-html": "^2.16.1"
  }
}
