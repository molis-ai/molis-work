{
  "name": "@molis-ai/molis-work-plugin-feed",
  "version": "0.0.0",
  "private": true,
  "description": "First-party Feed navigation, UI, disposition, and Module composition.",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./registration": {
      "types": "./dist/registration.d.ts",
      "import": "./dist/registration.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@molis-ai/molis-work-contracts": "workspace:*",
    "@adeptify/search-evidence-layer": "file:../../../vendor/search-evidence-layer/adeptify-search-evidence-layer-0.4.1.tgz",
    "@adeptify/intelligence-client": "file:../../../vendor/intelligence-client/adeptify-intelligence-client-0.2.2.tgz",
    "@molis-ai/molis-work-plugin-sdk": "workspace:*"
  },
  "molis-work": {
    "path": "plugins/native/feed",
    "kind": "native-plugin",
    "maturity": "slice",
    "contract": "@molis-ai/molis-work-contracts/platform/plugin",
    "summary": "First-party Feed navigation, UI, disposition, and Module composition.",
    "notResponsibleFor": "Source/Signal/Feed/Attention facts or Provider implementations.",
    "legacySources": [
      "src/web/render.ts",
      "apps/desktop/launchers/web/server.ts"
    ],
    "migrationGoals": [
      "goal-reorg-f2",
      "goal-reorg-fd4"
    ],
    "ssot": "docs/SSOT-MATRIX.md",
    "capabilities": [
      "feed.native-plugin.contract.v1",
      "feed.ui-contribution.v1",
      "feed.http-routes.v1"
    ],
    "extraWorkspaceDependencies": [
      "@molis-ai/molis-work-plugin-sdk"
    ],
    "extraDependencies": {
      "@adeptify/intelligence-client": "file:../../../vendor/intelligence-client/adeptify-intelligence-client-0.2.2.tgz",
      "@adeptify/search-evidence-layer": "file:../../../vendor/search-evidence-layer/adeptify-search-evidence-layer-0.4.1.tgz"
    },
    "registration": "./registration"
  }
}
