+  | Readonly<{ what: "text"; body: ExactRef<"resource"> }>
+  | Readonly<{ what: "navigate"; url: string }>
+  | Readonly<{ what: "wait"; ms: number }>
+  /**
+   * 把本机一个文件交给这台界面。**按段存**，和策略里的路径同一种形状。
+   *
+   * 它在闭集里的理由和 `wait` 那条一样，但更要紧：一台能上传的驱动
+   * 要是没有一种**说得出口**的动作，它只会把上传伪装成点一下文件
+   * 选择框——于是这一笔在账上是「点击」，而实际发生的是**把仓库送
+   * 出去**。归 `mutate-external` 也是这个道理。
+   */
