+  | Readonly<{ what: "download"; to: readonly string[] }>
+  /**
+   * **桌面：** 让这台界面以 `app` 这个应用为目标，没开就打开它。`app` 是稳定的应用身份，
+   * 和桌面 scope 同一种形状（macOS 的 bundle id、Windows 的 AUMID……）。
+   *
+   * **这一笔的策略主体按要切过去的那个应用判**，不按眼下这一个——否则一条「别碰钥匙串」的
+   * 规则拦不住「切进钥匙串」，一次对 A 的批准也会顺手放过「切到 B」。切过之后，之前的观察
+   * 一律不作数。
+   *
+   * 浏览器上没有这一种：浏览器的 scope 是 origin，「切到某个应用」在它上面说不出主体，所以
+   * 这一册当场拒，不交给驱动。
+   */
+  | Readonly<{ what: "app"; app: string }>
+  /**
+   * **桌面：** 在目标应用的菜单里按标题路径选一项，例如 `["文件", "导出为 PDF…"]`。
+   * 照标题选，不照坐标点——菜单栏的位置随屏幕和语言变，标题就是人读的那一句。
+   */
+  | Readonly<{ what: "menu"; path: readonly string[] }>;
+
+/**
+ * 驱动说「现在不行」的理由。**闭集**，而且每一种模型该怎么办都不一样。
+ *
+ * - `driver-unavailable`：驱动或它的辅助进程没在跑，或者缺一项系统权限（辅助功能、录屏）。
+ * - `person-present`：人正在用鼠标键盘，或者人把电脑拿回去了。注入事件就是跟人抢鼠标。
+ * - `screen-locked`：屏幕锁着、屏保开着，或者人不在这台机器的控制台前。**动作归
+ *   `user-visible` 的前提是有人在看**——锁着的时候那句话不成立，而键盘事件会打进锁屏的密码框。
+ * - `outside-target`：这一下会落在目标应用之外——落点被别的窗口盖着、拖出了这个应用、
+ *   还没有目标应用就要点。
+ */
+export type SurfaceRefusalReason = "driver-unavailable" | "person-present" | "screen-locked" | "outside-target";
+
+const REFUSAL_REASONS: ReadonlySet<string> = new Set<SurfaceRefusalReason>([
+  "driver-unavailable",
+  "person-present",
+  "screen-locked",
+  "outside-target",
+]);
+
+/** 给 App 看的那一句。**固定文本**——驱动自己的话不跟着走，里面可能有路径和窗口标题。 */
+const REFUSAL_MESSAGES: Readonly<Record<SurfaceRefusalReason, string>> = {
+  "driver-unavailable":
+    "The interface driver is not available right now (not running, or missing a system permission)",
+  "person-present": "The person is using the computer right now",
+  "screen-locked": "The screen is locked or nobody is at the console",
+  "outside-target": "That action would land outside the application this surface targets",
+};
+
+/** 驱动说「现在不行」时抛的那个错误。`code` 固定，理由在 `reason` 上。 */
+export interface SurfaceRefusal extends PrologueError {
+  readonly code: "UI_SURFACE_REFUSED";
+  readonly reason: SurfaceRefusalReason;
+  /**
+   * 可能已经落了一部分：例如一次拖动按下之后人动了鼠标。**这一笔进对账**，不当成没发生，
+   * 也不自动再来一次。
+   */
+  readonly partial: boolean;
+}
+
+/**
+ * 造一个有类型的拒绝。**驱动在 `observe` / `perform` 中途发现不能再动时抛它**——例如两次
+ * 注入的事件之间人动了鼠标。一下都还没落到界面上就不给 `partial`；可能已落了一部分就给
+ * `partial: true`，那一笔进对账。
+ */
+export function createSurfaceRefusal(
+  reason: SurfaceRefusalReason,
+  options?: { readonly partial?: boolean },
+): SurfaceRefusal {
+  if (!REFUSAL_REASONS.has(reason)) {
+    throw createPrologueError("UI_ACTION_INVALID", "That is not one of the surface refusal reasons.");
+  }
+  const partial = options?.partial === true;
+  const error = createPrologueError(
+    "UI_SURFACE_REFUSED",
+    `${REFUSAL_MESSAGES[reason]}; ${partial ? "part of that action may already have happened" : "nothing was done"}.`,
+  );
+  Object.defineProperties(error, {
+    reason: { value: reason, enumerable: true },
+    partial: { value: partial, enumerable: true },
+  });
+  return error as SurfaceRefusal;
+}
+
+/** 这个错误是不是一次拒绝；是就回它，不是（或理由认不出）就是 `undefined`。 */
+export function surfaceRefusalOf(error: unknown): SurfaceRefusal | undefined {
+  if (!isPrologueError(error) || error.code !== "UI_SURFACE_REFUSED") return undefined;
+  const reason = (error as { reason?: unknown }).reason;
+  return typeof reason === "string" && REFUSAL_REASONS.has(reason) ? (error as SurfaceRefusal) : undefined;
+}
