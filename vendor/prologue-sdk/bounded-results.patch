@@ -0,0 +1,64 @@
+import { createPrologueError, type ExactRef } from "../../kernel/core/index.js";
+import type { ModelEvent, UsageReceipt } from "../../model/core/index.js";
+import { isTerminalEventType, type Run, type TerminalRunState } from "./run.js";
+
+export interface RunCompletion {
+  readonly ref: ExactRef<"run">;
+  readonly state: TerminalRunState;
+  readonly terminal: Extract<ModelEvent, { type: TerminalRunState }>;
+  readonly text: string;
+  readonly reportedModels: readonly string[];
+  readonly usage: readonly UsageReceipt[];
+}
+
+/** Observe one original Run, including committed replay. Does not start, retry or bill a model call. */
+export function collectRun(run: Run, options: {
+  readonly signal: AbortSignal;
+  readonly maxTextChars: number;
+  readonly maxEvents: number;
+  readonly onEvent?: (event: ModelEvent) => void;
+}): Promise<RunCompletion> {
+  for (const limit of [options.maxTextChars, options.maxEvents]) {
+    if (!Number.isSafeInteger(limit) || limit < 1) {
+      throw createPrologueError("RUNTIME_OPTIONS_INVALID", "Run collection bounds must be positive safe integers.");
+    }
+  }
+  return new Promise((resolve, reject) => {
+    let settled = false, detach: (() => void) | undefined, text = "", count = 0;
+    const models = new Set<string>(), usage: UsageReceipt[] = [];
+    const cleanup = () => { settled = true; options.signal.removeEventListener("abort", abort); detach?.(); };
+    const stop = (error: unknown) => {
+      if (settled) return;
+      cleanup();
+      void run.cancel().catch(() => undefined);
+      reject(error);
+    };
+    const abort = () => stop(options.signal.reason);
+    options.signal.addEventListener("abort", abort, { once: true });
+    if (options.signal.aborted) { abort(); return; }
+    try {
+      detach = run.subscribe(event => {
+        if (settled) return;
+        try {
+          if (++count > options.maxEvents || event.type === "text-delta" && text.length + event.text.length > options.maxTextChars) {
+            stop(createPrologueError("MODEL_RESPONSE_INVALID", "Run result exceeds the caller's collection bounds."));
+            return;
+          }
+          if (event.type === "text-delta") text += event.text;
+          if (event.type === "model-reported") models.add(event.model);
+          if (event.type === "usage-recorded") usage.push(event.receipt);
+          options.onEvent?.(event);
+          // The observer may synchronously abort; never turn that cancellation into completion.
+          if (settled) return;
+          if (isTerminalEventType(event.type)) {
+            cleanup();
+            resolve({ ref: run.ref, state: event.type, terminal: event as RunCompletion["terminal"], text,
+              reportedModels: [...models], usage });
+          }
+        } catch (error) { stop(error); }
+      });
+      // subscribe may synchronously replay a terminal event before returning its disposer.
+      if (settled) detach();
+    } catch (error) { stop(error); }
+  });
+}
