{
  // Copy beside this file as wrangler.production.jsonc, then replace the D1, private R2, Auth and application placeholders.
  // This file alone does not create a Worker or database.
  "name": "molis-work-sync-production",
  "main": "dist/index.js",
  "compatibility_date": "2026-09-19",
  "workers_dev": true,
  "preview_urls": false,
  "triggers": {"crons":["17 * * * *"]},
  "build": {"command":"node build.mjs", "watch_dir": ["src", "../../server/src/sync"]},
  "d1_databases": [{"binding":"DB","database_name":"molis-work-sync-production","database_id":"00000000-0000-0000-0000-000000000000","migrations_dir":"../../server/migrations/sync"}],
  "r2_buckets": [{"binding":"BLOBS","bucket_name":"configure-private-sync-bucket"}],
  "vars": {"DEPLOYMENT_MODE":"cloud","AUTH_ORIGIN":"https://configure-auth.example.invalid","APPLICATION_ID":"configure-molis-work-application-id","SYNC_WRITE_MODE":"read-write"}
}
