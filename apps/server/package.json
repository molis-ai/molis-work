{
  "name": "@molis-ai/molis-work-app-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@molis-ai/molis-work-server": "workspace:*",
    "@molis-ai/molis-work-contracts": "workspace:*",
    "@molis-ai/molis-work-im-ui": "workspace:*"
  },
  "description": "Composable headless server protocol and lifecycle; local adapters are injected by the product CLI.",
  "license": "SEE LICENSE IN LICENSE",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ]
}
