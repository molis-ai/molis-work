{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Molis Work",
  "version": "0.1.0",
  "identifier": "com.molis.work",
  "build": {
    "frontendDist": "../webview-placeholder"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "dragDropEnabled": false,
        "title": "Molis Work",
        "width": 1180,
        "height": 760,
        "minWidth": 460,
        "minHeight": 560,
        "resizable": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 10
        },
        "url": "index.html"
      }
    ],
    "security": {
      "csp": "default-src 'none'; style-src 'self'; script-src 'none'; img-src 'self'; font-src 'self'; connect-src 'none'; frame-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "resources": ["resources/molis-work-runtime"],
    "icon": ["icons/icon.png", "icons/icon.icns"],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
