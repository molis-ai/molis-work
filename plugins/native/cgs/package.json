{
  "name": "@molis-ai/molis-work-plugin-cgs",
  "version": "0.0.0",
  "private": true,
  "description": "CGS author workflow through the project Plugin Runtime",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./native": {
      "types": "./dist/native.d.ts",
      "import": "./dist/native.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@molis-ai/molis-work-contracts": "workspace:*",
    "@molis-ai/molis-work-plugin-sdk": "workspace:*",
    "@adeptify/cgs-work": "file:../../../vendor/cgs/adeptify-cgs-work-0.26.10.tgz"
  },
  "molis-work": {
    "path": "plugins/native/cgs",
    "kind": "native-plugin",
    "maturity": "partial",
    "contract": "@molis-ai/molis-work-contracts/platform/plugin",
    "migrationGoals": [
      "goal-reorg-f2",
      "goal-plugin-platform-v2"
    ],
    "ssot": "docs/SSOT-MATRIX.md",
    "capabilities": []
  }
}
