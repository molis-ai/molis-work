+    const started = await f.runtime.startAgentRun({ session, workspace: "app", start: f.start(), agent: { idempotencyKey: "s2", mode: "build", toolNames: ["lookup"] } });
+    const run = watch(started.run);
+    expect((await run.until("terminal")).type).toBe("completed");
+    expect(run.events.some(event => event.type === "model-response-repair")).toBe(false);
