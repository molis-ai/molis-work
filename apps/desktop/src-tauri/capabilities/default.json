{
  "identifier": "default",
  "description": "Molis Work desktop workbench and live work capsule",
  "windows": ["main", "capsule"],
  "remote": {
    "urls": ["http://127.0.0.1:4173/*", "http://localhost:4173/*"]
  },
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "core:window:allow-start-dragging",
    "core:app:default",
    "core:webview:default",
    "allow-capsule-window",
    "allow-shelf-desktop"
  ]
}
