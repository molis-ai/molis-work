+import { createPrologueError } from "../../kernel/core/index.js";
+import { DEFAULT_IMAGE_LIMITS, type ImageAdapter, type ImagePayload } from "../core/image.js";
+import { imageBytes } from "./image-bytes.js";
+export const GEMINI_IMAGES: ImageAdapter = {
+  protocol: "gemini", authScheme: "x-goog-api-key", maxPerCall: 4, extraHeaders: () => ({}),
+  buildBody({ request, from, mask }) {
+    if (from.length || mask) throw createPrologueError("MODEL_REQUEST_INVALID", "This Gemini adapter currently supports text-to-image requests only.");
+    return { bytes: new TextEncoder().encode(JSON.stringify({
+      contents: [{ role: "user", parts: [{ text: request.prompt }] }],
+      generationConfig: { responseModalities: ["TEXT", "IMAGE"], ...(request.aspectRatio ? { imageConfig: { aspectRatio: request.aspectRatio } } : {}) },
+    })) };
+  },
+  readOutcome(raw, limits = DEFAULT_IMAGE_LIMITS) {
+    let body: { candidates?: { content?: { parts?: { thought?: boolean; inlineData?: { data?: unknown; mimeType?: unknown }; inline_data?: { data?: unknown; mime_type?: unknown } }[] } }[] };
+    try { body = JSON.parse(raw); } catch { throw createPrologueError("MODEL_RESPONSE_INVALID", "The image response was not JSON."); }
+    const images: ImagePayload[] = [];
+    for (const candidate of body?.candidates ?? []) for (const part of candidate.content?.parts ?? []) {
+      if (part.thought || images.length >= limits.maxImages) continue;
+      const inline = part.inlineData ?? part.inline_data;
+      if (!inline || typeof inline.data !== "string") continue;
+      const mime = "mimeType" in inline ? inline.mimeType : "mime_type" in inline ? inline.mime_type : undefined;
+      images.push({ bytes: imageBytes(inline.data, limits.maxImageBytes), mediaType: typeof mime === "string" ? mime : undefined });
+    }
+    if (!images.length) throw createPrologueError("MODEL_RESPONSE_INVALID", "The image response carried no images.");
+    return { images, revisedPrompt: undefined, spend: { amount: undefined, currency: undefined, tokens: undefined } };
+  },
+};
