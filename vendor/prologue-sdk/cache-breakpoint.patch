new file mode 100644
index 00000000..38d03592
--- /dev/null
+++ b/packages/sdk/src/composition/core/model-response.ts
@@ -0,0 +1,74 @@
+import { createPrologueError } from "../../kernel/core/index.js";
+import type { ModelNetworkHandle, ModelNetworkPrepareInput, PrologueHost } from "../../host/core/index.js";
+
+/** Bounded native model I/O shared by image and structured protocols. Host alone performs network access. */
+export function createModelResponses(host: PrologueHost) {
+  const active = new Map<AbortController, Promise<unknown>>();
+  let closed = false;
+  const shutdown = new AbortController();
+  return {
+    /** Covers parsing and publication too, not only the network Promise. */
+    run<T>(signal: AbortSignal | undefined, operation: (signal: AbortSignal) => Promise<T>): Promise<T> {
+      if (closed) return Promise.reject(createPrologueError("RUNTIME_NOT_READY", "Model inference is closed."));
+      const controller = new AbortController();
+      const combined = AbortSignal.any([shutdown.signal, controller.signal, ...(signal ? [signal] : [])]);
+      const task = (async () => { combined.throwIfAborted(); const result = await operation(combined); combined.throwIfAborted(); return result; })();
+      active.set(controller, task);
+      void task.finally(() => active.delete(controller)).catch(() => {});
+      return task;
+    },
+    request(input: ModelNetworkPrepareInput, signal?: AbortSignal): Promise<{ handle: ModelNetworkHandle; bytes: Uint8Array; contentType?: string }> {
+      if (closed) return Promise.reject(createPrologueError("RUNTIME_NOT_READY", "Model inference is closed."));
+      const controller = new AbortController();
+      const combined = AbortSignal.any([shutdown.signal, controller.signal, AbortSignal.timeout(input.timeoutMs), ...(signal ? [signal] : [])]);
+      const task = (async () => {
+        let handle: ModelNetworkHandle | undefined;
+        const abort = () => { if (handle) void host.cancelModelNetwork(handle).catch(() => {}); };
+        combined.addEventListener("abort", abort, { once: true });
+        try {
+          combined.throwIfAborted();
+          const prepared = host.prepareModelNetwork(input);
+          void prepared.then(late => { if (combined.aborted) return host.cancelModelNetwork(late); }).catch(() => {});
+          handle = await waitForModelWork(prepared, combined);
+          if (combined.aborted) { await host.cancelModelNetwork(handle); combined.throwIfAborted(); }
+          const chunks: Uint8Array[] = [];
+          let length = 0, contentType: string | undefined;
+          const outcome = await waitForModelWork(host.executeModelNetwork({ handle, onFrame: () => {},
+            onResponse: response => {
+              if (response.status < 200 || response.status > 299) throw createPrologueError("MODEL_HTTP_ERROR", "The model provider rejected the request.", { status: response.status });
+              contentType = response.contentType;
+            },
+            onBytes: chunk => {
+              combined.throwIfAborted(); length += chunk.byteLength;
+              if (input.maxResponseBytes !== undefined && length > input.maxResponseBytes) throw createPrologueError("MODEL_RESPONSE_INVALID", "The model response exceeded its byte limit.");
+              chunks.push(Uint8Array.from(chunk));
+            },
+          }), combined);
+          combined.throwIfAborted();
+          if (outcome === "cancelled") throw createPrologueError("CANCELLED", "Model inference was cancelled.");
+          const bytes = new Uint8Array(length); let offset = 0;
+          for (const chunk of chunks) { bytes.set(chunk, offset); offset += chunk.byteLength; }
+          return { handle, bytes, ...(contentType ? { contentType } : {}) };
+        } catch (error) {
+          if (handle) await host.cancelModelNetwork(handle).catch(() => {});
+          combined.throwIfAborted(); throw error;
+        } finally { combined.removeEventListener("abort", abort); }
+      })();
+      active.set(controller, task);
+      void task.finally(() => active.delete(controller)).catch(() => {});
+      return task;
+    },
+    async close() { closed = true; shutdown.abort(); for (const controller of active.keys()) controller.abort(); await Promise.allSettled([...active.values()]); },
+  };
+}
+export type ModelResponses = ReturnType<typeof createModelResponses>;
+
+/** Stop waiting for an uncooperative preparation; a late handle is cancelled by its owner. */
+function waitForModelWork<T>(work: Promise<T>, signal: AbortSignal): Promise<T> {
+  if (signal.aborted) { void work.catch(() => {}); return Promise.reject(signal.reason); }
+  return new Promise<T>((resolve, reject) => {
+    const abort = () => reject(signal.reason);
+    signal.addEventListener("abort", abort, { once: true });
+    void work.then(resolve, reject).finally(() => signal.removeEventListener("abort", abort));
+  });
+}
