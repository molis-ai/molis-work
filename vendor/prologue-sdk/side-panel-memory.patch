+++ b/packages/sdk/test/bounded-run-results.test.ts
@@ -0,0 +1,65 @@
+import { expect, it } from "vitest";
+import { collectRun, validateAgainst, assertSchemaSupported, unknownUsage, type ModelEvent, type Run, type JsonSchema } from "../src/index.js";
+
+function replay(events: ModelEvent[]) {
+  let detached = 0, cancelled = 0;
+  const run: Run = { ref: { kind: "run", id: "test-run", revision: 1 }, state: "completed",
+    subscribe(listener) { for (const event of events) listener(event); return () => { detached++; }; },
+    async cancel() { cancelled++; } };
+  return { run, get detached() { return detached; }, get cancelled() { return cancelled; } };
+}
+const options = () => ({ signal: AbortSignal.timeout(5_000), maxTextChars: 100, maxEvents: 20 });
+
+it("collects committed synchronous replay once, preserving unknown usage and the original terminal", async () => {
+  const receipt = unknownUsage();
+  const f = replay([{ type: "text-delta", text: "answer" }, { type: "model-reported", model: "actual" },
+    { type: "usage-recorded", callId: "c", receipt }, { type: "completed" }]);
+  const seen: string[] = [];
+  const result = await collectRun(f.run, { ...options(), onEvent: event => seen.push(event.type) });
+  expect(result).toMatchObject({ ref: f.run.ref, state: "completed", text: "answer", reportedModels: ["actual"], usage: [receipt] });
+  expect(result.usage[0]!.input.tokens).toBeUndefined();
+  expect(seen).toHaveLength(4);
+  expect(f.detached).toBe(1); expect(f.cancelled).toBe(0);
+});
+
+it.each(["cancelled", "tripped", "circuit-tripped", "failed"] as const)("retains %s instead of returning apparent success", async state => {
+  const terminal = { type: state } as ModelEvent;
+  const f = replay([terminal]);
+  expect((await collectRun(f.run, options())).state).toBe(state);
+  expect(f.detached).toBe(1);
+});
+
+it("bounds both content and events, cancels and detaches without accepting late completion", async () => {
+  for (const limits of [{ maxTextChars: 2, maxEvents: 20 }, { maxTextChars: 100, maxEvents: 1 }]) {
+    const f = replay([{ type: "text-delta", text: "long" }, { type: "completed" }]);
+    await expect(collectRun(f.run, { ...options(), ...limits })).rejects.toMatchObject({ code: "MODEL_RESPONSE_INVALID" });
+    expect(f.cancelled).toBe(1); expect(f.detached).toBe(1);
+  }
+});
+
+it("an observer failure or synchronous cancellation releases the subscription and original Run", async () => {
+  for (const kind of ["throw", "abort"] as const) {
+    const controller = new AbortController(), error = new Error("stop");
+    const f = replay([{ type: "completed" }]);
+    await expect(collectRun(f.run, { ...options(), signal: controller.signal, onEvent() {
+      if (kind === "throw") throw error;
+      controller.abort(error);
+    } })).rejects.toBe(error);
+    expect(f.cancelled).toBe(1); expect(f.detached).toBe(1);
+  }
+});
+
+it("validates nullable alternatives, length/number bounds and enum together with type", () => {
+  const schema: JsonSchema = { type: "object", properties: {
+    title: { type: ["string", "null"], minLength: 1, maxLength: 2 },
+    values: { type: "array", minItems: 1, maxItems: 2, items: { type: "number", minimum: 0, maximum: 1 } },
+    extra: { anyOf: [{ type: "null" }, { type: "integer", minimum: 1 }] },
+  }, required: ["title", "values", "extra"], additionalProperties: false };
+  assertSchemaSupported(schema);
+  expect(validateAgainst({ title: "😀", values: [0, 1], extra: null }, schema)).toEqual([]);
+  expect(validateAgainst({ title: "", values: [2], extra: 0.5 }, schema).map(v => v.path)).toEqual(["$.title", "$.values[0]", "$.extra"]);
+  expect(validateAgainst(1, { type: "string", enum: [1] })).not.toEqual([]);
+  for (const malformed of [{ type: "string", minLength: -1 }, { type: "number", minimum: "0" }, { anyOf: [] }, { type: "mystery" }]) {
+    expect(() => assertSchemaSupported(malformed as JsonSchema)).toThrow(expect.objectContaining({ code: "MODEL_STRUCTURED_UNSUPPORTED" }));
+  }
+});
