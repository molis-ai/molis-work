@@ -0,0 +1,9 @@
+import { createPrologueError, decodeBase64 } from "../../kernel/core/index.js";
+export function imageBytes(value: string, maxBytes: number): Uint8Array {
+  const padding = value.indexOf("=");
+  const validPadding = padding === -1 || padding >= value.length - 2 && value.slice(padding) === "=".repeat(value.length - padding);
+  if (!value || value.length > Math.ceil(maxBytes / 3) * 4 || value.length % 4 !== 0 || /[^A-Za-z0-9+/=]/u.test(value) || !validPadding) throw createPrologueError("MODEL_RESPONSE_INVALID", "Image data is invalid or exceeds its byte limit.");
+  const bytes = decodeBase64(value);
+  if (!bytes.length || bytes.length > maxBytes) throw createPrologueError("MODEL_RESPONSE_INVALID", "Image data exceeds its byte limit.");
+  return bytes;
+}
