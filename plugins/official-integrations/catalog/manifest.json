{
  "schema_version": 1,
  "plugin_id": "io.molis.work.integration.catalog",
  "version": "1.0.0",
  "name": "服务连接目录",
  "name_text": { "key": "catalog.directory.name" },
  "summary": "连接外部服务账号，用于同步动态与导入文档。",
  "summary_text": { "key": "catalog.directory.summary" },
  "kind": "integration",
  "publisher": {
    "publisher_id": "io.adeptify",
    "signature": "adeptify-official-signature-v1"
  },
  "host_api_version": 1,
  "entrypoints": [
    { "deployment": "local", "entrypoint": "./dist/index.js" }
  ],
  "permissions": [
    { "permission": "network:catalog", "required": true, "reason": "读取已连接服务的账号信息与最新动态", "reason_text": { "key": "catalog.permission.network.reason" } },
    { "permission": "secret:catalog", "required": true, "reason": "使用按服务隔离保存的连接凭据", "reason_text": { "key": "catalog.permission.secret.reason" } }
  ],
  "capabilities": {
    "provides": ["connector.driver.catalog.v1", "signal.adapter.catalog.v1"],
    "consumes": ["connector.host.v1", "listener.host.v1", "signals.command.v1"]
  },
  "artifacts": { "produces": [], "consumes": [] },
  "ui": {
    "contributions": ["settings.integration.catalog"],
    "locales": { "default": "zh", "available": ["zh", "en", "ja"] }
  }
}
