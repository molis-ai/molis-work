{
  "name": "@molis-ai/molis-work-plugin-ppt",
  "version": "0.0.0",
  "private": true,
  "description": "First-party PPT workbench: slide outlines, preview, and JSON export.",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./registration": {
      "types": "./dist/registration.d.ts",
      "import": "./dist/registration.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.browser.json && esbuild src/browser/factory.ts --bundle --format=iife --platform=browser --minify --charset=utf8 '--banner:js=(host) => {' --footer:js=} --outfile=dist/ppt-client.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.browser.json"
  },
  "dependencies": {
    "@molis-ai/molis-work-contracts": "workspace:*",
    "@molis-ai/molis-work-design-system": "workspace:*",
    "@molis-ai/molis-work-plugin-sdk": "workspace:*",
    "@molis-ai/molis-work-storage": "workspace:*",
    "fflate": "0.8.2"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "molis-work": {
    "path": "plugins/native/ppt",
    "kind": "native-plugin",
    "maturity": "partial",
    "contract": "@molis-ai/molis-work-contracts/platform/plugin",
    "summary": "Protected first-party PPT directory, slide outlines, preview, and JSON export.",
    "notResponsibleFor": "Goal/Artifact facts, SVG generation, or images and charts inside exported PPTX.",
    "legacySources": [
      "src/web/render.ts"
    ],
    "migrationGoals": [
      "goal-reorg-f2"
    ],
    "ssot": "docs/SSOT-MATRIX.md",
    "capabilities": [
      "ppt.ui-contribution.v1",
      "ppt.http-routes.v1",
      "ppt.pptx-export.v1"
    ],
    "extraWorkspaceDependencies": [
      "@molis-ai/molis-work-plugin-sdk",
      "@molis-ai/molis-work-design-system",
      "@molis-ai/molis-work-storage"
    ],
    "extraDependencies": {
      "fflate": "0.8.2"
    },
    "registration": "./registration"
  }
}
