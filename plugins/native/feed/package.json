{
  "name": "@molis-ai/molis-work-plugin-feed",
  "version": "0.0.0",
  "private": true,
  "description": "First-party Feed navigation, UI, disposition, and Module composition.",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contract": {
      "types": "./dist/contract/index.d.ts",
      "import": "./dist/contract/index.js"
    },
    "./registration": {
      "types": "./dist/registration.d.ts",
      "import": "./dist/registration.js"
    },
    "./store": {
      "types": "./dist/store/index.d.ts",
      "import": "./dist/store/index.js"
    }
  },
  "files": [
    "dist",
    "locales",
    "README.md"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.browser.json && esbuild src/browser/factory.ts --bundle --format=iife --platform=browser --minify --charset=utf8 '--banner:js=(host) => {' --footer:js=} --outfile=dist/feed-client.js && node ../../../scripts/client-literals.mjs --factory dist/feed-client.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.browser.json"
  },
  "dependencies": {
    "@molis-ai/molis-work-contracts": "workspace:*",
    "@adeptify/search-evidence-layer": "file:../../../vendor/search-evidence-layer/adeptify-search-evidence-layer-0.4.1.tgz",
    "@adeptify/intelligence-client": "file:../../../vendor/intelligence-client/adeptify-intelligence-client-0.2.2.tgz",
    "@molis-ai/molis-work-plugin-sdk": "workspace:*",
    "micromark": "^4.0.2",
    "micromark-extension-gfm": "^3.0.0",
    "sanitize-html": "^2.17.7"
  },
  "molis-work": {
    "maturity": "slice",
    "capabilities": [
      "feed.native-plugin.contract.v1",
      "feed.ui-contribution.v1",
      "feed.http-routes.v1"
    ],
    "registration": "./registration",
    "extraWorkspaceDependencies": [
      "@molis-ai/molis-work-plugin-sdk"
    ],
    "extraDependencies": {
      "@adeptify/intelligence-client": "file:../../../vendor/intelligence-client/adeptify-intelligence-client-0.2.2.tgz",
      "@adeptify/search-evidence-layer": "file:../../../vendor/search-evidence-layer/adeptify-search-evidence-layer-0.4.1.tgz",
      "micromark": "^4.0.2",
      "micromark-extension-gfm": "^3.0.0",
      "sanitize-html": "^2.17.7"
    }
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
