{
  "name": "@molis-ai/molis-work-kernel",
  "version": "0.0.0",
  "private": true,
  "description": "Capability registration, selection, grants, and lifecycle skeleton.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@molis-ai/molis-work-contracts": "workspace:*",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  },
  "molis-work": {
    "path": "packages/kernel",
    "kind": "foundation",
    "maturity": "partial",
    "contract": "@molis-ai/molis-work-contracts/platform/kernel",
    "migrationGoals": [
      "goal-reorg-f2",
      "goal-reorg-f3",
      "goal-reorg-ap2"
    ],
    "ssot": "docs/SSOT-MATRIX.md",
    "capabilities": [
      "kernel.capability-registry.v1"
    ]
  }
}
