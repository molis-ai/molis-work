diff --git a/packages/sdk/src/effect-policy/core/effect-persistence.ts b/packages/sdk/src/effect-policy/core/effect-persistence.ts
new file mode 100644
index 0000000000000000000000000000000000000000..47bb7977f6204fd1f577995c131bb0a132032486
--- /dev/null
+++ b/packages/sdk/src/effect-policy/core/effect-persistence.ts
@@ -0,0 +1,66 @@
+import { createPrologueError, isPrologueError } from "../../kernel/core/index.js";
+import type { Held } from "./chain.js";
+import type { HeldPending } from "./pending-state.js";
+import type { StoredEffectRecord, StoredPolicy } from "./stored-policy.js";
+
+const UNCERTAIN_COMMIT = Symbol("uncertain-policy-commit");
+
+/** Private evidence from the original persistence boundary; a business refusal cannot manufacture it. */
+export function isUncertainPolicyCommit(error: unknown): boolean {
+  return typeof error === "object" && error !== null && UNCERTAIN_COMMIT in error;
+}
+
+function uncertainCommit(error: unknown): unknown {
+  const wrapped = isPrologueError(error)
+    ? createPrologueError(error.code, error.safeMessage, error.status === undefined ? undefined : { status: error.status })
+    : createPrologueError("STORAGE_RECONCILE_REQUIRED", "The Host commit result is unknown; recover the original stored policy before retrying.");
+  Object.defineProperty(wrapped, UNCERTAIN_COMMIT, { value: true });
+  return wrapped;
+}
+
+export function assertSynchronousPreparation(check: (() => void) | undefined): void {
+  const result: unknown = check?.();
+  if (result !== null && (typeof result === "object" || typeof result === "function") && "then" in result && typeof result.then === "function") {
+    void Promise.resolve(result).catch(() => undefined);
+    throw createPrologueError("EFFECT_NOT_AUTHORIZED", "The preparation check must be synchronous.");
+  }
+}
+
+/** Persist through the original owner and keep a revoked preparation out of storage-failure notifications. */
+export function createEffectPersistence(input: {
+  readonly store: StoredPolicy | undefined;
+  readonly snapshot: (id: string, entry: Held) => StoredEffectRecord;
+  readonly notifyFailure: (id: string, error: unknown) => void;
+}) {
+  return async (batch: {
+    readonly effects?: readonly { readonly id: string; readonly entry: Held }[];
+    readonly pendings?: readonly { readonly id: string; readonly held: HeldPending }[];
+  }, assertCurrent?: () => void): Promise<void> => {
+    let refused = false;
+    let hostStarted = false;
+    const beforeCommit = (): void => {
+      try { assertCurrent?.(); } catch (error) { refused = true; throw error; }
+      hostStarted = true;
+    };
+    assertCurrent?.();
+    if (input.store === undefined) return;
+    try {
+      await input.store.commit({
+        beforeCommit,
+        ...(batch.effects === undefined ? {} : { effects: batch.effects.map((one) => input.snapshot(one.id, one.entry)) }),
+        ...(batch.pendings === undefined ? {} : { pendings: batch.pendings }),
+      });
+    } catch (error) {
+      // These contracts refuse before writing. Other failures after the storage
+      // boundary can be write-then-lost-response and need original recovery.
+      const rejectedBeforeWrite = isPrologueError(error) && (
+        error.code === "STORAGE_CONFLICT" || error.code === "STORAGE_KEY_INVALID" ||
+        error.code === "STORAGE_ENCRYPTION_UNAVAILABLE" || error.code === "RUNTIME_NOT_READY"
+      );
+      const failure = !refused && hostStarted && assertCurrent !== undefined && !rejectedBeforeWrite
+        ? uncertainCommit(error) : error;
+      if (!refused) for (const one of batch.pendings ?? []) input.notifyFailure(one.id, failure);
+      throw failure;
+    }
+  };
+}
