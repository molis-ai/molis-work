    "transactionTtlSeconds": 600,
    "challengeTtlSeconds": 300,
    "challengeMaxWrongAttempts": 5,
    "challengeResendSeconds": 60,
    "loginCodeTtlSeconds": 60,
    "proofTtlSeconds": 300,
    "invitationTtlSeconds": 604800,
    "transferTtlSeconds": 86400,
    "idempotencyTtlSeconds": 86400,
    "loginIdleSeconds": 2592000,
    "loginAbsoluteSeconds": 7776000,
    "accessTokenTtlSeconds": 900,
    "passwordMinNormalizedCodePoints": 8,
    "passwordMaxNormalizedCodePoints": 128,
    "passwordMaxRawUtf16Units": 512,
    "pageDefault": 20,
    "pageMax": 100,
    "entitlementFeatureMax": 100,
    "sendQuotaWindowSeconds": 3600,
    "sendQuotaPerIp": 60,
    "sendQuotaPerTarget": 10,
    "sendQuotaPerClient": 1000
  },
  "errors": {
    "400": [
      "INVALID_REQUEST",
      "INVALID_SCOPE",
      "FEATURE_UNKNOWN"
    ],
    "401": [
      "LOGIN_REQUIRED",
      "SESSION_EXPIRED",
      "SESSION_REVOKED",
      "INVALID_CREDENTIALS",
      "INVALID_GRANT"
    ],
    "403": [
      "FORBIDDEN",
      "POLICY_MISMATCH",
      "TENANT_DISABLED",
      "REAUTH_REQUIRED",
      "CLIENT_POLICY_REQUIRES_V2",
      "TENANT_API_REQUIRED"
    ],
    "404": [
      "NOT_FOUND"
    ],
    "409": [
      "VERSION_CONFLICT",
      "CAPACITY_CONFLICT",
      "IDENTITY_IN_USE",
      "LAST_LOGIN_METHOD",
      "OWNER_TRANSFER_REQUIRED",
      "PROOF_CONSUMED",
      "TRANSACTION_EXPIRED",
      "IDEMPOTENCY_CONFLICT"
    ],
    "429": [
      "RATE_LIMITED"
    ],
    "501": [
      "UNIFIED_ACCOUNT_NOT_IMPLEMENTED"
    ],
    "503": [
      "UPSTREAM_UNAVAILABLE",
      "AUTH_UNAVAILABLE",
      "UNIFIED_CONFIGURATION_INVALID"
    ]
  },
