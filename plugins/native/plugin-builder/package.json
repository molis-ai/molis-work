{
  "name": "@molis-ai/molis-work-plugin-builder",
  "version": "0.0.0",
  "private": true,
  "description": "Prologue-powered plugin design, live assembly and independent data applications.",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./registration": {
      "types": "./dist/registration.d.ts",
      "import": "./dist/registration.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@molis-ai/molis-work-contracts": "workspace:*",
    "@molis-ai/molis-work-design-system": "workspace:*"
  },
  "molis-work": {
    "path": "plugins/native/plugin-builder",
    "kind": "native-plugin",
    "maturity": "slice",
    "contract": "@molis-ai/molis-work-contracts/platform/plugin",
    "summary": "Prologue plugin design, assembly and independent applications.",
    "notResponsibleFor": "Model credentials, runtime ownership or arbitrary code execution.",
    "legacySources": [],
    "migrationGoals": [
      "goal-reorg-f2"
    ],
    "ssot": "docs/SSOT-MATRIX.md",
    "capabilities": [
      "plugin-builder.ui.v1",
      "plugin-builder.workflow.v1"
    ],
    "extraWorkspaceDependencies": [
      "@molis-ai/molis-work-design-system"
    ],
    "extraDependencies": {},
    "registration": "./registration"
  }
}
