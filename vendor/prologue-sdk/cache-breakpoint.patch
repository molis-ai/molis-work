+import { expect, it } from "vitest";
+import { createRuntime, type Runtime } from "../src/index.js";
+import { createMemoryHost } from "../src/testing/api/index.js";
+const app = { appId: "prologue.bounded-lifecycle", appVersion: "1.0.0" };
+const png = new Uint8Array([137,80,78,71,13,10,26,10]);
+const body = JSON.stringify({ data: [{ b64_json: Buffer.from(png).toString("base64") }] });
+const request = { protocol: "openai-images", endpoint: "https://api.example.com/images", model: "image", prompt: "draw" };
+
+it("cancel during preparation settles the surface and shutdown, and cancels a late Host handle without dispatch", async () => {
+  const host = createMemoryHost({ script: { frames: [body] } });
+  const prepare = host.prepareModelNetwork.bind(host), entered = Promise.withResolvers<void>(), release = Promise.withResolvers<void>();
+  let executeCount = 0, cancelled = 0;
+  host.prepareModelNetwork = async input => { entered.resolve(); await release.promise; return prepare(input); };
+  const execute = host.executeModelNetwork.bind(host), cancel = host.cancelModelNetwork.bind(host);
+  host.executeModelNetwork = async input => { executeCount++; return execute(input); };
+  host.cancelModelNetwork = async input => { cancelled++; return cancel(input); };
+  const runtime = await createRuntime({ app, host, network: { model: true } });
+  const credentialRef = (await runtime.credentials.write({ label: "test", secret: { plaintext: new TextEncoder().encode("synthetic") } })).ref;
+  const controller = new AbortController();
+  const pending = runtime.images.generate({ ...request, credentialRef, signal: controller.signal });
+  const rejected = expect(pending).rejects.toMatchObject({ name: "AbortError" });
+  await entered.promise; controller.abort(); await rejected;
+  await runtime.shutdown();
+  release.resolve(); await new Promise(resolve => setTimeout(resolve, 0));
+  expect(cancelled).toBe(1); expect(executeCount).toBe(0);
+});
+
+it("shutdown after response completion but before publication cannot return successful resources", async () => {
+  const host = createMemoryHost({ script: { frames: [body] } });
+  const execute = host.executeModelNetwork.bind(host);
+  let runtime: Runtime, shutdown: Promise<unknown> | undefined;
+  host.executeModelNetwork = async input => { const outcome = await execute(input); shutdown = runtime.shutdown(); return outcome; };
+  runtime = await createRuntime({ app, host, network: { model: true } });
+  const credentialRef = (await runtime.credentials.write({ label: "test", secret: { plaintext: new TextEncoder().encode("synthetic") } })).ref;
+  await expect(runtime.images.generate({ ...request, credentialRef })).rejects.toMatchObject({ name: "AbortError" });
+  await shutdown;
+});
