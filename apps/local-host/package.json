    "@molis-ai/molis-work-integration-github": "workspace:*",
    "@molis-ai/molis-work-service-connector-host": "workspace:*",
    "@molis-ai/molis-work-service-runtime-host": "workspace:*",
    "ws": "^8.21.3",
    "@molis-ai/molis-work-plugin-work": "workspace:*",
    "@molis-ai/molis-work-app-cli": "workspace:*"
  },
  "molis-work": {
    "path": "apps/local-host",
    "kind": "app",
    "maturity": "partial",
    "contract": "@molis-ai/molis-work-contracts/platform/app-host",
    "migrationGoals": [
      "goal-reorg-f2",
      "goal-reorg-ap2"
    ],
    "ssot": "docs/SSOT-MATRIX.md",
    "capabilities": [
      "local-host.client.v1",
      "local-host.single-writer.v1"
    ]
  },
  "devDependencies": {
    "@types/ws": "^8.18.1"
