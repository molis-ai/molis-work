{
  "name": "@molis-ai/molis-work-plugin-images",
  "version": "0.0.0",
  "private": true,
  "description": "本机多厂商图片生成工作台",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./registration": {
      "types": "./dist/registration.d.ts",
      "import": "./dist/registration.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.browser.json && esbuild src/browser/factory.ts --bundle --format=iife --platform=browser --minify --charset=utf8 '--banner:js=(host) => {' --footer:js=} --outfile=dist/images-client.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.browser.json"
  },
  "dependencies": {
    "@molis-ai/molis-work-contracts": "workspace:*",
    "@molis-ai/molis-work-plugin-sdk": "workspace:*",
    "@molis-ai/molis-work-storage": "workspace:*"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "molis-work": {
    "path": "plugins/native/images",
    "kind": "native-plugin",
    "maturity": "partial",
    "contract": "@molis-ai/molis-work-contracts/platform/plugin",
    "migrationGoals": [
      "goal-reorg-f2"
    ],
    "ssot": "docs/SSOT-MATRIX.md",
    "capabilities": [
      "images.ui-contribution.v1",
      "images.generation.v1"
    ],
    "registration": "./registration"
  }
}
