+      return view(row);
+    },
+
+    get(ref): ScopedCandidate | undefined {
+      const row = held.get(ref.id);
+      return row === undefined ? undefined : view(row);
+    },
+
+    list(query): readonly ScopedCandidate[] {
+      return Object.freeze([...held.values()].filter((row) => row.scope === query.scope && row.owner === query.owner).map(view));
+    },
