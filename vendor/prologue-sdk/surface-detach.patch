-      return "mutate-external";
-    case "wait":
-      /*
-       * 等一会儿什么都不改。
-       *
-       * **但它仍然过门**：`user-visible` 那一档默认也要问，而一个能
-       * 不过门的动作种类，迟早会被拿来当「先等一下再点」的绕行。
-       */
-      return "user-visible";
-  }
-}
