      "css": ".ds-nav{display:flex;flex-direction:column;gap:3px;padding:12px;background:var(--wash)}.ds-nav-item{padding:9px 12px;display:flex;gap:10px;border:0;border-radius:7px;background:none;color:var(--muted);text-align:left;min-height:38px;font-size:13px;cursor:pointer;font-family:Inter,\"Noto Sans SC\",\"PingFang SC\",sans-serif;}.ds-nav-item span{margin-left:auto;font-size:11px}.ds-nav-item:hover{background:var(--page)}.ds-nav-item.ds-current{background:var(--paper);color:var(--ink)}.ds-nav-item:focus-visible{outline:2px solid var(--accent);outline-offset:3px;}"
