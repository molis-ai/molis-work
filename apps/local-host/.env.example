# Copy apps/local-host/.env.example to .env.personal.local at the repository root for pnpm web:personal.
# Local Auth registration required.
MOLIS_WORK_AUTH_ORIGIN=http://127.0.0.1:8787
MOLIS_WORK_AUTH_CLIENT_ID=molis-work-web-local
MOLIS_WORK_AUTH_DESKTOP_CLIENT_ID=molis-work-desktop-local
# Login reads the user profile directly from Auth; no sync server is required.
# Explicit local-only Pages sync integration. No public endpoint is enabled.
MOLIS_WORK_SYNC_LOCAL=0
