{
  "name": "@molis-ai/molis-work-plugin-inbox",
  "version": "0.0.0",
  "private": true,
  "description": "Protected first-party Inbox attention list, detail, and disposition.",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=24"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./registration": {
      "types": "./dist/registration.d.ts",
      "import": "./dist/registration.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@molis-ai/molis-work-contracts": "workspace:*"
  },
  "molis-work": {
    "maturity": "slice",
    "capabilities": [
      "inbox.ui-contribution.v1",
      "inbox.http-routes.v1"
    ],
    "registration": "./registration",
    "extraWorkspaceDependencies": [],
    "extraDependencies": {}
  }
}
